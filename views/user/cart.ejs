<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shopping Cart - Leafora</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            leaf:  { 50:'#f0faf0',100:'#dcf5dc',600:'#1f7a1f',700:'#185c18',800:'#124512' },
            cream: '#f5f0e8',
          },
          fontFamily: {
            display: ['"Playfair Display"','serif'],
            body:    ['Poppins','sans-serif'],
          },
        },
      },
    };
  </script>

  <style>
    * { box-sizing: border-box; }
    body { font-family: 'Poppins', sans-serif; background: #f5f0e8; margin: 0; }

    /* ── Navbar ── */
    .navbar { background: #f5f0e8; padding: 0 40px; display: flex; align-items: center; justify-content: space-between; height: 60px; border-bottom: 1px solid #e8e2d8; position: sticky; top: 0; z-index: 100; }
    .nav-logo { display: flex; align-items: center; gap: 6px; text-decoration: none; }
    .nav-logo img { height: 34px; }
    .nav-logo span { font-family: 'Playfair Display', serif; font-size: 1.15rem; font-weight: 700; color: #1a5c1a; }
    .nav-links { display: flex; align-items: center; gap: 28px; }
    .nav-links a { font-size: 0.8rem; color: #374151; text-decoration: none; font-weight: 500; transition: color .15s; padding-bottom: 2px; }
    .nav-links a:hover { color: #1a5c1a; }
    .nav-links a.active { border-bottom: 2px solid #374151; }
    .nav-icons { display: flex; align-items: center; gap: 16px; }
    .nav-icons a { color: #374151; font-size: 0.9rem; text-decoration: none; transition: color .15s; position: relative; }
    .nav-icons a:hover { color: #1a5c1a; }
    .cart-badge { position: absolute; top: -6px; right: -7px; background: #1a5c1a; color: #fff; font-size: 0.5rem; font-weight: 700; width: 14px; height: 14px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }

    /* ── Cart table ── */
    .cart-table { width: 100%; border-collapse: collapse; }
    .cart-th { font-size: 0.8rem; font-weight: 600; color: #374151; padding: 12px 16px; text-align: left; border-bottom: 1px solid #e5e7eb; }
    .cart-td { font-size: 0.82rem; color: #374151; padding: 16px 16px; border-bottom: 1px solid #f3f4f6; vertical-align: middle; }

    /* ── Qty stepper ── */
    .qty-stepper { display: inline-flex; align-items: center; border: 1px solid #d1d5db; border-radius: 6px; overflow: hidden; }
    .qty-btn { width: 30px; height: 30px; background: #f9fafb; border: none; cursor: pointer; font-size: 0.75rem; color: #374151; display: flex; align-items: center; justify-content: center; transition: background .15s; flex-shrink: 0; }
    .qty-btn:hover:not(:disabled) { background: #f0faf0; color: #1a5c1a; }
    .qty-btn:disabled { opacity: .4; cursor: not-allowed; }
    .qty-num { width: 36px; text-align: center; font-size: 0.8rem; font-weight: 500; color: #374151; border: none; background: transparent; outline: none; }

    /* ── Product image slot ── */
    .prod-img { width: 80px; height: 80px; border-radius: 10px; overflow: hidden; background: #e8ede8; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .prod-img img { width: 100%; height: 100%; object-fit: cover; }

    /* ── Badges ── */
    .badge-out  { background: #fee2e2; color: #991b1b; font-size: 0.6rem; font-weight: 700; padding: 2px 8px; border-radius: 999px; display: inline-block; }
    .badge-blocked { background: #f3f4f6; color: #6b7280; font-size: 0.6rem; font-weight: 700; padding: 2px 8px; border-radius: 999px; display: inline-block; }

    /* ── Toast ── */
    .toast { position: fixed; top: 1rem; right: 1rem; z-index: 9999; display: flex; align-items: center; gap: 10px; padding: 12px 18px; border-radius: 10px; font-size: 0.82rem; font-weight: 500; box-shadow: 0 4px 20px rgba(0,0,0,.12); animation: slideIn .3s ease; }
    @keyframes slideIn { from { transform: translateX(120%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

    /* ── Loading spinner on btn ── */
    .btn-loading { pointer-events: none; opacity: .7; }

    /* ── Highlight ── */
    .highlight { display: flex; flex-direction: column; align-items: center; gap: 5px; text-align: center; }
    .highlight i { font-size: 1.3rem; color: #1a5c1a; }
    .highlight p { font-size: 0.67rem; color: #374151; font-weight: 500; max-width: 80px; line-height: 1.3; }
  </style>
</head>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<body class="min-h-screen">

<!-- ════════ FLASH TOASTS ════════ -->
<% if (typeof success !== 'undefined' && success && success.length > 0) { %>
  <div class="toast bg-green-50 border border-green-200 text-green-700" id="flashToast">
    <i class="fa-solid fa-circle-check"></i> <%= success[0] %>
  </div>
<% } %>
<% if (typeof error !== 'undefined' && error && error.length > 0) { %>
  <div class="toast bg-red-50 border border-red-200 text-red-700" id="flashToast">
    <i class="fa-solid fa-circle-exclamation"></i> <%= error[0] %>
  </div>
<% } %>

<!-- ════════ NAVBAR ════════ -->
<nav class="navbar">
  <a href="/" class="nav-logo">
    <img src="/images/leafora logo.png" alt="Leafora" onerror="this.style.display='none'" />
    <span>Leafora</span>
  </a>
 <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-gray-600">
        <a href="/"          class="hover:text-leaf-700 transition-colors">Home</a>
        <a href="/productlist" class="hover:text-leaf-700 transition-colors"  >products</a>
        <a href="/about"  class="hover:text-leaf-700 transition-colors">About</a>
        <a href="/contact"     class="hover:text-leaf-700 transition-colors">Contact</a>
      </nav>
     <div class="nav-icons" style="display:flex;align-items:center">
    <a href="/profile" title="Account"><i class="fa-regular fa-user"></i></a>
     <a href="/wishlist" class="hidden md:flex flex-col items-center gap-0.5 relative hover:text-leaf-500 transition-colors">
  <i class="fa-regular fa-heart text-base"></i>

<span
  id="wishlistCount"
  class="absolute -top-1 -right-2 bg-red-500 text-white text-[9px] w-4 h-4 rounded-full flex items-center justify-center font-bold <%= wishlistCount > 0 ? '' : 'hidden' %>">
  <%= wishlistCount || 0 %>
</span>


</a>
    <a href="/cart" title="Cart" style="position:relative">
      <i class="fa-solid fa-bag-shopping"></i>
      <span id="cartBadge" class="cart-badge" style="<%= (typeof cartCount !== 'undefined' && cartCount > 0) ? 'display:flex;' : 'display:none;' %>"><%= (typeof cartCount !== 'undefined') ? cartCount : 0 %></span>
    </a>
  </div>
</nav>

<!-- ════════ MAIN CONTENT ════════ -->
<div class="max-w-4xl mx-auto px-4 py-10">

  <!-- Page title -->
  <h1 class="font-display text-2xl font-bold text-center text-gray-900 tracking-widest uppercase mb-8">
    Shopping Cart
  </h1>

  <% if (typeof cartItems !== 'undefined' && cartItems && cartItems.length > 0) { %>

    <!-- ── Cart Table ── -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden mb-6">
      <table class="cart-table">
        <thead>
          <tr>
            <th class="cart-th">Product</th>
            <th class="cart-th">Price</th>
            <th class="cart-th">Quantity</th>
            <th class="cart-th text-right">Total</th>
          </tr>
        </thead>
        <tbody id="cartTableBody">
  <%
 
  
let subtotal = 0;
let hasBlockedItem = false;
let hasOutOfStockItem = false;

cartItems.forEach(function(item) {

  const product = item.product || item;
  const variant = item.variant || null;

  const isBlocked =
    product.isBlocked ||
    product.isDeleted ||
    product.status === 'inactive' ||
    product.status === 'blocked';

  const qty = item.quantity || 1;

 const stockQty = Number(
  variant?.stockQuantity ??
  variant?.stock ??
  product?.stock ??
  0
);
  
  const isOutOfStock = stockQty <= 0;
const unitPrice = item.finalPrice || item.originalPrice || 0;

const itemTotal = unitPrice * qty;

  if (!isBlocked && !isOutOfStock) subtotal += itemTotal;

  if (isBlocked) hasBlockedItem = true;
  if (isOutOfStock) hasOutOfStockItem = true;

  const MAX_QTY = isOutOfStock
    ? 0
    : Math.min(stockQty, 5);
%>


         <tr id="row-<%= item._id || item.productId %>"
              class="<%=  isOutOfStock ? 'opacity-60' : '' %>">
                

            <!-- Product -->
            <td class="cart-td">
              <div class="flex items-center gap-3">
                <!-- Image slot -->
                <div class="prod-img">
                    <% if (variant && variant.images && variant.images.length > 0) { %>
    <img
      src="/uploads/products/<%= variant.images[0] %>"
      alt="<%= product.name %>"
    />
<% } else { %>

                    <i class="fa-solid fa-seedling text-xl" style="color:#b8d4b8"></i>
                  <% } %>
                </div>
                <!-- Name + status badges + remove -->
                <div>
                  <a href="/products/<%= product._id %>"
                     class="font-semibold text-gray-800 text-sm hover:text-leaf-700 transition-colors leading-tight block mb-0.5">
                    <%= product.name %>
                  </a>
                  <% if (variant && (variant.size || variant.color)) { %>
                    <p class="text-gray-400 text-xs mb-0.5">
                      <%= variant.size || '' %><%= variant.color ? (variant.size ? ' · ' : '') + variant.color : '' %>
                    </p>
                  <% } %>

                  <!-- Blocked / out of stock warning -->
                  <% if (isBlocked) { %>
                    <span class="badge-blocked"><i class="fa-solid fa-ban mr-1"></i>Unavailable</span>
                  <% } else if (isOutOfStock) { %>
                    <span class="badge-out"><i class="fa-solid fa-circle-xmark mr-1"></i>Out of Stock</span>
                  <% } %>

                  <!-- Remove -->
                <button
  class="text-red-500 hover:text-red-700 text-xs font-medium mt-1 flex items-center gap-1"
  onclick="removeItem('<%= item._id || item.productId %>', this)">
  <i class="fa-regular fa-trash-can"></i> Remove
</button>
                </div>
              </div>
            </td>

            <!-- Price -->
        <div class="flex items-center gap-2">
  <!-- <td class="cart-td">
              <span class="font-medium text-gray-800">₹<%= Number(unitPrice).toLocaleString('en-IN') %></span>
              <% if (variant && variant.price && variant.discountPrice && variant.discountPrice < variant.price) { %>
                <span class="line-through text-gray-400 text-xs ml-1">₹<%= Number(variant.price).toLocaleString('en-IN') %></span>
              <% } %>
            </td> -->
          <td class="cart-td">
        <div class="flex items-center gap-2">

  <% if (item.hasOffer) { %>

<span class="text-lg font-bold text-green-700">
  ₹<%= item.offerPrice.toLocaleString("en-IN") %>
</span>

<span class="line-through text-gray-400">
  ₹<%= item.originalPrice.toLocaleString("en-IN") %>
</span>

<span class="text-red-600 font-semibold">
  <%= item.offerDiscount %> ₹ OFF
</span>

<% } else { %>

<span class="text-lg font-bold">
  ₹<%= item.originalPrice.toLocaleString("en-IN") %>
</span>

<% } %>

</div>
</td>

  

</div>

            <!-- Quantity stepper -->
            <td class="cart-td">
              <% if (isBlocked || isOutOfStock) { %>
                <span class="text-gray-400 text-sm">—</span>
              <% } else { %>
                <div class="qty-stepper">
                  <button class="qty-btn"
                    onclick="updateQty('<%= item._id || item.productId %>', -1, this)"
                    <%= qty <= 1 ? 'disabled' : '' %>>
                    <i class="fa-solid fa-minus" style="font-size:0.6rem"></i>
                  </button>
                  <span class="qty-num" id="qty-<%= item._id || item.productId %>"><%= qty %></span>
                  <button class="qty-btn"
                    onclick="updateQty('<%= item._id || item.productId %>', 1, this)"
                    <%= qty >= MAX_QTY ? 'disabled' : '' %>
                    data-max="<%= Math.min(stockQty, MAX_QTY) %>">
                    <i class="fa-solid fa-plus" style="font-size:0.6rem"></i>
                  </button>
                </div>
                <p class="text-xs text-gray-400 mt-1"><%= stockQty %> in stock · max <%= MAX_QTY %></p>
              <% } %>
            </td>

            <!-- Total -->
            <td class="cart-td text-right">
              <span class="font-semibold text-gray-900" id="total-<%= item._id || item.productId %>">
                <% if (isBlocked || isOutOfStock) { %>—<% } else { %>₹<%= Number(item.itemTotal).toLocaleString('en-IN') %><% } %>
              </span>
            </td>

          </tr>
          <% }) %>

        </tbody>
      </table>
    </div>

    <!-- ── Blocked / Out of stock warnings ── -->
    <% if (hasBlockedItem || hasOutOfStockItem) { %>
      <div class="bg-amber-50 border border-amber-200 text-amber-800 text-xs rounded-xl px-4 py-3 mb-5 flex items-start gap-2">
        <i class="fa-solid fa-triangle-exclamation mt-0.5 flex-shrink-0"></i>
        <div>
          <% if (hasBlockedItem) { %>
            <p class="font-semibold mb-0.5">Some items are unavailable</p>
            <p>Unavailable products won't be included in your order. Please remove them.</p>
          <% } %>
          <% if (hasOutOfStockItem) { %>
            <p class="font-semibold mt-1 mb-0.5">Some items are out of stock</p>
            <p>Out-of-stock products cannot be checked out. Please remove them or wait for restocking.</p>
          <% } %>
        </div>
      </div>
    <% } %>

    <!-- ── Order Summary / Checkout ── -->
    <div class="flex flex-col items-end gap-3">

      <!-- Subtotal -->
      <div class="w-full max-w-xs">
        <div class="flex items-center justify-between py-3 border-t border-gray-200">
          <span class="text-sm font-semibold text-gray-700">Subtotal</span>
          <span class="text-base font-bold text-gray-900" id="subtotalDisplay">
            ₹<%= Number(subtotal).toLocaleString('en-IN') %>
          </span>
        </div>
        <p class="text-xs text-gray-400 mb-3 text-right">Taxes and shipping calculated at checkout</p>

        <!-- Checkout button -->
        <%
          const canCheckout = !hasBlockedItem && !hasOutOfStockItem && subtotal > 0;
        %>
        <% if (canCheckout) { %>
          <a href="/checkout"
            class="w-full bg-[#1a5c1a] hover:bg-[#144d14] text-white font-semibold text-sm py-3.5 rounded-xl transition-colors text-center block tracking-wide">
            Checkout
          </a>
        <% } else { %>
          <button disabled
            class="w-full bg-gray-300 text-gray-500 font-semibold text-sm py-3.5 rounded-xl cursor-not-allowed text-center block tracking-wide"
            title="<%= hasBlockedItem || hasOutOfStockItem ? 'Remove unavailable items before checkout' : 'Your cart is empty' %>">
            Checkout
          </button>
          <p class="text-xs text-red-400 text-center mt-1">
            <% if (hasBlockedItem || hasOutOfStockItem) { %>
              Remove unavailable / out-of-stock items to proceed
            <% } %>
          </p>
        <% } %>

        <!-- View Cart / Continue shopping -->
        <div class="text-center mt-2">
          <a href="/productlist" class="text-xs text-gray-400 hover:text-leaf-700 transition-colors">
            ← Continue Shopping
          </a>
        </div>
      </div>
    </div>

  <% } else { %>

    <!-- ── Empty cart ── -->
    <div class="text-center py-20 bg-white rounded-2xl border border-gray-100 shadow-sm">
      <i class="fa-solid fa-bag-shopping text-6xl mb-4 block" style="color:#d1e8d1"></i>
      <p class="font-display text-xl font-semibold text-gray-700 mb-2">Your cart is empty</p>
      <p class="text-xs text-gray-400 mb-6">Add some beautiful plants to get started</p>
      <a href="/productlist"
         class="inline-flex items-center gap-2 bg-[#1a5c1a] hover:bg-[#144d14] text-white text-sm font-semibold px-6 py-3 rounded-xl transition-colors">
        <i class="fa-solid fa-seedling text-xs"></i> Shop Plants
      </a>
    </div>

  <% } %>

</div>
<!-- /max-w -->

<!-- ════════ FEATURE HIGHLIGHTS ════════ -->
<div class="bg-white border-t border-gray-100 mt-4">
  <div class="max-w-3xl mx-auto px-4 py-6 flex items-center justify-around flex-wrap gap-6">
    <div class="highlight"><i class="fa-solid fa-rotate-left"></i><p>14 Days Replacement</p></div>
