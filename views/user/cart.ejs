    <p class="text-right mt-3 text-sm font-medium" style="color:#6aaa6a;font-family:'Playfair Display',serif">Grow Green, Live Fresh 🌿</p>
  </div>
</footer>

<!-- ════════ SCRIPTS ════════ -->

<script>
  const MAX_QTY_GLOBAL = 5; // hard cap per item

  /* ── Update quantity (increment / decrement) ── */
  window.updateQty = async function(itemId, delta, btn) {
    const qtyEl   = document.getElementById('qty-'   + itemId);
    const totalEl = document.getElementById('total-' + itemId);
    if (!qtyEl) return;

    const currentQty = parseInt(qtyEl.textContent);
    const newQty     = currentQty + delta;
    const maxAllowed = parseInt(btn.closest('.qty-stepper').querySelector('[data-max]')?.dataset.max || MAX_QTY_GLOBAL);

    // Client-side guard
if (delta < 0) {
  // Decrement: always allow
}
else if (delta > 0) {
  // Increment: check stock
  if (newQty > maxAllowed) {
    showToast(`Only ${maxAllowed} units available.`, 'error');
    return;
  }
}

    // Disable buttons while request is in flight
    btn.disabled = true;

    try {
      const res = await fetch('/cart/update', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ itemId, quantity: newQty }),
      });
      const data = await res.json();
 window.location.reload();

      if (data.success) {
        qtyEl.textContent = newQty;
        if (totalEl && data.itemTotal !== undefined) {
          totalEl.textContent = '₹' + Number(data.itemTotal).toLocaleString('en-IN');
        }
        if (data.subtotal !== undefined) {
          const sub = document.getElementById('subtotalDisplay');
          if (sub) sub.textContent = '₹' + Number(data.subtotal).toLocaleString('en-IN');
        }
        // Update button states
        const stepper = btn.closest('.qty-stepper');
        stepper.querySelector('[data-max]').disabled = (newQty >= maxAllowed);
        stepper.querySelectorAll('.qty-btn')[0].disabled = (newQty <= 1);
      } else {
        showToast(data.message || 'Could not update quantity.', 'error');
      }
    } catch {
      showToast('Network error. Please try again.', 'error');
    } finally {
      btn.disabled = false;
    }
  }

  /* ── Remove item ── */
window.removeItem = async function(itemId, btn) {
  const result = await Swal.fire({
    title: 'Remove item?',
    text: 'This item will be removed from your cart.',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'Yes, remove it',
    cancelButtonText: 'Cancel',
    confirmButtonColor: '#dc2626'
  });

  if (!result.isConfirmed) return;

  btn.classList.add('btn-loading');

  try {
    const res = await fetch('/cart/remove', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ itemId })
    });

    const data = await res.json();

   if (data.success) {
    Swal.fire({
        toast: true,
        position: 'top-end',
        icon: 'success',
        title: 'Item removed from cart',
        showConfirmButton: false,
        timer: 1000
    }).then(() => {
        location.reload();
    });

    return;


    } else {
      Swal.fire({
        icon: 'error',
        title: 'Oops!',
        text: data.message || 'Could not remove item.'
      });
    }

  } catch (err) {
    console.error(err);

    Swal.fire({
      icon: 'error',
      title: 'Network Error',
      text: 'Please try again.'
    });
  } finally {
    btn.classList.remove('btn-loading');
  }
};
  /* ── Mini toast ── */
  function showToast(msg, type) {
    const old = document.getElementById('miniToast');
    if (old) old.remove();
    const t = document.createElement('div');
    t.id = 'miniToast';
    t.className = 'toast ' + (type === 'success'
      ? 'bg-green-50 border border-green-200 text-green-700'
      : 'bg-red-50 border border-red-200 text-red-700');
    t.innerHTML = `<i class="fa-solid fa-${type === 'success' ? 'circle-check' : 'circle-exclamation'}"></i> ${msg}`;
    document.body.appendChild(t);
    setTimeout(() => t.remove(), 3500);
  }

  /* ── Auto-dismiss flash toast ── */
  const flashToast = document.getElementById('flashToast');
  if (flashToast) setTimeout(() => flashToast.remove(), 5000);
</script>
