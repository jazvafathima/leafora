  <div class="max-w-6xl mx-auto px-6 py-5">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div class="flex items-center gap-2">
        <span class="text-gray-300 text-xs font-medium mr-1">Social</span>
        <a href="#" class="w-7 h-7 rounded-full bg-gray-600 hover:bg-gray-500 flex items-center justify-center"><i class="fa-brands fa-instagram text-white text-xs"></i></a>
