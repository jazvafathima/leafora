<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Checkout - Leafora</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/global.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            leaf:  { 50:'#f0faf0',100:'#dcf5dc',600:'#1f7a1f',700:'#185c18',800:'#124512' },
            cream: '#f5f0e8',
          },
          fontFamily: {
            display: ['"Playfair Display"','serif'],
            body:    ['Poppins','sans-serif'],
          },
        },
      },
    };
  </script>
  <style>
    * { box-sizing: border-box; }
    body { font-family: 'Poppins', sans-serif; background: #f5f0e8; margin: 0; }

    /* ── Navbar ── */
    .navbar { background: #f5f0e8; padding: 0 40px; display: flex; align-items: center; justify-content: space-between; height: 56px; border-bottom: 1px solid #e8e2d8; position: sticky; top: 0; z-index: 100; }
    .nav-logo { display: flex; align-items: center; gap: 6px; text-decoration: none; }
    .nav-logo img { height: 32px; }
    .nav-logo span { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 700; color: #1a5c1a; }
    .nav-links a { font-size: 0.78rem; color: #374151; text-decoration: none; font-weight: 500; margin-left: 22px; transition: color .15s; }
    .nav-links a:hover { color: #1a5c1a; }
    .nav-links a.active { border-bottom: 2px solid #374151; }
    .nav-icons a { color: #374151; font-size: 0.88rem; text-decoration: none; margin-left: 14px; transition: color .15s; position: relative; }
    .nav-icons a:hover { color: #1a5c1a; }
    .cart-badge { position: absolute; top: -6px; right: -7px; background: #1a5c1a; color: #fff; font-size: 0.5rem; font-weight: 700; width: 14px; height: 14px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }

    /* ── Address card ── */
    .addr-card { border: 1.5px solid #e5e7eb; border-radius: 10px; padding: 13px 14px; cursor: pointer; transition: all .2s; position: relative; }
    .addr-card:hover { border-color: #1a5c1a; background: #f8fdf8; }
    .addr-card.selected { border-color: #1a5c1a; background: #f0faf0; }
    .addr-radio { width: 16px; height: 16px; accent-color: #1a5c1a; cursor: pointer; }

    /* ── Section card ── */
    .section-card { background: #fff; border-radius: 14px; border: 1px solid #ece8e0; padding: 18px 20px; margin-bottom: 16px; box-shadow: 0 1px 4px rgba(0,0,0,.04); }
    .section-title { font-size: 0.8rem; font-weight: 700; color: #374151; margin-bottom: 14px; letter-spacing: .02em; }

    /* ── Order item row ── */
    .order-item-img { width: 44px; height: 44px; border-radius: 8px; overflow: hidden; background: #e8ede8; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .order-item-img img { width: 100%; height: 100%; object-fit: cover; }

    /* ── Payment method tabs ── */
    .pay-tab { border: 1.5px solid #e5e7eb; border-radius: 8px; padding: 10px 14px; cursor: pointer; transition: all .15s; display: flex; align-items: center; gap: 8px; font-size: 0.78rem; font-weight: 500; color: #374151; }
    .pay-tab:hover { border-color: #1a5c1a; }
    .pay-tab.selected { border-color: #1a5c1a; background: #f0faf0; color: #1a5c1a; font-weight: 600; }
    .pay-tab input[type=radio] { accent-color: #1a5c1a; }

    /* ── Price row ── */
    .price-row { display: flex; align-items: center; justify-content: space-between; font-size: 0.78rem; padding: 5px 0; }
    .price-row.total { font-size: 0.9rem; font-weight: 700; color: #1f2937; border-top: 1px solid #f0f0f0; padding-top: 10px; margin-top: 4px; }

    /* ── Toast ── */
    .toast { position: fixed; top: 1rem; right: 1rem; z-index: 9999; display: flex; align-items: center; gap: 10px; padding: 12px 18px; border-radius: 10px; font-size: 0.82rem; font-weight: 500; box-shadow: 0 4px 20px rgba(0,0,0,.12); animation: slideIn .3s ease; }
    @keyframes slideIn { from { transform: translateX(120%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

    /* ── Address modal ── */
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.45); display: flex; align-items: center; justify-content: center; z-index: 50; }
    .f-label { display: block; font-size: 0.72rem; font-weight: 500; color: #374151; margin-bottom: 4px; }
    .f-label span { color: #ef4444; }
    .f-input { width: 100%; border: 1px solid #e5e7eb; border-radius: 8px; padding: 9px 12px; font-size: 0.8rem; color: #374151; outline: none; font-family: 'Poppins', sans-serif; background: #fff; transition: border-color .2s; }
    .f-input:focus { border-color: #1a5c1a; box-shadow: 0 0 0 2px rgba(26,92,26,.07); }
    .f-input::placeholder { color: #adb5bd; }


    .is-error {
    border-color: #ef4444 !important;
    box-shadow: 0 0 0 1px #ef4444;
}

.field-error {
    color: #dc2626;
    font-size: 12px;
    margin-top: 4px;
    display: flex;
    align-items: center;
    gap: 4px;
}
  </style>
</head>

<body class="min-h-screen">

<!-- ════════ FLASH TOASTS ════════ -->
<% if (typeof success !== 'undefined' && success && success.length > 0) { %>
  <div class="toast bg-green-50 border border-green-200 text-green-700" id="flashToast">
    <i class="fa-solid fa-circle-check"></i> <%= success[0] %>
  </div>
<% } %>
<% if (typeof error !== 'undefined' && error && error.length > 0) { %>
  <div class="toast bg-red-50 border border-red-200 text-red-700" id="flashToast">
    <i class="fa-solid fa-circle-exclamation"></i> <%= error[0] %>
  </div>
<% } %>

<!-- ════════ NAVBAR ════════ -->
<nav class="navbar">
  <a href="/" class="nav-logo">
    <img src="/images/leafora logo.png" alt="Leafora" onerror="this.style.display='none'" />
    <span>Leafora</span>
  </a>
      <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-gray-600">
        <a href="/"          class="hover:text-leaf-700 transition-colors">Home</a>
        <a href="/productlist" class="hover:text-leaf-700 transition-colors"  >products</a>
        <a href="/about"  class="hover:text-leaf-700 transition-colors">About</a>
        <a href="/contact"     class="hover:text-leaf-700 transition-colors">Contact</a>
      </nav>

  <div class="nav-icons" style="display:flex;align-items:center">
    <a href="/profile" title="Account"><i class="fa-regular fa-user"></i></a>
    <a href="/wishlist" title="Wishlist"><i class="fa-regular fa-heart"></i></a>
    <a href="/cart" title="Cart" style="position:relative">
      <i class="fa-solid fa-bag-shopping"></i>
      <span id="cartBadge" class="cart-badge" style="<%= (typeof cartCount !== 'undefined' && cartCount > 0) ? 'display:flex;' : 'display:none;' %>"><%= (typeof cartCount !== 'undefined') ? cartCount : 0 %></span>
    </a>
  </div>
</nav>

<!-- ════════ MAIN ════════ -->
<div class="max-w-5xl mx-auto px-4 py-8">

  <h1 class="font-display text-2xl font-bold text-center text-gray-900 mb-7">Checkout</h1>
   <% const selectedAddr = addresses && addresses.length ? addresses[0] : null; %>

  <form action="/checkout/place-order" method="POST" id="checkoutForm"><input type="hidden" name="addressId" id="selectedAddressHidden" value="<%= selectedAddr ? selectedAddr._id : '' %>">

    <div class="flex gap-6 items-start flex-wrap lg:flex-nowrap">

      <!-- ══════════════════════════════
           LEFT COLUMN
      ══════════════════════════════ -->
      <div class="flex-1 min-w-0">

        <!-- ── i. Delivery Address ── -->
<div class="section-card">
  <div class="flex items-center justify-between mb-3">
    <p class="section-title mb-0">Delivery Address</p>

    <div class="flex items-center gap-3">
      <button type="button"
        id="toggleAddressesBtn"
        onclick="toggleAddresses()"
        class="text-xs font-semibold text-[#1a5c1a] hover:underline">
        View All Addresses
      </button>

      <button type="button"
        onclick="openAddressModal(null)"
        class="flex items-center gap-1.5 text-xs font-semibold text-[#1a5c1a] hover:underline">
        <i class="fa-solid fa-plus text-xs"></i>
        Add New Address
      </button>
    </div>
  </div>



  <div id="selectedAddressContainer">
    <% if(selectedAddr){ %>
      <label class="addr-card block selected"
        id="selectedAddressCard">
        <div class="flex items-start gap-3">

          <input type="radio"
            data-address-radio
            value="<%= selectedAddr._id %>"
             checked
            class="addr-radio mt-0.5">

          <div class="flex-1">
            <div class="flex items-center gap-2 mb-1 flex-wrap">
              <div class="w-6 h-6 rounded-full bg-green-100 flex items-center justify-center">
                <i class="fa-solid fa-location-dot text-[#1a5c1a] text-xs"></i>
              </div>

              <span class="font-semibold text-gray-800 text-xs">
                <%= selectedAddr.label || 'Home' %>
              </span>

              <span class="bg-green-100 text-green-700 text-[10px] font-bold px-2 py-0.5 rounded-full">
                Selected
              </span>
            </div>

            <p class="text-xs font-semibold text-gray-700">
              <%= selectedAddr.fullName || selectedAddr.name %>
            </p>

            <p class="text-xs text-gray-500">
              +<%= selectedAddr.phone %><br>
              <%= selectedAddr.addressLine1 %>
              <% if(selectedAddr.addressLine2){ %>
                , <%= selectedAddr.addressLine2 %>
              <% } %>
              <br>
              <%= selectedAddr.city %>, <%= selectedAddr.state %> - <%= selectedAddr.pincode %>
            </p>
          </div>
        </div>
      </label>
    <% } %>
  </div>

  <!-- Hidden initially -->
  <div id="allAddressesContainer" class="hidden mt-4 space-y-3">

    <%  addresses.slice(1).forEach(function(addr){ %>

      <label class="addr-card block"
        id="addrCard-<%= addr._id %>"
        onclick="selectAddress('<%= addr._id %>')">

        <div class="flex items-start gap-3">

          <input
            type="radio"
            data-address-radio
             value="<%= addr._id %>"
            class="addr-radio mt-0.5">

          <div class="flex-1">

            <div class="flex items-center gap-2 mb-1 flex-wrap">
              <span class="font-semibold text-xs">
                <%= addr.label || 'Home' %>
              </span>
            </div>

            <p class="text-xs font-semibold">
              <%= addr.fullName || addr.name %>
            </p>

            <p class="text-xs text-gray-500">
              +<%= addr.phone %><br>
              <%= addr.addressLine1 %>
              <% if(addr.addressLine2){ %>
                , <%= addr.addressLine2 %>
              <% } %>
              <br>
              <%= addr.city %>, <%= addr.state %> - <%= addr.pincode %>
            </p>

          </div>

          <button type="button"
            onclick="event.stopPropagation(); openAddressModal('<%= addr._id %>')"
            class="text-gray-400 hover:text-[#1a5c1a]">
            <i class="fa-regular fa-pen-to-square text-xs"></i>
          </button>

        </div>
      </label>

    <% }) %>

  </div>
</div>



        <!-- ── ii. Order Summary ── -->
        <div class="section-card">
          <div class="flex items-center justify-between mb-3">
            <p class="section-title mb-0">Order Summary</p>
            <span class="text-xs text-gray-400 font-medium">
              <%= typeof cartItems !== 'undefined' && cartItems ? cartItems.length : 0 %> item(s)
            </span>
          </div>

          <div class="space-y-3">
            <% if (typeof cartItems !== 'undefined' && cartItems && cartItems.length > 0) { %>
            <% cartItems.forEach(function(item) {
          
     const product = item.product || item;
     const variant = item.variant || (product.variants && product.variants[0]) || null;

     const qty = item.quantity || 1;

     const originalPrice = item.originalPrice;
     const offerPrice = item.offerPrice;
     const hasOffer = item.hasOffer;
     const offerPercent = item.offerPercent;

     const itemTotal = item.total;

%>
    
              <div class="flex items-center gap-3 py-2 border-b border-gray-50 last:border-0">
                <!-- Image -->
                <div class="order-item-img">
                  <% if (variant && variant.images && variant.images.length > 0) { %>
                     <img
      src="/uploads/products/<%= variant.images[0] %>"
      alt="<%= product.name %>"
    />
                  <% } else { %>
                    <i class="fa-solid fa-seedling" style="color:#b8d4b8;font-size:.9rem"></i>
                  <% } %>
                </div>
                <!-- Info -->
                <div class="flex-1 min-w-0">
                  <p class="font-semibold text-gray-800 text-xs leading-tight truncate"><%= product.name %></p>
                  <p class="text-gray-400 text-[10px] mt-0.5">

  <%= variant ? (variant.size || variant.color || '') : '' %>

  <% if (variant && (variant.size || variant.color)) { %>
    ·
  <% } %>

 

</p>

                  <p class="text-gray-400 text-[10px]">Qty: <%= qty %></p>
                  
                  <div class="flex items-center gap-2">

  <% if (hasOffer) { %>

    <span class="text-lg font-bold text-green-700">
      ₹<%= offerPrice.toLocaleString("en-IN") %>
    </span>

    <span class="line-through text-gray-400">
      ₹<%= originalPrice.toLocaleString("en-IN") %>
    </span>

    <span class="text-red-600 font-semibold">
      <%= item.offerDiscount %> ₹ OFF
    </span>

  <% } else { %>

    <span class="text-lg font-bold">
      ₹<%= originalPrice.toLocaleString("en-IN") %>
    </span>

  <% } %>

</div>
                </div>
                <!-- Item total -->
                <span class="font-semibold text-gray-800 text-sm flex-shrink-0">
              ₹<%= item.total.toLocaleString('en-IN') %>
                </span>
              </div>
              <% }) %>
            <% } else { %>
              <p class="text-xs text-gray-400 text-center py-4">No items in cart.</p>
            <% } %>
          </div>
        </div>
<%

  let subtotal       = typeof orderSubtotal      !== 'undefined' ? orderSubtotal      : 0;
  let offerDiscount  = typeof orderOfferDiscount !== 'undefined' ? orderOfferDiscount : 0;
  let couponDiscount = typeof orderCouponDiscount!== 'undefined' ? orderCouponDiscount: 0;
  let shipping       = typeof orderShipping      !== 'undefined' ? orderShipping      : 0;


  if (subtotal === 0 && typeof cartItems !== 'undefined' && cartItems && cartItems.length > 0) {
    cartItems.forEach(function(item) {
      const unitPrice = item.unitPrice || 0;
      const qty       = item.quantity  || 1;
      subtotal       += unitPrice * qty;
    });
    if (subtotal > 0 && subtotal < 499) shipping = 49;
  }


  const appliedCoupon     = typeof sessionCoupon !== 'undefined' ? sessionCoupon : null;
  const appliedCouponCode = appliedCoupon ? appliedCoupon.code : null;
  if (appliedCoupon && appliedCoupon.discountAmount) {
    couponDiscount = appliedCoupon.discountAmount;
  }

   
  const walletBal = Number(walletBalance || 0);
  const finalTotal = Math.max(subtotal - offerDiscount - couponDiscount + shipping, 0);
  const hasEnough = walletBal >= finalTotal;

%>

        <!-- ── iii. Payment Method ── -->


<div class="section-card">
  <p class="section-title">Payment Method</p>
  <div class="space-y-2">

    <!-- ── Cash on Delivery ── -->
    <label class="pay-tab" id="tab-cod" onclick="selectPayment('cod')">
      <input type="radio" name="paymentMethod" value="cod" checked />
      <i class="fa-solid fa-money-bill-wave text-green-600" style="font-size:.95rem"></i>
      <span>Cash on Delivery</span>
      <span class="ml-auto text-[10px] bg-green-100 text-green-700 font-bold px-2 py-0.5 rounded-full">Free</span>
    </label>

    <!-- ── Online Payment (Razorpay) ── -->
    <label class="pay-tab" id="tab-online" onclick="selectPayment('online')">
      <input type="radio" name="paymentMethod" value="online" />
      <i class="fa-regular fa-credit-card text-blue-500" style="font-size:.95rem"></i>
      <span>Online Payment</span>
      <div class="ml-auto flex items-center gap-1.5">
        <!-- Payment brand icons -->
        <i class="fa-brands fa-cc-visa text-gray-400" style="font-size:.85rem"></i>
        <i class="fa-brands fa-cc-mastercard text-gray-400" style="font-size:.85rem"></i>
        <span class="text-[9px] font-bold text-gray-400 border border-gray-200 px-1 rounded">UPI</span>
      </div>
    </label>

    <!-- ── Razorpay sub-panel (shown when online is selected) ── -->
    <div id="razorpayPanel"
         class="hidden ml-1 border border-blue-100 rounded-xl bg-blue-50/50 px-4 py-3 space-y-2"
         style="margin-top:-4px;border-top-left-radius:0;border-top-right-radius:0">
      <p class="text-xs text-blue-700 font-medium flex items-center gap-1.5">
        <i class="fa-solid fa-shield-halved text-blue-500" style="font-size:.7rem"></i>
        Secured by Razorpay · UPI · Cards · Net Banking · Wallets
      </p>
      <div class="flex items-center gap-3 flex-wrap">
        <i class="fa-brands fa-cc-visa text-gray-500 text-lg"></i>
        <i class="fa-brands fa-cc-mastercard text-gray-500 text-lg"></i>
        <i class="fa-brands fa-cc-amex text-gray-500 text-lg"></i>
        <span class="text-[9px] font-bold text-gray-500 border border-gray-300 px-1.5 py-0.5 rounded">RuPay</span>
        <span class="text-[9px] font-bold text-gray-500 border border-gray-300 px-1.5 py-0.5 rounded">UPI</span>
        <span class="text-[9px] font-bold text-gray-500 border border-gray-300 px-1.5 py-0.5 rounded">NetBanking</span>
      </div>
      <p class="text-[10px] text-gray-400">You will be redirected to Razorpay to complete payment securely.</p>
    </div>

    <!-- ── Wallet ── -->
    <label class="pay-tab <%= !hasEnough ? 'opacity-60 cursor-not-allowed' : '' %>"
           id="tab-wallet"
           onclick="<%= hasEnough ? 'selectPayment(\'wallet\')' : 'showWalletShortfall()' %>">
      <input type="radio" name="paymentMethod" value="wallet"
             <%= !hasEnough ? 'disabled' : '' %> />
      <i class="fa-solid fa-wallet text-purple-500" style="font-size:.95rem"></i>
      <span>Pay with Wallet</span>
      <div class="ml-auto text-right">
        <p class="text-[10px] font-bold <%= hasEnough ? 'text-purple-600' : 'text-gray-400' %>">
          ₹<%= walletBal.toLocaleString('en-IN') %> available
        </p>
        <% if (!hasEnough) { %>
          <p class="text-[9px] text-red-400 font-medium">Insufficient balance</p>
        <% } else { %>
          <p class="text-[9px] text-purple-400">Instant · No charges</p>
        <% } %>
      </div>
    </label>

    <!-- Wallet shortfall notice (shown when wallet selected but balance short) -->
    <div id="walletShortfallMsg"
         class="hidden ml-1 border border-red-100 rounded-xl bg-red-50 px-4 py-3"
         style="margin-top:-4px">
      <p class="text-xs text-red-600 font-medium flex items-center gap-1.5">
        <i class="fa-solid fa-circle-exclamation" style="font-size:.75rem"></i>
        Your wallet balance (₹<%= walletBal.toLocaleString('en-IN') %>) is less than
        the order total (<span id="shortfallOrderTotal">₹<%= typeof finalTotal !== 'undefined' ? Number(finalTotal).toLocaleString('en-IN') : '0' %></span>).
      </p>
      <a href="/wallet"
         class="inline-flex items-center gap-1 text-[10px] text-purple-600 font-semibold mt-1.5 hover:underline">
        <i class="fa-solid fa-plus" style="font-size:.6rem"></i>
        Add funds to wallet
      </a>
    </div>

  </div>
</div>

<!-- ════════════════════════════════════════
     PAYMENT JAVASCRIPT
════════════════════════════════════════ -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  /* ── Active tab styling ── */
  function selectPayment(method) {
    ['cod','online','wallet'].forEach(function(m) {
      const tab   = document.getElementById('tab-' + m);
      const radio = tab ? tab.querySelector('input[type=radio]') : null;
      if (tab)   tab.classList.toggle('selected', m === method);
      if (radio) radio.checked = (m === method);
    });

    // Show/hide Razorpay info panel
    const rzpPanel = document.getElementById('razorpayPanel');
    if (rzpPanel) rzpPanel.classList.toggle('hidden', method !== 'online');

    // Hide wallet shortfall msg if switching away
    const wMsg = document.getElementById('walletShortfallMsg');
    if (wMsg) wMsg.classList.add('hidden');
  }

  function showWalletShortfall() {
    const wMsg = document.getElementById('walletShortfallMsg');
    if (wMsg) wMsg.classList.remove('hidden');
  }

  // Set COD as default selected on load
  selectPayment('cod');

  /* ════════════════════════════════════════════
     FORM SUBMIT HANDLER — intercept for Razorpay
  ════════════════════════════════════════════ */
  const checkoutForm = document.getElementById('checkoutForm'); // your existing form id

  if (checkoutForm) {
    checkoutForm.addEventListener('submit', async function(e) {
      e.preventDefault();

      const addr = document.getElementById('selectedAddressHidden');
      if (!addr || !addr.value) {
        showToast('Please select a delivery address.', 'error');
        return;
      }

      const method = document.querySelector('input[name="paymentMethod"]:checked')?.value;

      if (method === 'cod' || method === 'wallet') {
        const placeBtn = document.getElementById('placeOrderBtn');
        if (placeBtn) {
          placeBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-xs"></i> Placing Order...';
          placeBtn.disabled  = true;
        }
        this.submit();
        return;
      }

      if (method === 'online') {
        await initiateRazorpay(this);
      }
    });
  }

  /* ── Razorpay flow ── */
  async function initiateRazorpay(form) {
    const placeBtn = document.getElementById('placeOrderBtn');
    if (placeBtn) {
      placeBtn.disabled     = true;
      placeBtn.innerHTML    = '<i class="fa-solid fa-spinner fa-spin text-xs"></i> Connecting...';
    }

    try {
      // 1. Create Razorpay order server-side
      const formData = new FormData(form);
      const payload  = Object.fromEntries(formData.entries());

      const res  = await fetch('/checkout/create-razorpay-order', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify(payload),
      });
      const data = await res.json();

      if (!data.success) {
        alert(data.message || 'Could not initiate payment. Please try again.');
        resetPlaceBtn();
        return;
      }

      // 2. Open Razorpay checkout modal
      const options = {
        key:         data.keyId,
        amount:      data.razorpayOrder.amount,   // in paise — set server-side
        currency:    'INR',
        name:        'Leafora',
        description: 'Order Payment',
        order_id:    data.razorpayOrder.id,
        prefill: {
          name:    data.userName  || '',
          email:   data.userEmail || '',
          contact: data.userPhone || '',
        },
        theme: { color: '#1a5c1a' },

        handler: async function(response) {
          // 3. Verify signature server-side before marking order as paid
          const verifyRes  = await fetch('/checkout/verify-razorpay', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({
              razorpay_order_id:   response.razorpay_order_id,
              razorpay_payment_id: response.razorpay_payment_id,
              razorpay_signature:  response.razorpay_signature,
              orderPayload:        payload,   // address, items, coupon etc.
            }),
          });
          const verifyData = await verifyRes.json();

          if (verifyData.success) {
            // Redirect to success page
            window.location.href = '/checkout/success/' + verifyData.orderId;
          } else {
            window.location.href = '/checkout/orderFailed';
          }
        },

        modal: {
          ondismiss: function() {
            // User closed the Razorpay popup without paying
            resetPlaceBtn();
          }
        }
      };

      const rzp = new Razorpay(options);
      rzp.on('payment.failed', function() {
        window.location.href = 'checkout/orderFailed';
      });
      rzp.open();

    } catch (err) {
      console.error('Razorpay error:', err);
      alert('Payment could not be initiated. Please try again.');
      resetPlaceBtn();
    }
  }

  function resetPlaceBtn() {
    const btn = document.getElementById('placeOrderBtn');
    if (btn) {
      btn.disabled  = false;
      btn.innerHTML = '<i class="fa-solid fa-lock text-xs"></i> Place Order Securely';
    }
  }
</script>




