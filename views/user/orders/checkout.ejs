<!-- ════════ ADD/EDIT ADDRESS MODAL ════════ -->
<div id="addressModal" class="hidden modal-overlay">
  <div class="bg-white rounded-2xl shadow-2xl w-[440px] max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between px-6 pt-5 pb-4 border-b border-gray-100">
      <h2 class="text-sm font-semibold text-gray-800" id="modalTitle">
        <i class="fa-solid fa-location-dot text-[#1a5c1a] mr-1.5"></i> Add New Address
      </h2>
      <button onclick="closeAddressModal()" class="text-gray-400 hover:text-gray-600">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
<form id="addressForm" onsubmit="saveAddress(event)" novalidate class="px-6 py-5 space-y-3">
      <input type="hidden" id="addrId" name="addressId" value="" />

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="f-label">Full Name <span>*</span></label>
          <input type="text" id="addrName" name="fullName" placeholder="Full name" class="f-input" required pattern="[A-Za-z\s]+" title="Please enter a valid name (letters and spaces only)" />
        </div>
        <div>
          <label class="f-label">Phone <span>*</span></label>
          <input type="tel" id="addrPhone" name="phone" placeholder="+91 XXXXXXXXXX" class="f-input" required pattern="[6-9]\d{9}" title="Enter a valid 10-digit Indian phone number starting with 6-9" />
        </div>
      </div>

      <div>
        <label class="f-label">Address Label</label>
        <div class="flex gap-2">
          <% ['Home','Work','Other'].forEach(function(lbl){ %>
            <label class="flex items-center gap-1.5 border border-gray-200 rounded-lg px-3 py-1.5 cursor-pointer text-xs hover:border-[#1a5c1a] transition-colors">
              <input type="radio" name="label" value="<%= lbl %>" class="accent-leaf-700" /> <%= lbl %>
            </label>
          <% }) %>
        </div>
      </div>

      <div>
        <label class="f-label">Address Line 1 <span>*</span></label>
        <input type="text" id="addrLine1" name="addressLine1" placeholder="House no, Street name" class="f-input" required />
      </div>
      <div>
        <label class="f-label">Address Line 2</label>
        <input type="text" id="addrLine2" name="addressLine2" placeholder="Apartment, landmark (optional)" class="f-input" />
      </div>

      <div class="grid grid-cols-3 gap-3">
        <div>
          <label class="f-label">City <span>*</span></label>
          <input type="text" id="addrCity" name="city" placeholder="City" class="f-input" required pattern="[A-Za-z\s]+" title="Enter a valid city name" />
        </div>
        <div>
          <label class="f-label">State <span>*</span></label>
          <input type="text" id="addrState" name="state" placeholder="State" class="f-input" required pattern="[A-Za-z\s]+" title="Enter a valid state name" />
        </div>
        <div>
          <label class="f-label">Pincode <span>*</span></label>
          <input type="text" id="addrPin" name="pincode" placeholder="560001" class="f-input" maxlength="6" minlength="6" required pattern="\d{6}" title="Enter a 6-digit pincode" />
        </div>
      </div>

      <div class="flex items-center gap-2">
        <input type="checkbox" id="isDefault" name="isDefault" class="accent-leaf-700 w-4 h-4" />
        <label for="isDefault" class="text-xs text-gray-600 cursor-pointer">Set as default address</label>
      </div>

      <div class="flex gap-3 pt-2">
        <button type="submit"
          class="flex-1 bg-[#1a5c1a] hover:bg-[#144d14] text-white text-xs font-semibold py-2.5 rounded-lg transition-colors">
          Save Address
        </button>
        <button type="button" onclick="closeAddressModal()"
          class="px-5 border border-gray-300 text-gray-600 text-xs font-medium rounded-lg hover:bg-gray-50 transition-colors">
          Cancel
        </button>
      </div>
    </form>
  </div>
</div>

<script>
      

  /* ── Address modal ── */

  // Set hidden address input on load if a selected address exists
  document.addEventListener('DOMContentLoaded', function() {
    const checked = document.querySelector('input[data-address-radio]:checked');
    if (checked) {
      document.getElementById('selectedAddressHidden').value = checked.value;
    }
  });

const savedAddresses = <%- JSON.stringify(addresses || []) %>;


  function openAddressModal(addrId) {
    document.getElementById('addressModal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';

    const title = document.getElementById('modalTitle');
    const form  = document.getElementById('addressForm');
    form.reset();

    if (addrId) {
      const addr = savedAddresses.find(a => a._id === addrId);
      title.innerHTML = '<i class="fa-solid fa-pen-to-square text-[#1a5c1a] mr-1.5"></i> Edit Address';
      if (addr) {
        document.getElementById('addrId').value    = addr._id;
        document.getElementById('addrName').value  = addr.fullName || addr.name || '';
        document.getElementById('addrPhone').value = addr.phone || '';
        document.getElementById('addrLine1').value = addr.addressLine1 || '';
        document.getElementById('addrLine2').value = addr.addressLine2 || '';
        document.getElementById('addrCity').value  = addr.city || '';
        document.getElementById('addrState').value = addr.state || '';
        document.getElementById('addrPin').value   = addr.pincode || '';
        document.getElementById('isDefault').checked = addr.isDefault || false;
        // Set label radio
        const labelRadio = form.querySelector(`input[name=label][value="${addr.label || 'Home'}"]`);
        if (labelRadio) labelRadio.checked = true;
      }
    } else {
      title.innerHTML = '<i class="fa-solid fa-location-dot text-[#1a5c1a] mr-1.5"></i> Add New Address';
      document.getElementById('addrId').value = '';
      // Default label
      const homeRadio = form.querySelector('input[name=label][value="Home"]');
      if (homeRadio) homeRadio.checked = true;
    }


  }

  function closeAddressModal() {
    document.getElementById('addressModal').classList.add('hidden');
    document.body.style.overflow = '';
  }
  document.getElementById('addressModal').addEventListener('click', function(e) {
    if (e.target === this) closeAddressModal();
  });

async function saveAddress(e) {
    e.preventDefault();

    const form = document.getElementById('addressForm');

    // Remove previous errors
    form.querySelectorAll('.client-err').forEach(err => err.remove());

    form.querySelectorAll('.is-error').forEach(input => {
        input.classList.remove('is-error');
    });

    let valid = true;

    function showErr(id, msg) {
        const input = document.getElementById(id);

        if (!input) return;

        input.classList.add('is-error');

        const error = document.createElement('p');
        error.className = 'field-error client-err';
        error.innerHTML =
            '<i class="fa-solid fa-circle-exclamation"></i> ' + msg;

        input.parentElement.appendChild(error);

        valid = false;
    }

    const fields = [
    "addrName",
    "addrPhone",
    "addrLine1",
    "addrCity",
    "addrState",
    "addrPin"
];

fields.forEach(id => {
    const input = document.getElementById(id);

    input.addEventListener("input", function () {
        input.classList.remove("is-error");

        const error = input.parentElement.querySelector(".client-err");
        if (error) {
            error.remove();
        }
    });
});

    // Get values
    const name = document.getElementById('addrName').value.trim();
    const phone = document.getElementById('addrPhone').value.trim();
    const line1 = document.getElementById('addrLine1').value.trim();
    const city = document.getElementById('addrCity').value.trim();
    const state = document.getElementById('addrState').value.trim();
    const pin = document.getElementById('addrPin').value.trim();

    // ===== Validation =====

    // Name
    if (!name) {
        showErr('addrName', 'Full name is required.');
    }

    // Phone
    if (!phone) {
        showErr('addrPhone', 'Phone number is required.');
    } else if (!/^[6-9]\d{9}$/.test(phone)) {
        showErr('addrPhone', 'Enter a valid 10-digit phone number.');
    }

    // Address Line 1
    if (!line1) {
        showErr('addrLine1', 'Address Line 1 is required.');
    }

    // City
    if (!city) {
        showErr('addrCity', 'City is required.');
    }

    // State
    if (!state) {
        showErr('addrState', 'State is required.');
    }

    // Pincode
    if (!pin) {
        showErr('addrPin', 'Pincode is required.');
    } else if (!/^\d{6}$/.test(pin)) {
        showErr('addrPin', 'Enter a valid 6-digit pincode.');
    }

    // Stop if validation fails
    if (!valid) {
        return;
    }

    // ========================

    const data = Object.fromEntries(new FormData(form).entries());

    const isEdit = !!data.addressId;

    const url = isEdit
        ? `/checkout/address/${data.addressId}`
        : '/checkout/add-address';

    try {

        const res = await fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
        });

        const result = await res.json();

        if (result.success) {

            closeAddressModal();

            showToast(
                isEdit ? 'Address updated successfully!' : 'Address added successfully!',
                'success'
            );

            setTimeout(() => {
                window.location.reload();
            }, 500);

        } else {

            showToast(result.message || 'Could not save address.', 'error');

        }

    } catch (err) {

        console.error(err);

        showToast('Network error. Please try again.', 'error');

    }
}

</script>
  <script>
function toggleAddresses() {
    const container = document.getElementById('allAddressesContainer');
    const btn = document.getElementById('toggleAddressesBtn');

    container.classList.toggle('hidden');

    btn.textContent =
        container.classList.contains('hidden')
        ? 'View All Addresses'
        : 'Hide Addresses';
}

function selectAddress(addressId) {

   localStorage.setItem('selectedAddressId', addressId);

    const selectedCard = document.getElementById(`addrCard-${addressId}`);
    if (!selectedCard) return;

    // remove selected from all cards
    document.querySelectorAll('.addr-card').forEach(card => {
        card.classList.remove('selected');
    });

    // check correct radio
    document.querySelectorAll('input[data-address-radio]').forEach(r => { r.checked = false; });

    const radio = selectedCard.querySelector('input[data-address-radio]');
    if (radio) {
        radio.checked = true;
    }
    // update hidden input
    const hiddenInput = document.getElementById('selectedAddressHidden');
    if (hiddenInput) hiddenInput.value = addressId;
    selectedCard.classList.add('selected');

    // show selected address at top
    document.getElementById('selectedAddressContainer').innerHTML =
        selectedCard.outerHTML;

        const topCard = document.querySelector('#selectedAddressContainer .addr-card');

if (topCard) {

    // remove existing badges first
    topCard.querySelectorAll('.selected-badge').forEach(el => el.remove());

    const badge = document.createElement('span');
    badge.className =
      'selected-badge bg-green-100 text-green-700 text-[10px] font-bold px-2 py-0.5 rounded-full';

    badge.textContent = 'Selected';

    const labelRow = topCard.querySelector('.flex.items-center.gap-2.mb-1.flex-wrap');

    if (labelRow) {
        labelRow.appendChild(badge);
    }
}

    // close address list automatically
    document.getElementById('allAddressesContainer')
        .classList.add('hidden');

    // change button text back
    document.getElementById('toggleAddressesBtn').textContent =
        'View All Addresses';
}

</script>
<script>
document.addEventListener('DOMContentLoaded', () => {

    const selectedId = localStorage.getItem('selectedAddressId');

    if (selectedId) {
        const card = document.getElementById(`addrCard-${selectedId}`);
        if (card) {
            selectAddress(selectedId);
        }
    }

});
</script>
<script>

  /* ── Toast ── */
  function showToast(msg, type) {
    const old = document.getElementById('miniToast');
    if (old) old.remove();
    const t = document.createElement('div');
    t.id = 'miniToast';
    t.className = 'toast ' + (type === 'success'
      ? 'bg-green-50 border border-green-200 text-green-700'
      : 'bg-red-50 border border-red-200 text-red-700');
    t.innerHTML = `<i class="fa-solid fa-${type === 'success' ? 'circle-check' : 'circle-exclamation'}"></i> ${msg}`;
    document.body.appendChild(t);
    setTimeout(() => t.remove(), 3500);
  }

  const flashToast = document.getElementById('flashToast');
  if (flashToast) setTimeout(() => flashToast.remove(), 5000);
 
</script>
