<!-- ═══════════════════════════════════════════
     COUPON JAVASCRIPT
═══════════════════════════════════════════ -->
<script>
  /* ── Base values from server (never recompute from DOM) ── */
  const BASE_SUBTOTAL      = <%= subtotal %>;
  const BASE_OFFER_DISC    = <%= offerDiscount %>;
  const BASE_SHIPPING      = <%= shipping %>;

  /* ── Current state ── */
  let currentCouponDiscount = <%= couponDiscount %>;
  let currentCouponCode     = '<%= appliedCouponCode || "" %>';

  /* ── Helpers ── */
  function toINR(n) {
    return '₹' + Number(n).toLocaleString('en-IN');
  }
  function showMsg(elId, msg, isError) {
    const el = document.getElementById(elId);
    if (!el) return;
    el.textContent = msg;
    el.className   = 'text-xs mt-1.5 ' + (isError ? 'text-red-500' : 'text-green-600');
    el.classList.remove('hidden');
    if (!isError) setTimeout(() => el.classList.add('hidden'), 4000);
  }

  /* ── Recalculate and update DOM ── */
  function updateTotals(couponDisc, couponCode) {
    currentCouponDiscount = couponDisc;
    currentCouponCode     = couponCode || '';

    const newTotal = Math.max(BASE_SUBTOTAL - BASE_OFFER_DISC - couponDisc + BASE_SHIPPING, 0);

    // Update display
    document.getElementById('finalTotalDisplay').textContent = toINR(newTotal);
    document.getElementById('h_couponDiscount').value        = couponDisc;
    document.getElementById('h_couponCode').value            = couponCode || '';
    document.getElementById('h_finalTotal').value            = newTotal;

    console.log(document.getElementById('h_couponDiscount'));
console.log(document.getElementById('h_couponCode'));
console.log(document.getElementById('h_finalTotal'));

    // Coupon row
    const row = document.getElementById('couponDiscountRow');
    if (couponDisc > 0 && row) {
      row.style.display = '';
      document.getElementById('couponDiscountDisplay').textContent = '–' + toINR(couponDisc);
      const label = document.getElementById('appliedCouponLabel');
      if (label) label.textContent = couponCode ? '(' + couponCode + ')' : '';
    } else if (row) {
      row.style.display = 'none';
    }

    // Savings pill
    const totalSavings = BASE_OFFER_DISC + couponDisc;
    const pill         = document.getElementById('savingsPill');
    if (pill) {
      pill.classList.toggle('hidden', totalSavings <= 0);
      if (totalSavings > 0) {
        pill.querySelector('span').textContent =
          'You save ' + toINR(totalSavings) + ' on this order!';
      }
    }
  }

  /* ── Apply coupon via AJAX ── */
  async function applyCouponCode() {
    const code = (document.getElementById('couponInput')?.value || '').trim().toUpperCase();
    if (!code) {
      showMsg('couponMsg', 'Please enter a coupon code', true);
      return;
    }
    await sendApplyCoupon(code, 'couponMsg');
  }

  async function applyFromModal() {
    const code = (document.getElementById('modalCouponInput')?.value || '').trim().toUpperCase();
    if (!code) {
      showMsg('modalCouponMsg', 'Please enter a coupon code', true);
      return;
    }
    await sendApplyCoupon(code, 'modalCouponMsg');
  }

  async function selectCoupon(code) {
    await sendApplyCoupon(code, 'modalCouponMsg');
  }

  async function sendApplyCoupon(code, msgElId) {
    try {
      const res  = await fetch('/checkout/apply-coupon', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ code, subtotal: BASE_SUBTOTAL - BASE_OFFER_DISC }),
      });
      const data = await res.json();

      if (!data.success) {
        showMsg(msgElId, data.message, true);
        return;
      }

      // Update totals in DOM
      updateTotals(data.discountAmount, data.code);

      // Show applied state in inline area
      const couponEntry = document.getElementById('couponEntryArea');
      if (couponEntry) {
        couponEntry.innerHTML = `
          <div class="flex items-center gap-2 bg-green-50 border border-green-200 rounded-xl px-3 py-2.5">
            <i class="fa-solid fa-circle-check text-green-500 text-sm"></i>
            <div class="flex-1">
              <p class="text-xs font-bold text-green-700 tracking-wider">${data.code}</p>
              <p class="text-green-600" style="font-size:0.67rem">Coupon applied successfully</p>
            </div>
            <button type="button" onclick="removeCoupon()"
              class="text-xs text-red-500 hover:text-red-700 font-medium transition-colors">
              Remove
            </button>
          </div>
        `;
      }

      showMsg(msgElId, '✓ Coupon applied! You save ' + toINR(data.discountAmount), false);
      setTimeout(() => closeCouponModal(), 1200);

    } catch (err) {
      console.error(err);
      showMsg(msgElId, 'Something went wrong. Please try again.', true);
    }
  }
  

  /* ── Remove coupon ── */
  async function removeCoupon() {
    try {
      await fetch('/checkout/remove-coupon', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
      });
    } catch (_) {}

    updateTotals(0, '');

    // Restore input UI
    const couponEntry = document.getElementById('couponEntryArea');
    if (couponEntry) {
      couponEntry.innerHTML = `
        <div class="flex gap-2 mb-2">
          <div class="relative flex-1">
            <i class="fa-solid fa-ticket absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" style="font-size:11px"></i>
            <input type="text" id="couponInput"
              placeholder="Enter coupon code"
              class="w-full border border-gray-200 rounded-xl pl-9 pr-3 py-2.5 text-xs font-semibold tracking-wider uppercase
                     focus:outline-none focus:border-[#1a5c1a] focus:ring-2 focus:ring-[#1a5c1a]/10 transition-all"
              style="font-family:'Poppins',sans-serif"
              oninput="this.value=this.value.toUpperCase()" />
          </div>
          <button type="button" onclick="applyCouponCode()"
            class="bg-[#1a5c1a] hover:bg-[#144d14] text-white text-xs font-semibold px-4 rounded-xl transition-colors whitespace-nowrap">
            Apply
          </button>
        </div>
        <p id="couponMsg" class="text-xs mb-2 hidden"></p>
        <button type="button" onclick="openCouponModal()"
          class="flex items-center gap-1.5 text-[#1a5c1a] hover:text-[#144d14] text-xs font-medium transition-colors">
          <i class="fa-solid fa-tags" style="font-size:0.7rem"></i>
          View available coupons
          <i class="fa-solid fa-chevron-right" style="font-size:0.6rem"></i>
        </button>
      `;
    }
  }

  /* ── Modal open/close ── */
  function openCouponModal() {
    const modal = document.getElementById('couponModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }
  function closeCouponModal() {
    const modal = document.getElementById('couponModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  }

  // Close on backdrop click
  document.getElementById('couponModal').addEventListener('click', function(e) {
    if (e.target === this) closeCouponModal();
  });

  // Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeCouponModal();
  });
</script>


