<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Checkout | Leafora</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>

  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    body{
      font-family:'Poppins',sans-serif;
      background:#f5f5f5;
    }
  </style>
</head>

<body>

<!-- MAIN -->
<section class="max-w-7xl mx-auto px-6 py-10 min-h-screen">

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

    <!-- LEFT SIDE -->
    <div class="lg:col-span-2">

      <h3 class="text-[#2f6b3c] font-semibold mb-6">
        Select Payment Method
      </h3>

      <!-- Razorpay -->
      <label
        class="block border rounded-md bg-[#f7faf7] hover:border-[#2f6b3c] cursor-pointer transition">

        <div class="flex items-center justify-between p-4">

          <div>
            <h4 class="font-medium text-gray-800">
              Razorpay
            </h4>

            <p class="text-xs text-gray-500 mt-1">
              Pay securely with credit/debit card through Razorpay.
            </p>
          </div>

          <input
            type="radio"
            name="paymentMethod"
            value="razorpay"
            class="accent-green-700">
        </div>
      </label>

      <!-- COD -->
      <label
        class="block border rounded-md bg-[#f7faf7] hover:border-[#2f6b3c] cursor-pointer transition mt-4">

        <div class="flex items-center justify-between p-4">

          <div>
            <h4 class="font-medium text-gray-800">
              Cash On Delivery
            </h4>

            <p class="text-xs text-gray-500 mt-1">
              Pay when you receive your order. Additional charges may apply.
            </p>
          </div>

          <input
            type="radio"
            name="paymentMethod"
            value="cod"
            class="accent-green-700">
        </div>
      </label>

      <!-- EMPTY SPACE LIKE SCREENSHOT -->
      <div class="h-[420px]"></div>

    </div>


    <!-- ORDER SUMMARY -->
    <div>

      <div class="bg-white rounded-md border shadow-sm">

        <div class="p-4 border-b">
          <h3 class="font-semibold text-[#2f6b3c]">
            Order Summary
          </h3>
        </div>

        <!-- PRODUCT -->
        <div class="p-4">

          <div class="flex gap-3">

            <!-- IMAGE PLACEHOLDER -->
            <div
              class="w-16 h-16 border rounded bg-gray-100 flex items-center justify-center flex-shrink-0">

              <i class="fa-solid fa-image text-gray-400 text-xl"></i>

            </div>

            <div class="flex-1">

              <h4 class="text-sm font-medium">
                Natural Plant Set
              </h4>

              <p class="text-xs text-gray-500">
                Qty: 1
              </p>

              <p class="text-sm font-semibold text-[#2f6b3c] mt-1">
                ₹1,250
              </p>

            </div>

          </div>

        </div>

        <!-- PRICE DETAILS -->
        <div class="px-4 pb-4">

          <div class="space-y-2 text-sm">

            <div class="flex justify-between">
              <span>Subtotal</span>
              <span>₹1250</span>
            </div>

            <div class="flex justify-between text-green-600">
              <span>Discount</span>
              <span>-₹200</span>
            </div>

            <div class="flex justify-between">
              <span>Delivery</span>
              <span>₹50</span>
            </div>

            <div class="flex justify-between text-green-600">
              <span>Coupon</span>
              <span>-₹100</span>
            </div>

          </div>

          <hr class="my-4">

          <div class="flex justify-between font-semibold text-base">
            <span>Total Amount</span>
            <span>₹1000</span>
          </div>

          <!-- BUTTON -->
          <button
            class="w-full mt-5 bg-[#2f6b3c] hover:bg-[#255631] text-white py-3 rounded-md font-medium">

            Pay Securely

          </button>

          <!-- TRUST ICONS -->
          <div class="mt-4">

            <div class="flex justify-center gap-5 text-gray-400 text-lg">

              <i class="fa-solid fa-lock"></i>
              <i class="fa-brands fa-cc-visa"></i>
              <i class="fa-brands fa-cc-mastercard"></i>
              <i class="fa-brands fa-google-pay"></i>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>


<!-- FOOTER -->
<footer class="bg-gradient-to-r from-[#05351d] via-[#0d4b2a] to-[#05351d] text-white mt-20">

  <div class="max-w-7xl mx-auto px-6 py-14">

    <div class="grid md:grid-cols-5 gap-10">

      <!-- BRAND -->
      <div>

        <h2 class="text-3xl font-serif mb-4">
          Leafora
        </h2>

        <p class="text-sm text-gray-300 mb-4">
          Download the Leafora App Now
        </p>

        <!-- QR PLACEHOLDER -->
        <div
          class="w-32 h-32 bg-white rounded flex items-center justify-center">

          <span class="text-black text-xs">
            QR IMAGE
          </span>

        </div>

      </div>

      <div>
        <h4 class="font-semibold mb-4">Shop</h4>

        <ul class="space-y-2 text-sm text-gray-300">
          <li>Indoor Plants</li>
          <li>Outdoor Plants</li>
          <li>Seeds</li>
          <li>Planters</li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold mb-4">Helpful Links</h4>

        <ul class="space-y-2 text-sm text-gray-300">
          <li>Shipping Policy</li>
          <li>Return Policy</li>
          <li>Terms & Conditions</li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold mb-4">Information</h4>

        <ul class="space-y-2 text-sm text-gray-300">
          <li>About Us</li>
          <li>Contact Us</li>
          <li>Privacy Policy</li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold mb-4">Contact Us</h4>

        <p class="text-sm text-gray-300">
          +91 9876543210
        </p>

        <p class="text-sm text-gray-300 mt-2">
          support@leafora.com
        </p>

        <div class="flex gap-4 mt-4 text-lg">

          <i class="fab fa-facebook-f"></i>
          <i class="fab fa-instagram"></i>
          <i class="fab fa-twitter"></i>

        </div>

      </div>

    </div>

  </div>

</footer>

</body>
</html>