      <button onclick="document.getElementById('cancelItemModal').classList.add('hidden')" class="px-5 py-2 text-xs font-medium border border-gray-300 rounded-lg text-gray-600 hover:bg-gray-50">Cancel</button>
      <button onclick="submitCancelItem()" class="px-5 py-2 text-xs font-semibold bg-[#1a5c1a] hover:bg-[#144d14] text-white rounded-lg">Submit</button>
