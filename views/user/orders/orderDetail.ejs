      <% for(let s=1;s<=5;s++){ %>
        <i class="fa-regular fa-star" data-val="<%= s %>"
           onclick="setRating(<%= s %>)"
           style="cursor:pointer;font-size:1.4rem;color:#d1d5db;transition:color .15s"
           id="star-<%= s %>"></i>
      <% } %>
    </div>
    <p class="text-xs font-semibold text-gray-700 mb-2">Tell Us More</p>
    <textarea id="reviewText" class="f-textarea"
      placeholder="Type any additional feedback here"></textarea>
    <button onclick="submitReview()"
      class="w-full mt-4 bg-[#8b1a1a] hover:bg-[#6e1414] text-white font-bold text-xs py-3 rounded-lg uppercase tracking-widest transition-colors">
      Submit
    </button>
  </div>
</div>

<script>
  const ORDER_ID     = '<%= o._id %>';
  let _cancelOrderId = ORDER_ID;
  let _returnOrderId = ORDER_ID;
  let _reviewOrderId = ORDER_ID;
  



  function openReturnModal(orderId) {
    _returnOrderId = orderId;
    _returnItemId = null; // Reset item ID to distinguish from item-level return
    document.getElementById('returnReason').value   = '';
    document.getElementById('returnComments').value = '';
    document.getElementById('returnModal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  /* ── Cancel modal ── */
  function openCancelModal() {
    document.getElementById('cancelReason').value = '';
    document.getElementById('cancelModal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  async function submitCancel() {
    const reason = document.getElementById('cancelReason').value.trim();
    try {
      const res  = await fetch(`/orders/${_cancelOrderId}/cancel`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason }),
      });
      const data = await res.json();
      document.getElementById('cancelModal').classList.add('hidden');
      document.body.style.overflow = '';
      if (data.success) { showToast('Order cancelled.', 'success'); setTimeout(() => window.location.reload(), 800); }
      else showToast(data.message || 'Could not cancel order.', 'error');
    } catch { showToast('Network error. Please try again.', 'error'); }
  }

  /* ── Return modal ── */
  let _returnItemId = null;
  function openReturnItemModal(orderId, itemId) {
    _returnOrderId = orderId;
    _returnItemId = itemId;
    document.getElementById('returnReason').value   = '';
    document.getElementById('returnComments').value = '';
    document.getElementById('returnModal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  async function submitReturn() {
    const reason   = document.getElementById('returnReason').value;
    const comments = document.getElementById('returnComments').value.trim();
    if (!reason) { showToast('Please select a reason for return.', 'error'); return; }

    if (_returnItemId) {
      try {
        const res = await fetch(`/orders/${_returnOrderId}/item/${_returnItemId}/return`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason, comments }),
        });
        const data = await res.json();
        document.getElementById('returnModal').classList.add('hidden');
        document.body.style.overflow = '';
        if (data.success) { showToast('Return request submitted!', 'success'); setTimeout(() => window.location.reload(), 800); }
        else showToast(data.message || 'Could not submit return.', 'error');
      } catch { showToast('Network error.', 'error'); }
    } else {
      // Full order return uses form submission based on original logic
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = `/orders/${_returnOrderId}/return`;

      const reasonInput = document.createElement('input');
      reasonInput.type = 'hidden';
      reasonInput.name = 'reason';
      reasonInput.value = reason;

      const commentsInput = document.createElement('input');
      commentsInput.type = 'hidden';
      commentsInput.name = 'comments';
      commentsInput.value = comments;

      form.appendChild(reasonInput);
      form.appendChild(commentsInput);

      document.body.appendChild(form);
      form.submit();
    }
  }

  /* ── Review modal ── */
 let _reviewProductId = null;
let _reviewRating = 0;

function openReviewModal(productId, imgSrc, productName) {

  _reviewProductId = productId;
  _reviewRating = 0;

  document.getElementById('reviewText').value = '';

  for (let s = 1; s <= 5; s++) {
    const star = document.getElementById('star-' + s);

    if (star) {
      star.className = 'fa-regular fa-star';
      star.style.color = '#d1d5db';
    }
  }

  document.getElementById('reviewModal').classList.remove('hidden');
}

function setRating(rating) {
  _reviewRating = rating;

  for (let i = 1; i <= 5; i++) {
    const star = document.getElementById('star-' + i);

    if (i <= rating) {
      star.className = 'fa-solid fa-star';
      star.style.color = '#facc15';
    } else {
      star.className = 'fa-regular fa-star';
      star.style.color = '#d1d5db';
    }
  }
}

async function submitReview() {
  const comment = document.getElementById('reviewText').value.trim();

  // if (!_reviewProductId) {
  //   return showToast('Product not found', 'error');
  // }

  if (_reviewRating === 0) {
    return showToast('Please select a rating', 'error');
  }

  try {
    const res = await fetch(
      `/orders/${ORDER_ID}/review/${_reviewProductId}`,
      {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          rating: _reviewRating,
          comment
        })
      }
    );

    const data = await res.json();

    if (data.success) {
      showToast('Review submitted successfully', 'success');

      document.getElementById('reviewModal').classList.add('hidden');

      setTimeout(() => {
        window.location.reload();
      }, 1000);
    } else {
      showToast(data.message || 'Failed to submit review', 'error');
    }
  } catch (err) {
    console.error(err);
    showToast('Network error', 'error');
  }
}

  /* ── Close modals on overlay click ── */
  ['cancelModal','returnModal','reviewModal'].forEach(id => {
    document.getElementById(id).addEventListener('click', function(e) {
      if (e.target === this) { this.classList.add('hidden'); document.body.style.overflow = ''; }
    });
  });

  /* ── Mini toast ── */
  function showToast(msg, type) {
    const old = document.getElementById('miniToast');
    if (old) old.remove();
    const t = document.createElement('div');
    t.id = 'miniToast';
    t.className = 'toast ' + (type === 'success'
      ? 'bg-green-50 border border-green-200 text-green-700'
      : 'bg-red-50 border border-red-200 text-red-700');
    t.innerHTML = `<i class="fa-solid fa-${type === 'success' ? 'circle-check' : 'circle-exclamation'}"></i> ${msg}`;
    document.body.appendChild(t);
    setTimeout(() => t.remove(), 3500);
  }

  /* ── Auto dismiss flash toast ── */
  const ft = document.getElementById('flashToast');
  if (ft) setTimeout(() => ft.remove(), 5000);
</script>
<script>
async function addToCart(event, productId, variantId) {
  event.preventDefault();
  event.stopPropagation();

  try {
    const res = await fetch('/cart/add', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        productId,
        variantId,
        quantity: 1
      })
    });

    const data = await res.json();

    console.log(data);

    if (data.success) {

      Swal.fire({
        toast: true,
        position: 'top-end',
        icon: 'success',
        title: 'Added to cart',
        timer: 1500,
        showConfirmButton: false
      });

      updateCartBadge(data.cartCount);

    } else {

      Swal.fire({
        icon: 'error',
        title: data.message
      });

    }

  } catch(err){
    console.error(err);
  }
}

function updateCartBadge(count) {

    const badge = document.getElementById("cartCount");

    if(!badge) return;

    badge.textContent = count;

    if(count > 0){
        badge.classList.remove("hidden");
    }else{
        badge.classList.add("hidden");
    }

}
</script>

