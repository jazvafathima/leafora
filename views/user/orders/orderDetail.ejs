<script>
  let _cancelItemOrderId = '';
  let _cancelItemId = '';
  function openCancelItemModal(orderId, itemId) {
    _cancelItemOrderId = orderId;
    _cancelItemId = itemId;
    document.getElementById('cancelItemReason').value = '';
    document.getElementById('cancelItemModal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  async function submitCancelItem() {
    const reason = document.getElementById('cancelItemReason').value.trim();
    try {
      const res = await fetch(`/orders/${_cancelItemOrderId}/item/${_cancelItemId}/cancel`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason })
      });
      const data = await res.json();
      document.getElementById('cancelItemModal').classList.add('hidden');
      document.body.style.overflow = '';
      if (data.success) {
        showToast('Item cancelled.', 'success');
        setTimeout(() => window.location.reload(), 800);
      } else {
        showToast(data.message || 'Could not cancel item.', 'error');
      }
    } catch {
      showToast('Network error. Please try again.', 'error');
    }
  }
</script>

