      <p class="text-base font-bold text-gray-900 uppercase tracking-wider mb-0.5">Help Us</p>
      <p class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-2">Make Our Products Better</p>
      <div class="w-16 h-[2px] bg-gray-800 mx-auto"></div>
    </div>
    <!-- Product image slot -->
    <div id="reviewProductImg"
         class="w-24 h-24 rounded-xl overflow-hidden bg-gray-100 mx-auto mb-4 flex items-center justify-center">
      <i class="fa-solid fa-seedling text-3xl" style="color:#b8d4b8"></i>
