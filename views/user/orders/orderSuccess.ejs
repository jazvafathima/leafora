<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Placed! - Leafora</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; }
    body { font-family: 'Poppins', sans-serif; background: #f5f0e8; margin: 0; min-height: 100vh; }

    /* ── Navbar ── */
    .navbar { background: #f5f0e8; padding: 0 40px; display: flex; align-items: center; justify-content: space-between; height: 56px; border-bottom: 1px solid #e8e2d8; }
    .nav-logo { display: flex; align-items: center; gap: 6px; text-decoration: none; }
    .nav-logo img { height: 32px; }
    .nav-logo span { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 700; color: #1a5c1a; }
    .nav-links a { font-size: 0.78rem; color: #374151; text-decoration: none; margin-left: 22px; }
    .nav-icons a { color: #374151; font-size: 0.88rem; text-decoration: none; margin-left: 14px; }

    /* ── Confetti animation ── */
    @keyframes float { 0%,100%{transform:translateY(0) rotate(0)} 50%{transform:translateY(-12px) rotate(5deg)} }
    @keyframes bounce { 0%,100%{transform:scale(1)} 50%{transform:scale(1.06)} }
    @keyframes checkIn { from{stroke-dashoffset:60} to{stroke-dashoffset:0} }
    .float-anim { animation: float 3s ease-in-out infinite; }
    .bounce-anim { animation: bounce 2s ease-in-out infinite; }
    .check-anim { stroke-dasharray: 60; stroke-dashoffset: 60; animation: checkIn .6s ease forwards .3s; }

    /* ── Order detail row ── */
    .detail-row { display: flex; align-items: center; justify-content: space-between; font-size: 0.78rem; padding: 6px 0; border-bottom: 1px solid #f5f5f5; }
    .detail-row:last-child { border-bottom: none; }
  </style>
</head>
<body>

<!-- ════════ NAVBAR ════════ -->
<nav class="navbar">
  <a href="/" class="nav-logo">
    <img src="/images/leafora logo.png" alt="Leafora" onerror="this.style.display='none'" />
    <span>Leafora</span>
  </a>
      <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-gray-600">
        <a href="/"          class="hover:text-leaf-700 transition-colors">Home</a>
        <a href="/productlist" class="hover:text-leaf-700 transition-colors"  >products</a>
        <a href="/about"  class="hover:text-leaf-700 transition-colors">About</a>
        <a href="/contact"     class="hover:text-leaf-700 transition-colors">Contact</a>
      </nav>

  <div class="nav-icons" style="display:flex;align-items:center">
    <a href="/profile" title="Account"><i class="fa-regular fa-user"></i></a>
    <a href="/wishlist" title="Wishlist"><i class="fa-regular fa-heart"></i></a>
    <a href="/cart" title="Cart" style="position:relative">
      <i class="fa-solid fa-bag-shopping"></i>
      <span id="cartBadge" class="cart-badge" style="<%= (typeof cartCount !== 'undefined' && cartCount > 0) ? 'display:flex;' : 'display:none;' %>"><%= (typeof cartCount !== 'undefined') ? cartCount : 0 %></span>
    </a>
  </div>
</nav>

<!-- ════════ SUCCESS CONTENT ════════ -->
<div class="max-w-lg mx-auto px-4 py-12 text-center">

  <!-- ── SVG Illustration ── -->
  <div class="float-anim mb-6 flex justify-center">
    <svg width="140" height="140" viewBox="0 0 140 140" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Outer circle -->
      <circle cx="70" cy="70" r="68" fill="#f0faf0" stroke="#1a5c1a" stroke-width="2"/>
      <!-- Leaf decorations -->
      <ellipse cx="30" cy="40" rx="14" ry="8" fill="#dcfce7" transform="rotate(-30 30 40)" opacity=".7"/>
      <ellipse cx="110" cy="40" rx="14" ry="8" fill="#dcfce7" transform="rotate(30 110 40)" opacity=".7"/>
      <ellipse cx="22" cy="90" rx="12" ry="7" fill="#bbf7d0" transform="rotate(-50 22 90)" opacity=".6"/>
      <ellipse cx="118" cy="90" rx="12" ry="7" fill="#bbf7d0" transform="rotate(50 118 90)" opacity=".6"/>
      <!-- Inner circle -->
      <circle cx="70" cy="70" r="50" fill="#1a5c1a"/>
      <!-- Checkmark -->
      <polyline class="check-anim" points="48,70 62,84 92,56"
        stroke="#fff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    </svg>
  </div>

  <!-- ── Thank-you text ── -->
  <h1 class="font-display text-3xl font-bold text-gray-900 mb-2">Order Placed!</h1>
  <p class="text-gray-500 text-sm mb-1">
    Thank you, <strong class="text-gray-700">
      <%= typeof orderData !== 'undefined' && orderData && orderData.user ? orderData.user.firstName : 'Customer' %>
    </strong>! 🎉
  </p>
  <p class="text-gray-400 text-xs mb-6 leading-relaxed">
    Your order has been placed successfully. We'll start preparing your beautiful plants right away and notify you once they're on the way!
  </p>

  <!-- ── Order ID card ── -->
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm px-6 py-5 mb-6 text-left">

    <div class="flex items-center gap-2 mb-4">
      <i class="fa-solid fa-receipt text-[#1a5c1a]" style="font-size:.95rem"></i>
      <p class="text-sm font-bold text-gray-800">Order Confirmation</p>
    </div>

    <div class="detail-row">
      <span class="text-gray-400">Order ID</span>
      <span class="font-mono font-semibold text-gray-800">
        #<%= typeof orderData !== 'undefined' && orderData ? orderData.orderId || orderData._id : 'LF-000000' %>
      </span>
    </div>
<div class="detail-row">
  <span class="text-gray-400">Payment</span>

  <span class="font-semibold text-gray-700 flex items-center gap-1.5">

    <% if (orderData.paymentMethod === "cod") { %>

      <i class="fa-solid fa-money-bill-wave text-green-500" style="font-size:.75rem"></i>
      Cash on Delivery

    <% } else if (orderData.paymentMethod === "wallet") { %>

      <i class="fa-solid fa-wallet text-blue-500" style="font-size:.75rem"></i>
      Wallet

    <% } else if (orderData.paymentMethod === "online") { %>

      <i class="fa-solid fa-credit-card text-purple-500" style="font-size:.75rem"></i>
      Online Payment

    <% } else { %>

      <i class="fa-solid fa-circle-question text-gray-500" style="font-size:.75rem"></i>
      <%= orderData.paymentMethod %>

    <% } %>

  </span>
</div>
    <div class="detail-row">
      <span class="text-gray-400">Status</span>
      <span class="bg-amber-100 text-amber-700 text-xs font-bold px-3 py-0.5 rounded-full">Pending</span>
    </div>
    <div class="detail-row">
      <span class="text-gray-400">Total Paid</span>
      <span class="font-bold text-[#1a5c1a] text-base">
        ₹<%= typeof orderData !== 'undefined' && orderData && orderData.total ? Number(orderData.total).toLocaleString('en-IN') : '0' %>
      </span>
    </div>

    <% if (typeof orderData !== 'undefined' && orderData && orderData.address) { %>
    <div class="detail-row items-start">
      <span class="text-gray-400">Delivering to</span>
      <span class="text-gray-700 text-right text-xs leading-relaxed max-w-44">
        <%= orderData.address.fullName %><br/>
        <%= orderData.address.addressLine1 %>,
        <%= orderData.address.city %> – <%= orderData.address.pincode %>
      </span>
    </div>
    <% } %>

    <!-- Estimated delivery -->
    <div class="mt-4 bg-green-50 border border-green-100 rounded-xl px-4 py-3 flex items-center gap-3">
      <i class="fa-solid fa-truck-fast text-[#1a5c1a] text-lg"></i>
      <div>
        <p class="text-xs font-semibold text-gray-700">Estimated Delivery</p>
        <p class="text-xs text-gray-400">
          <%
            const now  = new Date();
            const eta  = new Date(now.getTime() + 5 * 24 * 60 * 60 * 1000);
            const opts = { day:'numeric', month:'long', year:'numeric' };
          %>
          <%= now.toLocaleDateString('en-IN', opts) %> –
          <%= eta.toLocaleDateString('en-IN', opts) %>
        </p>
      </div>
    </div>
  </div>

  
  

  <!-- ── Action buttons ── -->
  <div class="flex flex-col gap-3">

    <a href="/orderhistory"
       class="w-full bg-[#1a5c1a] hover:bg-[#144d14] text-white font-semibold text-sm py-3.5 rounded-xl transition-colors flex items-center justify-center gap-2">
      <i class="fa-solid fa-clipboard-list text-xs"></i> View Order Details
    </a>

    <a href="/productlist"
       class="w-full border-2 border-[#1a5c1a] text-[#1a5c1a] hover:bg-[#1a5c1a] hover:text-white font-semibold text-sm py-3.5 rounded-xl transition-colors flex items-center justify-center gap-2">
      <i class="fa-solid fa-seedling text-xs"></i> Continue Shopping
    </a>

    <a href="/"
       class="w-full text-gray-400 hover:text-gray-600 text-sm font-medium py-2 transition-colors flex items-center justify-center gap-2">
      <i class="fa-solid fa-house text-xs"></i> Back to Home
    </a>

  </div>

  <!-- ── Social share nudge ── -->
  <div class="mt-8 text-center">
    <p class="text-xs text-gray-400 mb-2">Share your new plant with us!</p>
    <div class="flex items-center justify-center gap-3">
      <a href="https://instagram.com" target="_blank"
         class="w-8 h-8 rounded-full bg-gradient-to-tr from-purple-500 to-pink-500 flex items-center justify-center text-white">
        <i class="fa-brands fa-instagram text-xs"></i>
      </a>
      <a href="https://facebook.com" target="_blank"
         class="w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center text-white">
        <i class="fa-brands fa-facebook-f text-xs"></i>
      </a>
      <a href="https://twitter.com" target="_blank"
         class="w-8 h-8 rounded-full bg-black flex items-center justify-center text-white">
        <i class="fa-brands fa-x-twitter text-xs"></i>
      </a>
    </div>
  </div>

  <p class="text-[10px] text-gray-300 mt-6">
    A confirmation email has been sent to your registered email address.
  </p>

</div>

<!-- ════════ FOOTER ════════ -->
<footer style="background-color:#1a2e1a;font-family:'Poppins',sans-serif;margin-top:24px">
  <div class="max-w-6xl mx-auto px-6 pt-8 pb-5">
    <div class="border-t border-gray-600 pb-4"></div>
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2">
      <p class="text-gray-400 text-[11px]">© 2026 Leafora – All Rights Reserved.</p>
      <div class="flex gap-4">
        <a href="#" class="text-gray-400 text-[11px] hover:text-white">Terms &amp; Conditions</a>
        <a href="#" class="text-gray-400 text-[11px] hover:text-white">Privacy Policy</a>
        <a href="#" class="text-gray-400 text-[11px] hover:text-white">Disclaimer</a>
      </div>
    </div>
    <p class="text-right mt-3 text-sm font-medium" style="color:#6aaa6a;font-family:'Playfair Display',serif">Grow Green, Live Fresh 🌿</p>
  </div>
</footer>

<div id="pageLoader" class="hidden">
    <div class="loader"></div>
</div>

<script src="/js/globalLoader.js"></script>

</body>
</html>
