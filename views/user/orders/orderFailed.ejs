<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Leafora | Payment Failed</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            leaf: {
              50:  "#eefaf1",
              100: "#d6f2dd",
              600: "#1f8a4c",
              700: "#166534",
              800: "#14532d",
              900: "#0f3d22",
            },
            cream: "#faf3e5",
          },
        },
      },
    };
  </script>

  <style>
    body { font-family: "Segoe UI", ui-sans-serif, system-ui, sans-serif; }
  </style>
</head>

<body class="bg-slate-50 text-slate-800">

  <!-- ============ HEADER ============ -->
  <header class="bg-cream">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <div class="flex items-center gap-2">
        <i class="fa-solid fa-leaf text-leaf-700 text-xl"></i>
        <span class="text-xl font-bold text-leaf-800">Leafora</span>
      </div>

      <nav class="hidden md:flex items-center gap-8 text-sm text-slate-700">
        <% const navItems = locals.navItems || [
          { label: "Home",     href: "#" },
          { label: "Shop",     href: "#", active: true },
          { label: "Products", href: "#" },
          { label: "Pages",    href: "#" },
        ]; %>
        <% navItems.forEach(function(item) { %>
          <a href="<%= item.href %>"
             class="pb-1 transition <%= item.active
                ? 'font-medium text-slate-900 border-b-2 border-leaf-700'
                : 'text-slate-600 hover:text-slate-900' %>">
            <%= item.label %>
          </a>
        <% }); %>
      </nav>

      <div class="flex items-center gap-5 text-slate-700">
        <i class="fa-solid fa-magnifying-glass"></i>
        <i class="fa-regular fa-circle-user"></i>
        <i class="fa-solid fa-bag-shopping"></i>
      </div>
    </div>
  </header>

  <!-- ============ MAIN ============ -->
  <main class="bg-slate-50 py-16 px-4">
    <div class="mx-auto max-w-lg rounded-2xl bg-white p-8 shadow-sm text-center">

      <!-- Failure icon -->
      <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-full bg-red-50">
        <div class="flex h-11 w-11 items-center justify-center rounded-full border-2 border-red-300">
          <i class="fa-solid fa-xmark text-red-400 text-lg"></i>
        </div>
      </div>

      <h1 class="text-xl font-bold text-slate-800">Payment Failed</h1>
      <p class="mt-2 text-sm text-slate-500">
        We were unable to process your payment. Please check your
        payment details and try again.
      </p>

      <!-- Transaction details -->


      <p class="mt-6 text-xs leading-relaxed text-slate-400">
        Common reasons for payment failure include insufficient funds, incorrect card
        details, or bank restrictions. Please verify your information and try again.
      </p>

      <!-- Actions -->
      <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-3">
       <form action="/checkout" method="GET">
  <button
    type="submit"
    class="flex w-full sm:w-auto items-center justify-center gap-2 rounded-lg bg-leaf-800 px-5 py-2.5 text-sm font-medium text-white hover:bg-leaf-900 transition"
  >
    <i class="fa-solid fa-rotate-right"></i>
    Try Again
  </button>
</form>
      
      </div>
    </div>
  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="bg-leaf-900 text-slate-300">
    <div class="mx-auto max-w-6xl px-6 py-14">
      <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">

        <!-- App download / QR -->
        <div>
          <div class="flex items-center gap-2 mb-5">
            <i class="fa-solid fa-leaf text-leaf-100 text-xl"></i>
            <span class="text-2xl font-bold text-white">Leafora</span>
          </div>
          <p class="text-sm font-medium text-slate-200 mb-3">Download the Leafora App Now</p>

          <!-- empty QR code placeholder, fixed size -->
          <div class="h-28 w-28 rounded-lg bg-white p-1.5 flex items-center justify-center">
            <% if (locals.qrCodeUrl) { %>
              <img src="<%= qrCodeUrl %>" alt="Download app QR code" class="h-full w-full object-contain" />
            <% } else { %>
              <i class="fa-solid fa-qrcode text-slate-800 text-5xl"></i>
            <% } %>
          </div>

          <div class="mt-4 flex flex-col gap-2">
            <a href="#" class="flex items-center gap-2 rounded-md border border-slate-600 px-3 py-1.5 w-fit">
              <i class="fa-brands fa-google-play"></i>
              <span class="text-[11px] leading-tight">
                <span class="block text-slate-400">GET IT ON</span>
                <span class="block font-medium text-white">Google Play</span>
              </span>
            </a>
            <a href="#" class="flex items-center gap-2 rounded-md border border-slate-600 px-3 py-1.5 w-fit">
              <i class="fa-brands fa-apple"></i>
              <span class="text-[11px] leading-tight">
                <span class="block text-slate-400">Download on the</span>
                <span class="block font-medium text-white">App Store</span>
              </span>
            </a>
          </div>
        </div>

        <!-- Helpful Links -->
        <div>
          <h4 class="font-semibold text-white mb-4">Helpful Links</h4>
          <ul class="space-y-2 text-sm">
            <% (locals.helpfulLinks || [
              "Plant Care Guide", "Shipping Policy", "Returns & Refunds",
              "Track Order", "Locate Stores"
            ]).forEach(function(link) { %>
              <li><a href="#" class="hover:text-white transition"><%= link %></a></li>
            <% }); %>
          </ul>
        </div>

        <!-- Information -->
        <div>
          <h4 class="font-semibold text-white mb-4">Information</h4>
          <ul class="space-y-2 text-sm">
            <% (locals.infoLinks || [
              "Plant Blog", "Plant Care Tips", "FAQs", "About Us"
            ]).forEach(function(link) { %>
              <li><a href="#" class="hover:text-white transition"><%= link %></a></li>
            <% }); %>
          </ul>
        </div>

        <!-- Contact Us -->
        <div>
          <h4 class="font-semibold text-white mb-4">Contact Us</h4>
          <ul class="space-y-2 text-sm">
            <li><%= locals.phone || "+91 9090000000" %></li>
            <li>Email Us: <%= locals.email || "support@leafora.com" %></li>
          </ul>
          <div class="mt-4 flex items-center gap-3">
            <i class="fa-brands fa-whatsapp"></i>
            <i class="fa-regular fa-paper-plane"></i>
            <i class="fa-solid fa-magnifying-glass"></i>
          </div>

          <h4 class="font-semibold text-white mt-6 mb-3">Social</h4>
          <div class="flex items-center gap-3">
            <i class="fa-brands fa-facebook-f"></i>
            <i class="fa-brands fa-x-twitter"></i>
            <i class="fa-brands fa-pinterest-p"></i>
            <i class="fa-brands fa-instagram"></i>
          </div>
          <div class="mt-3 flex items-center gap-3">
            <i class="fa-regular fa-envelope"></i>
            <i class="fa-solid fa-comment"></i>
            <i class="fa-brands fa-youtube"></i>
            <i class="fa-brands fa-tiktok"></i>
            <i class="fa-brands fa-linkedin-in"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10">
      <div class="mx-auto max-w-6xl px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-slate-400">
        <span>© <%= locals.year || 2026 %> Leafora - All Rights Reserved.</span>
        <div class="flex items-center gap-4">
          <a href="#" class="hover:text-white">Terms &amp; Conditions</a>
          <a href="#" class="hover:text-white">Privacy Policy</a>
          <a href="#" class="hover:text-white">Disclaimer</a>
        </div>
        <span class="flex items-center gap-1">Grow Green, Live Fresh <i class="fa-solid fa-leaf text-leaf-100"></i></span>
      </div>
    </div>
  </footer>

</body>
</html>
