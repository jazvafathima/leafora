<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Failed - Leafora</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Poppins', sans-serif; background: #f5f0e8; }
    .container { max-width: 600px; margin: 4rem auto; padding: 2rem; background: white; border-radius: .5rem; box-shadow: 0 2px 10px rgba(0,0,0,.1); }
  </style>
</head>
<body>
  <div class="container text-center">
    <h1 class="text-2xl font-bold text-red-600 mb-4">Order Failed</h1>
    <p class="text-gray-700 mb-6">Unfortunately we could not process your order. Please try again or contact support.</p>
    <% if (typeof error !== 'undefined' && error.length > 0) { %>
      <div class="bg-red-50 border border-red-200 text-red-700 p-3 rounded mb-4">
        <%= error[0] %>
      </div>
    <% } %>
    <a href="/checkout" class="inline-block bg-[#1a5c1a] hover:bg-[#144d14] text-white px-6 py-3 rounded">Return to Checkout</a>
  </div>
</body>
</html>
