      <div class="lg:col-span-1 space-y-4">

        <!-- Balance Card -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
          <h2 class="text-xl font-semibold text-gray-800 mb-4">Wallet Summary</h2>

          <!-- Available Balance -->
          <div class="bg-gray-50 rounded-xl p-5 text-center mb-5">
