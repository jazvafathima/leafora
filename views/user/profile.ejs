                +₹<%= totalCredits ? totalCredits.toLocaleString('en-IN') : '0' %>
              </span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-gray-500 text-sm">Total Debits</span>
              <span class="text-red-500 font-semibold text-sm">
                -₹<%= totalDebits ? totalDebits.toLocaleString('en-IN') : '0' %>
              </span>
            </div>
          </div>

          <!-- Divider -->
          <hr class="border-gray-100 mb-5">

          <!-- Add Funds Button -->
