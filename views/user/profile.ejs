    <%# ── User Header Card ── %>
    <div class="bg-white rounded-xl border border-gray-200 px-5 py-4 mb-4 flex flex-col sm:flex-row items-start sm:items-center gap-4">

      <%# IMAGE SLOT: Avatar — user.avatar from session/DB — 64x64px circle %>
      <div class="w-16 h-16 rounded-full overflow-hidden border-2 border-gray-200 bg-gray-100 flex items-center justify-center flex-shrink-0">
        <% if (typeof user !== 'undefined' && user && user.avatar) { %>
          <img src="<%= user.avatar %>" alt="Profile" class="w-full h-full object-cover" />
        <% } else { %>
          <i class="fa-regular fa-user text-gray-400 text-xl"></i>
        <% } %>
      </div>

      <div class="flex-1 min-w-0">
