          <% } else { %>
            Michael Anderson
          <% } %>
        </h1>
        <p class="text-xs text-gray-500 flex items-center gap-1.5 mt-1">
          <i class="fa-regular fa-envelope" style="font-size:10px;color:#9ca3af"></i>
          <% if (typeof user !== 'undefined' && user) { %>
            <%= user.email %>
          <% } else { %>
            michael.anderson@email.com
          <% } %>
        </p>
        <p class="text-xs text-gray-500 flex items-center gap-1.5 mt-0.5">
          <i class="fa-solid fa-phone" style="font-size:9px;color:#9ca3af"></i>
          <% if (typeof user !== 'undefined' && user && user.phone) { %>
            <%= user.phone %>
          <% } else { %>
            +1 (555) 123-4567
          <% } %>
        </p>
      </div>

      <div class="flex items-center gap-2 flex-shrink-0">

    
        <a href="/profileEdit"
