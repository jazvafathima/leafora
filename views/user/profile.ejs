      <%# ── TAB: Wallet ── %>
  <div id="tabWallet" class="tab-panel p-5">

<div class="min-h-screen bg-gray-50 py-10 px-4">
  <div class="max-w-6xl mx-auto">

  

    <!-- Main Grid -->
    <div class="mt-8 grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- Left: Wallet Transactions -->
      <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-xl font-semibold text-gray-800 mb-6">Wallet Transactions</h2>

        <% if (transactions && transactions.length > 0) { %>
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-gray-100">
                <th class="text-left text-gray-500 font-medium pb-4 w-32">Date</th>
                <th class="text-left text-gray-500 font-medium pb-4">Transaction Details</th>
                <th class="text-center text-gray-500 font-medium pb-4 w-28">Type</th>
                <th class="text-right text-gray-500 font-medium pb-4 w-28">Amount</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
              <% transactions.forEach(function(txn) { %>
                <tr class="hover:bg-gray-50 transition-colors duration-150">

                  <!-- Date -->
                  <td class="py-5 pr-4 text-gray-500 text-sm whitespace-nowrap align-top">
                    <%= new Date(txn.createdAt).toLocaleDateString('en-IN', {
                          year: 'numeric', month: 'long', day: 'numeric'
                        }) %>
                  </td>

                  <!-- Details -->
                  <td class="py-5 pr-4 align-top">
                    <p class="text-gray-800 font-medium"><%= txn.reason %></p>
                    <p class="text-gray-400 text-xs mt-0.5">ID: <%= txn.transactionId %></p>
                  </td>

                  <!-- Type Badge -->
                  <td class="py-5 pr-4 align-top text-center">
                    <% if (txn.type === 'credit') { %>
                      <span class="inline-block px-3 py-1 rounded-md text-xs font-semibold bg-green-100 text-green-600 tracking-wide">
                        CREDIT
                      </span>
                    <% } else { %>
                      <span class="inline-block px-3 py-1 rounded-md text-xs font-semibold bg-red-100 text-red-500 tracking-wide">
                        DEBIT
                      </span>
                    <% } %>
                  </td>

                  <!-- Amount -->
                  <td class="py-5 align-top text-right font-semibold whitespace-nowrap">
                    <% if (txn.type === 'credit') { %>
                      <span class="text-green-600">+₹<%= txn.amount.toLocaleString('en-IN') %></span>
                    <% } else { %>
                      <span class="text-red-500">-₹<%= txn.amount.toLocaleString('en-IN') %></span>
                    <% } %>
                  </td>

                </tr>
              <% }) %>
            </tbody>
          </table>

        <% } else { %>
          <!-- Empty State -->
          <div class="flex flex-col items-center justify-center py-20 text-center">
            <!-- Image placeholder (replace src with your illustration) -->
            <div class="w-40 h-40 bg-gray-100 rounded-full flex items-center justify-center mb-5">
              <i class="fa-regular fa-wallet text-gray-300 text-5xl"></i>
          
            </div>
            <p class="text-gray-700 font-semibold text-base">No transactions yet</p>
            <p class="text-gray-400 text-sm mt-1">Your wallet history will appear here</p>
            <a href="/shop"
               class="mt-5 inline-block bg-green-900 text-white text-sm font-medium px-6 py-2.5 rounded-lg hover:bg-gray-700 transition-colors">
              Start Shopping
