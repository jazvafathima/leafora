            onclick="openAddFundsModal()"
            class="w-full bg-green-900 text-white font-semibold py-3 rounded-xl hover:bg-gray-700 transition-colors duration-200 text-sm tracking-wide">
            Add Funds
          </button>
        </div>

        <!-- Quick Info Card -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
          <h3 class="text-sm font-semibold text-gray-700 mb-3">How Wallet Works</h3>
          <ul class="space-y-2 text-xs text-gray-500">
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-circle-check text-green-500 mt-0.5"></i>
              Refunds from cancelled orders are credited automatically
            </li>
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-circle-check text-green-500 mt-0.5"></i>
              Returns are credited once admin approves
            </li>
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-circle-check text-green-500 mt-0.5"></i>
              Use wallet balance at checkout
            </li>
          </ul>
        </div>

      </div>
    </div><!-- /grid -->
  </div>
</div>

<!-- Add Funds Modal -->
<div id="addFundsModal"
     class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm">
  <div class="bg-white rounded-2xl shadow-xl w-full max-w-sm mx-4 p-6">
    <div class="flex items-center justify-between mb-5">
      <h3 class="text-lg font-semibold text-gray-800">Add Funds</h3>
      <button onclick="closeAddFundsModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
        <i class="fa-solid fa-xmark text-xl"></i>
      </button>
    </div>

    <p class="text-sm text-gray-500 mb-4">Enter the amount you want to add to your wallet</p>

    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-700 mb-1">Amount (₹)</label>
      <input type="number" id="addFundsAmount" min="1" placeholder="e.g. 500"
             class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent">
    </div>

    <!-- Quick amounts -->
    <div class="flex gap-2 mb-5">
      <% [100, 500, 1000, 2000].forEach(function(amt) { %>
        <button onclick="setAmount(<%= amt %>)"
                class="flex-1 border border-gray-200 text-gray-600 text-xs font-medium py-2 rounded-lg hover:bg-gray-900 hover:text-white hover:border-gray-900 transition-colors">
          ₹<%= amt %>
        </button>
      <% }) %>
    </div>

    <button onclick="initiateAddFunds()"
            class="w-full bg-green-900 text-white font-semibold py-3 rounded-xl hover:bg-gray-700 transition-colors text-sm">
      Proceed to Pay
    </button>
  </div>
</div>


<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
  // Modal helpers
  function openAddFundsModal() {
    const modal = document.getElementById('addFundsModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeAddFundsModal() {
    const modal = document.getElementById('addFundsModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  function setAmount(val) {
    document.getElementById('addFundsAmount').value = val;
  }

  // Close on backdrop click
  document.getElementById('addFundsModal').addEventListener('click', function(e) {
    if (e.target === this) closeAddFundsModal();
  });

  async function initiateAddFunds() {
    const amount = parseInt(document.getElementById('addFundsAmount').value);
    if (!amount || amount < 1) {
      alert('Please enter a valid amount');
      return;
    }

    try {
      // 1. Create Razorpay order on backend
      const res = await fetch('/wallet/add-funds', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ amount })
      });
      const data = await res.json();

      // 2. Open Razorpay checkout
      const options = {
        key: data.keyId,
        amount: data.razorpayOrder.amount,
        currency: 'INR',
        name: 'Leafora',
        description: 'Add Funds to Wallet',
        order_id: data.razorpayOrder.id,
        handler: async function(response) {
          // 3. Verify payment server-side
          const verifyRes = await fetch('/wallet/verify-payment', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              razorpay_order_id: response.razorpay_order_id,
              razorpay_payment_id: response.razorpay_payment_id,
              razorpay_signature: response.razorpay_signature,
              amount
            })
          });
          const verifyData = await verifyRes.json();
          if (verifyData.success) {
            window.location.reload();
          } else {
            alert('Payment verification failed. Please contact support.');
          }
        },
        prefill: {
          name: '<%= user ? (user.firstName || '') + ' ' + (user.lastName || '') : '' %>',
          email: '<%= user ? user.email : '' %>'
        },
        theme: { color: '#111827' }
      };

      closeAddFundsModal();
      const rzp = new Razorpay(options);
      rzp.open();

    } catch (err) {
      console.error(err);
      alert('Something went wrong. Please try again.');
    }
  }
</script>
</div>



