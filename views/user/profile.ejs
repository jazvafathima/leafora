<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Leafora - Profile</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/global.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            leaf: {
              50:  '#f0faf0',
              100: '#dcf5dc',
              600: '#1f7a1f',
              700: '#185c18',
              800: '#124512',
              900: '#0b2f0b',
            },
            cream: '#f5f2eb',
          },
          fontFamily: {
            display: ['"Playfair Display"', 'serif'],
            body:    ['Poppins', 'sans-serif'],
          },
        },
      },
    };
  </script>

  <style>
    body { font-family: 'Poppins', sans-serif; background: #f5f2eb; }

    .tab-link {
      padding: 10px 2px;
      font-size: 0.82rem;
      color: #6b7280;
      border-bottom: 2px solid transparent;
      border-left: none; border-right: none; border-top: none;
      cursor: pointer;
      transition: all 0.2s;
      white-space: nowrap;
      background: none;
    }

     .navbar { background:#fff; border-bottom:1px solid #e9ecef; padding:0 32px; display:flex; align-items:center; justify-content:space-between; height:56px; position:sticky; top:0; z-index:100; }
    .nav-logo { display:flex; align-items:center; gap:6px; text-decoration:none; }
    .nav-logo img { height:36px; }
    .nav-logo span { font-family:'Playfair Display',serif; font-size:1.2rem; font-weight:700; color:#1a5c1a; }
    .nav-links a { font-size:0.8rem; color:#374151; text-decoration:none; font-weight:500; margin-left:24px; transition:color .15s; }
    .nav-links a:hover { color:#1a5c1a; }
    .nav-icons a { color:#374151; font-size:0.95rem; text-decoration:none; margin-left:16px; transition:color .15s; position:relative; }
    .nav-icons a:hover { color:#1a5c1a; }
    .cart-badge { position:absolute; top:-6px; right:-7px; background:#1a5c1a; color:#fff; font-size:0.55rem; font-weight:700; width:15px; height:15px; border-radius:50%; display:flex; align-items:center; justify-content:center; }


    .tab-link:hover  { color: #185c18; }
    .tab-link.active { color: #185c18; border-bottom-color: #185c18; font-weight: 600; }

    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    .info-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 11px 0;
      font-size: 0.82rem;
      border-bottom: 1px solid #f3f4f6;
    }
    .info-row:last-child { border-bottom: none; }
    .info-key { color: #6b7280; }
    .info-val { color: #1f2937; font-weight: 500; text-align: right; }
  </style>
</head>

<body class="min-h-screen bg-cream">

