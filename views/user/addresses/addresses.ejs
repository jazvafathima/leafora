<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Leafora - Manage Addresses</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

  <style>
    body { font-family:'Poppins',sans-serif; background:#f5f2eb; }
    .addr-card { background:#fff; border:1px solid #e5e7eb; border-radius:12px; padding:18px 20px; margin-bottom:12px; }
    .default-badge { background:#185c18; color:#fff; font-size:0.6rem; font-weight:700; padding:2px 8px; border-radius:999px; margin-left:8px; }
    .btn-edit   { font-size:0.72rem; color:#185c18; font-weight:600; cursor:pointer; }
    .btn-del    { font-size:0.72rem; color:#dc2626; font-weight:600; cursor:pointer; }
    .btn-setdef { font-size:0.7rem; border:1px solid #d1d5db; border-radius:6px; padding:4px 10px; }
    .addr-line { font-size:0.75rem; color:#6b7280; line-height:1.6; }


     /* ── Navbar ── */
    .navbar { background: #f5f0e8; padding: 0 40px; display: flex; align-items: center; justify-content: space-between; height: 60px; border-bottom: 1px solid #e8e2d8; position: sticky; top: 0; z-index: 100; }
    .nav-logo { display: flex; align-items: center; gap: 6px; text-decoration: none; }
    .nav-logo img { height: 34px; }
    .nav-logo span { font-family: 'Playfair Display', serif; font-size: 1.15rem; font-weight: 700; color: #1a5c1a; }
    .nav-links { display: flex; align-items: center; gap: 28px; }
    .nav-links a { font-size: 0.8rem; color: #374151; text-decoration: none; font-weight: 500; transition: color .15s; padding-bottom: 2px; }
    .nav-links a:hover { color: #1a5c1a; }
    .nav-links a.active { border-bottom: 2px solid #374151; }
    .nav-icons { display: flex; align-items: center; gap: 16px; }
    .nav-icons a { color: #374151; font-size: 0.9rem; text-decoration: none; transition: color .15s; position: relative; }
    .nav-icons a:hover { color: #1a5c1a; }
    .cart-badge { position: absolute; top: -6px; right: -7px; background: #1a5c1a; color: #fff; font-size: 0.5rem; font-weight: 700; width: 14px; height: 14px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }

  </style>
</head>

<body>
<!-- ════════ NAVBAR ════════ -->
<nav class="navbar">
  <a href="/" class="nav-logo">
    <img src="/images/leafora logo.png" alt="Leafora" onerror="this.style.display='none'" />
    <span>Leafora</span>
  </a>
 <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-gray-600">
        <a href="/"          class="hover:text-leaf-700 transition-colors">Home</a>
        <a href="/productlist" class="hover:text-leaf-700 transition-colors"  >products</a>
        <a href="/about"  class="hover:text-leaf-700 transition-colors">About</a>
        <a href="/contact"     class="hover:text-leaf-700 transition-colors">Contact</a>
      </nav>
     <div class="nav-icons" style="display:flex;align-items:center">
    <a href="/profile" title="Account"><i class="fa-regular fa-user"></i></a>
    <a href="/wishlist" title="Wishlist"><i class="fa-regular fa-heart"></i></a>
    <a href="/cart" title="Cart" style="position:relative">
      <i class="fa-solid fa-bag-shopping"></i>
      <span id="cartBadge" class="cart-badge" style="<%= (typeof cartCount !== 'undefined' && cartCount > 0) ? 'display:flex;' : 'display:none;' %>"><%= (typeof cartCount !== 'undefined') ? cartCount : 0 %></span>
    </a>
  </div>
</nav>

<!-- PAGE TITLE -->
<div class="max-w-6xl mx-auto px-6 pt-6 pb-2">
  <h1 class="text-base font-semibold text-gray-800">Manage Addresses</h1>
</div>

<main class="max-w-6xl mx-auto px-6 pb-10">
  <div class="bg-white rounded-xl border border-gray-200 p-5">

    <!-- ADD BUTTON -->
    <div class="flex justify-between mb-4">
      <p class="text-sm font-semibold">Saved Addresses</p>

     <!-- <a href="/addresses/add"
   style="display:inline-block; background:#185c18; color:white; padding:8px 12px; border-radius:6px;">
   Add New Address
</a> -->
<a href="/add-address" class="btn">
  Add New Address
</a>



    </div>

    <!-- FLASH -->
    <% if (success && success.length > 0) { %>
      <p class="text-green-600"><%= success[0] %></p>
    <% } %>

    <% if (error && error.length > 0) { %>
      <p class="text-red-600"><%= error[0] %></p>
    <% } %>

    <!-- ================== DYNAMIC ================== -->
    <% if (addresses && addresses.length > 0) { %>

      <% addresses.forEach(function(addr) { %>

        <div class="addr-card">
          <div class="flex justify-between">

            <!-- LEFT -->
            <div>
              <div>
                <strong><%= addr.label %></strong>

                <% if (addr.isDefault) { %>
                  <span class="default-badge">Default</span>
                <% } %>
              </div>

              <div class="addr-line">
                <p><%= addr.name %></p>
                <p><%= addr.street %></p>

                <% if (addr.line2) { %>
                  <p><%= addr.line2 %></p>
                <% } %>

                <p><%= addr.city %>, <%= addr.state %> <%= addr.zip %></p>
                <p><%= addr.country %></p>
                <p><%= addr.phone %></p>
              </div>
            </div>

            <!-- RIGHT -->
            <div class="flex flex-col gap-2 text-right">

              <!-- EDIT -->
              <a href="/addresses/<%= addr._id %>/edit" class="btn-edit">
                Edit
              </a>

              <!-- DELETE -->
              <form action="/addresses/<%= addr._id %>/delete" method="POST">
                <button type="submit" class="btn-del">
                  Delete
                </button>
              </form>

              <!-- DEFAULT -->
              <% if (!addr.isDefault) { %>
                <form action="/addresses/<%= addr._id %>/default" method="POST">
                  <button class="btn-setdef">Set Default</button>
                </form>
              <% } %>

            </div>

          </div>
        </div>

        
      <% }); %>
      <div class="flex justify-center mt-8">

  <div class="flex items-center gap-1">

    <% if(currentPage > 1){ %>
      <a href="?page=<%= currentPage-1 %>"
         class="w-9 h-9 flex items-center justify-center rounded-lg border bg-white hover:bg-gray-50">
        <i class="fa-solid fa-chevron-left"></i>
      </a>
    <% } %>

    <% for(let i=1;i<=totalPages;i++){ %>

      <a href="?page=<%= i %>"
         class="w-9 h-9 flex items-center justify-center rounded-lg border
         <%= currentPage === i
           ? 'bg-[#185c18] text-white border-[#185c18]'
           : 'bg-white text-gray-700 hover:bg-gray-50' %>">

         <%= i %>

      </a>

    <% } %>

    <% if(currentPage < totalPages){ %>
      <a href="?page=<%= currentPage+1 %>"
         class="w-9 h-9 flex items-center justify-center rounded-lg border bg-white hover:bg-gray-50">
        <i class="fa-solid fa-chevron-right"></i>
      </a>
    <% } %>

  </div>

</div>
      

    <!-- ================== FALLBACK ================== -->
    <% } else { %>

      <div class="addr-card">
        <p>No addresses found</p>
      </div>

    <% } %>

  </div>
</main>

</body>
</html>