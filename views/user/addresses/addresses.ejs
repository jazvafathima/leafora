<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Leafora - Manage Addresses</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            leaf: { 50:'#f0faf0', 600:'#1f7a1f', 700:'#185c18', 800:'#124512', 900:'#0b2f0b' },
            cream: '#f5f2eb',
          },
          fontFamily: { display:['"Playfair Display"','serif'], body:['Poppins','sans-serif'] },
        },
      },
    };
  </script>
  <style>
    body { font-family:'Poppins',sans-serif; background:#f5f2eb; }
    .addr-card { background:#fff; border:1px solid #e5e7eb; border-radius:12px; padding:18px 20px; margin-bottom:12px; }
    .default-badge { background:#185c18; color:#fff; font-size:0.6rem; font-weight:700; padding:2px 8px; border-radius:999px; letter-spacing:0.04em; margin-left:8px; }
    .btn-edit   { font-size:0.72rem; color:#185c18; font-weight:600; display:flex; align-items:center; gap:4px; background:none; border:none; cursor:pointer; padding:0; }
    .btn-edit:hover { text-decoration:underline; }
    .btn-del    { font-size:0.72rem; color:#dc2626; font-weight:600; display:flex; align-items:center; gap:4px; background:none; border:none; cursor:pointer; padding:0; }
    .btn-del:hover  { text-decoration:underline; }
    .btn-setdef { font-size:0.7rem; border:1px solid #d1d5db; border-radius:6px; padding:4px 10px; color:#374151; font-weight:500; cursor:pointer; background:#fff; transition:all 0.2s; }
    .btn-setdef:hover { border-color:#185c18; color:#185c18; }
    .addr-line { font-size:0.75rem; color:#6b7280; line-height:1.65; }
  </style>
</head>
<body class="min-h-screen bg-cream">

  <%# NAVBAR %>
  <header class="bg-white border-b border-gray-100 sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-6 py-3 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2">
        <%# IMAGE SLOT: Logo — /images/leafora-logo.png — 130x36px %>
        <img src="/images/leafora-logo.png" alt="Leafora" class="h-8 w-auto" />
        <span class="font-display text-lg font-bold text-leaf-900">Leafora</span>
      </a>
      <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-gray-600">
        <a href="/"         class="hover:text-leaf-700 transition-colors">Home</a>
        <a href="/shop"     class="text-leaf-700 font-semibold border-b-2 border-leaf-600 pb-0.5">Shop</a>
        <a href="/products" class="hover:text-leaf-700 transition-colors">Products</a>
        <a href="/pages"    class="hover:text-leaf-700 transition-colors">Pages</a>
      </nav>
      <div class="flex items-center gap-3 text-gray-500">
        <button class="hover:text-leaf-700 p-1"><i class="fa-solid fa-magnifying-glass text-sm"></i></button>
        <button class="hover:text-leaf-700 p-1"><i class="fa-regular fa-user text-sm"></i></button>
        <button class="hover:text-leaf-700 p-1"><i class="fa-regular fa-heart text-sm"></i></button>
        <button class="hover:text-leaf-700 p-1 relative">
          <i class="fa-solid fa-basket-shopping text-sm"></i>
          <span class="absolute -top-1 -right-1 bg-leaf-600 text-white text-[8px] w-3.5 h-3.5 rounded-full flex items-center justify-center font-bold">2</span>
        </button>
      </div>
    </div>
  </header>

  <%# PAGE TITLE %>
  <div class="max-w-6xl mx-auto px-6 pt-6 pb-2">
    <h1 class="text-base font-semibold text-gray-800">Manage Addresses</h1>
    <p class="text-xs text-gray-400 mt-0.5">View and manage your saved shipping addresses</p>
  </div>

  <%# MAIN %>
  <main class="max-w-6xl mx-auto px-6 pb-10">
    <div class="bg-white rounded-xl border border-gray-200 p-5">

      <%# Top row %>
      <div class="flex items-center justify-between mb-4">
        <p class="text-sm font-semibold text-gray-700">Saved Addresses</p>
        <a href="/user/addresses/add"
          class="bg-leaf-700 hover:bg-leaf-800 text-white text-xs font-semibold px-4 py-2 rounded-lg transition-colors flex items-center gap-1.5">
          <i class="fa-solid fa-plus text-xs"></i> Add New Address
        </a>
      </div>

      <%# Flash messages %>
      <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
        <div class="bg-green-50 border border-green-200 text-green-700 text-xs rounded-lg px-4 py-2.5 mb-4 flex items-center gap-2">
          <i class="fa-solid fa-circle-check"></i> <%= success[0] %>
        </div>
      <% } %>
      <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <div class="bg-red-50 border border-red-200 text-red-700 text-xs rounded-lg px-4 py-2.5 mb-4 flex items-center gap-2">
          <i class="fa-solid fa-circle-exclamation"></i> <%= error[0] %>
        </div>
      <% } %>

      <%# Address cards — dynamic from DB, falls back to static demo %>
      <% if (typeof addresses !== 'undefined' && addresses && addresses.length > 0) { %>

        <% addresses.forEach(function(addr) { %>
          <div class="addr-card">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1">
                <div class="flex items-center mb-1.5">
                  <span class="text-sm font-semibold text-gray-800"><%= addr.label %></span>
                  <% if (addr.isDefault) { %>
                    <span class="default-badge">Default Address</span>
                  <% } %>
                </div>
                <div class="addr-line">
                  <p><%= addr.name %></p>
                  <p><%= addr.street %></p>
                  <% if (addr.line2) { %><p><%= addr.line2 %></p><% } %>
                  <p><%= addr.city %>, <%= addr.state %> <%= addr.zip %></p>
                  <p><%= addr.country %></p>
                  <p class="mt-1 flex items-center gap-1.5">
                    <i class="fa-solid fa-phone" style="font-size:9px;color:#9ca3af"></i>
                    <%= addr.phone %>
                  </p>
                </div>
              </div>
              <div class="flex flex-col items-end gap-2 flex-shrink-0">
             <a href="/user/addresses/<%= addr._id %>/edit" class="btn-edit">
                  <i class="fa-regular fa-pen-to-square text-xs"></i> Edit
                </a>
              <form action="/user/addresses/<%= addr._id %>/delete" method="POST">
  <button type="submit" class="btn-del">
    <i class="fa-solid fa-trash text-xs"></i> Delete
  </button>
</form>
                <% if (!addr.isDefault) { %>
                  <form action="/user/addresses/<%= addr._id %>/default" method="POST" style="margin:0">
                    <button type="submit" class="btn-setdef">Set as Default</button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>

      <% } else { %>
        <%# Static fallback matching screenshot %>

        <div class="addr-card">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1">
              <div class="flex items-center mb-1.5">
                <span class="text-sm font-semibold text-gray-800">Home Address</span>
                <span class="default-badge">Default Address</span>
              </div>
              <div class="addr-line">
                <p>Michael Anderson</p>
                <p>123 Main Street</p>
                <p>Apartment 4B</p>
                <p>New York, NY 10001</p>
                <p>United States</p>
                <p class="mt-1 flex items-center gap-1.5">
                  <i class="fa-solid fa-phone" style="font-size:9px;color:#9ca3af"></i>
                  +1 (555) 123-4567
                </p>
              </div>
            </div>
            <div class="flex flex-col items-end gap-2">
              <a href="/user/addresses/<%= addr._id %>/edit" class="btn-edit"><i class="fa-regular fa-pen-to-square text-xs"></i> Edit</a>
              <a href="/user/addresses/1/delete" class="btn-del"><i class="fa-solid fa-trash text-xs"></i> Delete</a>
            </div>
          </div>
        </div>

        <div class="addr-card">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1">
              <div class="flex items-center mb-1.5">
                <span class="text-sm font-semibold text-gray-800">Work Address</span>
              </div>
              <div class="addr-line">
                <p>Michael Anderson</p>
                <p>456 Business Avenue</p>
                <p>Suite 200</p>
                <p>New York, NY 10005</p>
                <p>United States</p>
                <p class="mt-1 flex items-center gap-1.5">
                  <i class="fa-solid fa-phone" style="font-size:9px;color:#9ca3af"></i>
                  +1 (555) 987-6543
                </p>
              </div>
            </div>
            <div class="flex flex-col items-end gap-2">
              <a href="/user/addresses/<%= addr._id %>/edit" class="btn-edit"><i class="fa-regular fa-pen-to-square text-xs"></i> Edit</a>
              <a href="/user/addresses/2/delete" class="btn-del"><i class="fa-solid fa-trash text-xs"></i> Delete</a>
              <button class="btn-setdef">Set as Default</button>
            </div>
          </div>
        </div>

        <div class="addr-card">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1">
              <div class="flex items-center mb-1.5">
                <span class="text-sm font-semibold text-gray-800">Other</span>
              </div>
              <div class="addr-line">
                <p>John Anderson</p>
                <p>789 Oak Street</p>
                <p>Los Angeles, CA 90001</p>
                <p>United States</p>
                <p class="mt-1 flex items-center gap-1.5">
                  <i class="fa-solid fa-phone" style="font-size:9px;color:#9ca3af"></i>
                  +1 (555) 456-7890
                </p>
              </div>
            </div>
            <div class="flex flex-col items-end gap-2">
              <a href="/user/addresses/<%= addr._id %>/edit" class="btn-edit"><<i class="fa-regular fa-pen-to-square text-xs"></i> Edit</a>
              <a href="/user/addresses/3/delete" class="btn-del"><i class="fa-solid fa-trash text-xs"></i> Delete</a>
              <button class="btn-setdef">Set as Default</button>
            </div>
          </div>
        </div>

      <% } %>
    </div>
  </main>

  <%# FOOTER %>
  <footer class="bg-leaf-900 text-white">
    <div class="max-w-6xl mx-auto px-6 pt-10 pb-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-8">
        <div>
          <h4 class="font-display text-base font-semibold mb-3">Leafora</h4>
          <p class="text-gray-400 text-xs mb-3">Download the Leafora App Now</p>
          <%# IMAGE SLOT: QR code — /images/qr-code.png — 88x88px %>
          <div class="bg-white rounded-xl p-1.5 inline-flex items-center justify-center w-24 h-24 mb-3">
            <i class="fa-solid fa-qrcode text-gray-400 text-4xl"></i>
          </div>
          <div class="flex flex-col gap-1.5">
            <a href="#" class="inline-flex items-center gap-1.5 bg-gray-800 hover:bg-gray-700 text-white text-[10px] px-3 py-1.5 rounded-lg font-medium w-max">
              <i class="fa-brands fa-google-play text-xs"></i> Play Store
            </a>
            <a href="#" class="inline-flex items-center gap-1.5 bg-gray-800 hover:bg-gray-700 text-white text-[10px] px-3 py-1.5 rounded-lg font-medium w-max">
              <i class="fa-brands fa-apple text-xs"></i> App Store
            </a>
          </div>
        </div>
        <div>
          <h4 class="font-semibold text-xs mb-3 uppercase tracking-wide">Helpful Links</h4>
          <ul class="space-y-2 text-gray-400 text-xs">
            <li><a href="#" class="hover:text-white">Plant Care Guide</a></li>
            <li><a href="#" class="hover:text-white">Shipping Policy</a></li>
            <li><a href="#" class="hover:text-white">Returns &amp; Refunds</a></li>
            <li><a href="#" class="hover:text-white">Track Order</a></li>
            <li><a href="#" class="hover:text-white">Locate Stores</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-semibold text-xs mb-3 uppercase tracking-wide">Information</h4>
          <ul class="space-y-2 text-gray-400 text-xs">
            <li><a href="#" class="hover:text-white">Plant Blog</a></li>
            <li><a href="#" class="hover:text-white">Plant Care Tips</a></li>
            <li><a href="#" class="hover:text-white">FAQs</a></li>
            <li><a href="#" class="hover:text-white">About Us</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-semibold text-xs mb-3 uppercase tracking-wide">Contact Us</h4>
          <ul class="space-y-2 text-gray-400 text-xs">
            <li class="flex items-center gap-2"><i class="fa-solid fa-phone text-gray-500" style="font-size:9px"></i> +91 9000000000</li>
            <li class="flex items-start gap-2"><i class="fa-solid fa-envelope text-gray-500 mt-0.5" style="font-size:9px"></i> support@leafora.com</li>
            <li class="flex gap-3 mt-2">
              <a href="#" class="text-gray-400 hover:text-white text-base"><i class="fa-brands fa-whatsapp"></i></a>
              <a href="#" class="text-gray-400 hover:text-white text-base"><i class="fa-brands fa-telegram"></i></a>
              <a href="#" class="text-gray-400 hover:text-white text-base"><i class="fa-regular fa-comment-dots"></i></a>
            </li>
          </ul>
        </div>
      </div>
      <div class="border-t border-leaf-800 pt-5">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 mb-4">
          <div class="flex items-center gap-2">
            <span class="text-[10px] text-gray-400 mr-1">Social</span>
            <a href="#" class="text-gray-400 hover:text-white"><i class="fa-brands fa-instagram text-sm"></i></a>
            <a href="#" class="text-gray-400 hover:text-white"><i class="fa-brands fa-x-twitter text-sm"></i></a>
            <a href="#" class="text-gray-400 hover:text-white"><i class="fa-brands fa-facebook text-sm"></i></a>
            <a href="#" class="text-gray-400 hover:text-white"><i class="fa-brands fa-youtube text-sm"></i></a>
          </div>
          <div class="flex gap-1.5 opacity-60">
            <i class="fa-brands fa-cc-visa text-gray-300 text-lg"></i>
            <i class="fa-brands fa-cc-mastercard text-gray-300 text-lg"></i>
            <i class="fa-brands fa-cc-paypal text-gray-300 text-lg"></i>
            <i class="fa-brands fa-cc-amex text-gray-300 text-lg"></i>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row items-center justify-between gap-2 text-[10px] text-gray-500">
          <p>&copy; 2026 Leafora - All Rights Reserved.</p>
          <div class="flex gap-4">
            <a href="#" class="hover:text-white">Terms &amp; Conditions</a>
            <a href="#" class="hover:text-white">Privacy Policy</a>
            <a href="#" class="hover:text-white">Disclaimer</a>
          </div>
        </div>
        <p class="text-center text-xs text-gray-600 mt-3 font-display italic">Grow Green, Live Fresh &#127807;</p>
      </div>
    </div>
  </footer>

</body>
</html>
