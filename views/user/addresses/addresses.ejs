<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Leafora - Manage Addresses</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

  <style>
    body { font-family:'Poppins',sans-serif; background:#f5f2eb; }
    .addr-card { background:#fff; border:1px solid #e5e7eb; border-radius:12px; padding:18px 20px; margin-bottom:12px; }
    .default-badge { background:#185c18; color:#fff; font-size:0.6rem; font-weight:700; padding:2px 8px; border-radius:999px; margin-left:8px; }
    .btn-edit   { font-size:0.72rem; color:#185c18; font-weight:600; cursor:pointer; }
    .btn-del    { font-size:0.72rem; color:#dc2626; font-weight:600; cursor:pointer; }
    .btn-setdef { font-size:0.7rem; border:1px solid #d1d5db; border-radius:6px; padding:4px 10px; }
    .addr-line { font-size:0.75rem; color:#6b7280; line-height:1.6; }
  </style>
</head>

<body>

<!-- PAGE TITLE -->
<div class="max-w-6xl mx-auto px-6 pt-6 pb-2">
  <h1 class="text-base font-semibold text-gray-800">Manage Addresses</h1>
</div>

<main class="max-w-6xl mx-auto px-6 pb-10">
  <div class="bg-white rounded-xl border border-gray-200 p-5">

    <!-- ADD BUTTON -->
    <div class="flex justify-between mb-4">
      <p class="text-sm font-semibold">Saved Addresses</p>

     <!-- <a href="/addresses/add"
   style="display:inline-block; background:#185c18; color:white; padding:8px 12px; border-radius:6px;">
   Add New Address
</a> -->
<a href="/add-address" class="btn">
  Add New Address
</a>



    </div>

    <!-- FLASH -->
    <% if (success && success.length > 0) { %>
      <p class="text-green-600"><%= success[0] %></p>
    <% } %>

    <% if (error && error.length > 0) { %>
      <p class="text-red-600"><%= error[0] %></p>
    <% } %>

    <!-- ================== DYNAMIC ================== -->
    <% if (addresses && addresses.length > 0) { %>

      <% addresses.forEach(function(addr) { %>

        <div class="addr-card">
          <div class="flex justify-between">

            <!-- LEFT -->
            <div>
              <div>
                <strong><%= addr.label %></strong>

                <% if (addr.isDefault) { %>
                  <span class="default-badge">Default</span>
                <% } %>
              </div>

              <div class="addr-line">
                <p><%= addr.name %></p>
                <p><%= addr.street %></p>

                <% if (addr.line2) { %>
                  <p><%= addr.line2 %></p>
                <% } %>

                <p><%= addr.city %>, <%= addr.state %> <%= addr.zip %></p>
                <p><%= addr.country %></p>
                <p><%= addr.phone %></p>
              </div>
            </div>

            <!-- RIGHT -->
            <div class="flex flex-col gap-2 text-right">

              <!-- EDIT -->
              <a href="/addresses/<%= addr._id %>/edit" class="btn-edit">
                Edit
              </a>

              <!-- DELETE -->
              <form action="/addresses/<%= addr._id %>/delete" method="POST">
                <button type="submit" class="btn-del">
                  Delete
                </button>
              </form>

              <!-- DEFAULT -->
              <% if (!addr.isDefault) { %>
                <form action="/addresses/<%= addr._id %>/default" method="POST">
                  <button class="btn-setdef">Set Default</button>
                </form>
              <% } %>

            </div>

          </div>
        </div>

      <% }); %>

    <!-- ================== FALLBACK ================== -->
    <% } else { %>

      <div class="addr-card">
        <p>No addresses found</p>
      </div>

    <% } %>

  </div>
</main>

</body>
</html>