<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Favorites - Leafora</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            leaf:  { 50:'#f0faf0',100:'#dcf5dc',600:'#1f7a1f',700:'#185c18',800:'#124512' },
            cream: '#f5f0e8',
          },
          fontFamily: {
            display: ['"Playfair Display"','serif'],
            body:    ['Poppins','sans-serif'],
          },
        },
      },
    };
  </script>

  <style>
    * { box-sizing: border-box; }
    body { font-family: 'Poppins', sans-serif; background: #f5f0e8; margin: 0; }

    /* ── Navbar ── */
    .navbar { background: #f5f0e8; padding: 0 40px; display: flex; align-items: center; justify-content: space-between; height: 58px; border-bottom: 1px solid #e8e2d8; position: sticky; top: 0; z-index: 100; }
    .nav-logo { display: flex; align-items: center; gap: 6px; text-decoration: none; }
    .nav-logo img { height: 34px; }
    .nav-logo span { font-family: 'Playfair Display', serif; font-size: 1.15rem; font-weight: 700; color: #1a5c1a; }
    .nav-links { display: flex; align-items: center; gap: 28px; }
    .nav-links a { font-size: 0.8rem; color: #374151; text-decoration: none; font-weight: 500; transition: color .15s; padding-bottom: 2px; }
    .nav-links a:hover { color: #1a5c1a; }
    .nav-links a.active { color: #374151; font-weight: 600; border-bottom: 2px solid #374151; }
    .nav-icons { display: flex; align-items: center; gap: 16px; }
    .nav-icons a { color: #374151; font-size: 0.9rem; text-decoration: none; transition: color .15s; position: relative; }
    .nav-icons a:hover { color: #1a5c1a; }
    .cart-badge { position: absolute; top: -6px; right: -7px; background: #1a5c1a; color: #fff; font-size: 0.5rem; font-weight: 700; width: 14px; height: 14px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .wishlist-badge { position: absolute; top: -6px; right: -7px; background: #ef4444; color: #fff; font-size: 0.5rem; font-weight: 700; width: 14px; height: 14px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }

    /* ── Wishlist card ── */
    .wish-card { background: #fff; border-radius: 14px; border: 1px solid #f0ece4; padding: 18px 22px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; gap: 16px; transition: box-shadow .2s; }
    .wish-card:hover { box-shadow: 0 4px 18px rgba(0,0,0,.07); }

    /* ── Product image slot ── */
    .prod-img { width: 72px; height: 72px; border-radius: 10px; overflow: hidden; background: #e8ede8; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .prod-img img { width: 100%; height: 100%; object-fit: cover; }

    /* ── Badges ── */
    .badge-out { background: #fee2e2; color: #991b1b; font-size: 0.58rem; font-weight: 700; padding: 2px 8px; border-radius: 999px; display: inline-block; }

    /* ── Toast ── */
    .toast { position: fixed; top: 1rem; right: 1rem; z-index: 9999; display: flex; align-items: center; gap: 10px; padding: 12px 18px; border-radius: 10px; font-size: 0.82rem; font-weight: 500; box-shadow: 0 4px 20px rgba(0,0,0,.12); animation: slideIn .3s ease; }
    @keyframes slideIn { from { transform: translateX(120%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

    /* ── Highlight ── */
    .highlight { display: flex; flex-direction: column; align-items: center; gap: 5px; text-align: center; }
    .highlight i { font-size: 1.3rem; color: #1a5c1a; }
    .highlight p { font-size: 0.67rem; color: #374151; font-weight: 500; max-width: 80px; line-height: 1.3; }
  </style>
</head>

<body class="min-h-screen">

<!-- ════════ FLASH TOASTS ════════ -->
<% if (typeof success !== 'undefined' && success && success.length > 0) { %>
  <div class="toast bg-green-50 border border-green-200 text-green-700" id="flashToast">
    <i class="fa-solid fa-circle-check"></i> <%= success[0] %>
  </div>
<% } %>
<% if (typeof error !== 'undefined' && error && error.length > 0) { %>
  <div class="toast bg-red-50 border border-red-200 text-red-700" id="flashToast">
    <i class="fa-solid fa-circle-exclamation"></i> <%= error[0] %>
  </div>
<% } %>

<!-- ════════ NAVBAR ════════ -->
<nav class="navbar">
  <a href="/" class="nav-logo">
    <img src="/images/leafora logo.png" alt="Leafora" onerror="this.style.display='none'" />
    <span>Leafora</span>
  </a>
   <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-gray-600">
        <a href="/"          class="hover:text-leaf-700 transition-colors">Home</a>
        <a href="/productlist" class="hover:text-leaf-700 transition-colors"  >products</a>
        <a href="/about"  class="hover:text-leaf-700 transition-colors">About</a>
        <a href="/contact"     class="hover:text-leaf-700 transition-colors">Contact</a>
      </nav>

     <div class="nav-icons" style="display:flex;align-items:center">
    <a href="/profile" title="Account"><i class="fa-regular fa-user"></i></a>
<a href="/wishlist" title="Wishlist" style="position:relative">
  <i class="fa-regular fa-heart"></i>
  <span class="wishlist-badge" style="<% if (typeof wishlistCount !== 'undefined' && wishlistCount > 0) { %>display:flex;<% } else { %>display:none;<% } %>"><%= wishlistCount || 0 %></span>
</a>
    <a href="/cart" title="Cart" style="position:relative">
      <i class="fa-solid fa-bag-shopping"></i>
      <span id="cartBadge" class="cart-badge" style="<%= (typeof cartCount !== 'undefined' && cartCount > 0) ? 'display:flex;' : 'display:none;' %>"><%= (typeof cartCount !== 'undefined') ? cartCount : 0 %></span>
    </a>
  </div>
</nav>

<!-- ════════ MAIN CONTENT ════════ -->
<div class="max-w-3xl mx-auto px-4 py-8">

  <!-- Page heading -->
  <h1 class="font-display text-2xl font-bold text-[#1a5c1a] mb-1">Favorites</h1>
  <p class="text-xs text-gray-400 mb-6">
    <% const total = typeof wishlistItems !== 'undefined' && wishlistItems ? wishlistItems.length : 0; %>
    <%= total %> item<%= total !== 1 ? 's' : '' %> saved for later
  </p>

  <% if (typeof wishlistItems !== 'undefined' && wishlistItems && wishlistItems.length > 0) { %>

    <div id="wishlistContainer">
      <% wishlistItems.forEach(function(item) {
          

const product = item.product || item;
const variant = item.variant || (product.variants && product.variants[0]) || null;

const stock = Number(
  variant?.stockQuantity ??
  product?.stockQuantity ??
  0
);

const isOut = stock === 0;


const isBlocked =
  product.isBlocked ||
  product.status === 'inactive' ||
  product.status === 'blocked';

           const price     = variant ? (variant.discountPrice || variant.price || 0) : (product.price || 0);
           const origPrice = variant && variant.discountPrice && variant.price ? variant.price : null;

           // Format date added
           let dateStr = '';
           if (item.addedAt || item.createdAt) {
             const d = new Date(item.addedAt || item.createdAt);
             dateStr = d.toLocaleDateString('en-IN', { day:'numeric', month:'long', year:'numeric' });
           }
      %>

      <div class="wish-card" id="wish-<%= product._id %>"
           style="<%= (isBlocked || isOut) ? 'opacity:.65' : '' %>">

        <!-- Left: date + image + info -->
        <div class="flex items-center gap-4 flex-1 min-w-0">

          <!-- Product image slot -->
<a href="<%= isBlocked ? '#' : '/product/' + product._id %>" class="prod-img flex-shrink-0">
  <% if (variant && variant.images && variant.images.length > 0) { %>
    <img
      src="/uploads/products/<%= variant.images[0] %>"
      alt="<%= product.name %>"
    />
  <% } else { %>
    <i class="fa-solid fa-seedling text-xl" style="color:#b8d4b8"></i>
  <% } %>
</a>

          <!-- Info -->
          <div class="min-w-0">
            <!-- Date -->
            <% if (dateStr) { %>
              <p class="text-gray-400 mb-0.5" style="font-size:0.65rem"><%= dateStr %></p>
            <% } %>

            <!-- Name -->
            <a href="<%= isBlocked ? '#' : '/products/' + product._id %>"
               class="font-semibold text-[#1a5c1a] text-sm hover:underline leading-tight block mb-0.5 truncate">
             <%- JSON.stringify(product.name) %>
            </a>

            <!-- Variant info -->
            <% if (variant && (variant.size || variant.color)) { %>
              <p class="text-gray-400 text-xs mb-0.5">
                Size: <%= variant.size || variant.color %>
              </p>
            <% } %>

            <!-- Status badges -->
            <% if (isBlocked) { %>
              <span class="badge-out"><i class="fa-solid fa-ban mr-1"></i>Unavailable</span>
            <% } else if (isOut) { %>
              <span class="badge-out"><i class="fa-solid fa-circle-xmark mr-1"></i>Out of Stock</span>
            <% } %>

            <!-- Price -->
            <div class="flex items-center gap-2 mt-1">
              <span class="font-bold text-gray-900 text-sm">₹<%= Number(price).toLocaleString('en-IN') %></span>
              <% if (origPrice && origPrice !== price) { %>
                <span class="text-gray-400 line-through text-xs">₹<%= Number(origPrice).toLocaleString('en-IN') %></span>
              <% } %>
            </div>

            <!-- Remove link -->
            <button
              onclick="removeFromWishlist('<%= product._id %>', this)"
              class="text-red-400 hover:text-red-600 text-xs mt-1.5 flex items-center gap-1 transition-colors">
              <i class="fa-regular fa-trash-can" style="font-size:0.6rem"></i> Remove
            </button>
          </div>
        </div>

        <!-- Right: Order Now button -->
        <div class="flex-shrink-0">
          <% if (isBlocked || isOut) { %>
            <button disabled
              class="bg-gray-200 text-gray-400 text-xs font-semibold px-6 py-2.5 rounded-lg cursor-not-allowed whitespace-nowrap">
              Order Now
            </button>
          <% } else { %>
            <button
  data-product-id="<%= product._id %>"
  data-variant-id="<%= variant ? variant._id : '' %>"
  data-product-name="<%- product.name.replace(/"/g, '&quot;') %>"
  onclick="addToCartFromWishlist(this.dataset.productId, this.dataset.variantId, this.dataset.productName, this)"
  class="bg-[#1a5c1a] hover:bg-[#144d14] text-white text-xs font-semibold px-6 py-2.5 rounded-lg transition-colors whitespace-nowrap">
  Add to cart
</button>
          <% } %>
        </div>

      </div>
      <% }) %>
    </div>

  <% } else { %>

    <!-- ── Empty wishlist ── -->
    <div class="text-center py-20 bg-white rounded-2xl border border-gray-100 shadow-sm">
      <i class="fa-regular fa-heart text-6xl mb-4 block" style="color:#d1e8d1"></i>
      <p class="font-display text-xl font-semibold text-gray-700 mb-2">No favorites yet</p>
      <p class="text-xs text-gray-400 mb-6">Save plants you love to find them easily later</p>
      <a href="/productlist"
         class="inline-flex items-center gap-2 bg-[#1a5c1a] hover:bg-[#144d14] text-white text-sm font-semibold px-6 py-3 rounded-xl transition-colors">
        <i class="fa-solid fa-seedling text-xs"></i> Browse Plants
      </a>
    </div>

  <% } %>

</div>
<!-- /max-w -->

