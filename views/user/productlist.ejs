<script>


// ─────────────────────────────
// ADD TO CART
// ─────────────────────────────
async function addToCart(event, productId, variantId) {
  event.preventDefault();
  event.stopPropagation();

  try {
    const res = await fetch('/cart/add', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ productId, variantId, quantity: 1 })
    });

    const data = await res.json();

    if (res.ok) {
      updateCartCount();          // refresh navbar badge instantly
      // optional: quick visual feedback
      // showToast('Added to cart!');
    } else {
      alert(data.message || 'Could not add to cart');
    }
  } catch (err) {
    console.error('Add to cart failed:', err);
    alert('Something went wrong. Please try again.');
  }
}

// ─────────────────────────────
// TOGGLE WISHLIST
// ─────────────────────────────
async function toggleWishlist(productId, btnEl) {
  try {
    const res = await fetch('/wishlist/toggle', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ productId })
    });

    const data = await res.json(); // expect { inWishlist: true/false }

    if (res.ok) {
      const icon = btnEl.querySelector('i');
      if (data.inWishlist) {
        icon.classList.remove('fa-regular');
        icon.classList.add('fa-solid', 'text-red-500');
      } else {
        icon.classList.remove('fa-solid', 'text-red-500');
        icon.classList.add('fa-regular');
      }
      updateWishlistCount(); // refresh navbar badge instantly
    } else {
      alert(data.message || 'Could not update wishlist');
    }
  } catch (err) {
    console.error('Toggle wishlist failed:', err);
    alert('Something went wrong. Please try again.');
  }
}

async function refreshWishlistCount() {
  console.log("Refreshing wishlist count...");

  const res = await fetch('/wishlist/count');
  const data = await res.json();

  console.log("Count response:", data);

  const badge = document.getElementById('wishlistCount');

  if (!badge) return;

  badge.textContent = data.count;

  if (data.count > 0) {
    badge.classList.remove('hidden');
  } else {
    badge.classList.add('hidden');
  }
}

   
function showToast(message, type = 'success') {
  const toast = document.getElementById('toast');
  if (!toast) return;
  toast.textContent = message;
  // Reset classes
  toast.className = 'fixed bottom-5 left-1/2 -translate-x-1/2 px-4 py-2 rounded-lg shadow-lg z-50';
  // Set background based on type
  let bg = '';
  if (type === 'success') bg = '#38a169'; // green-600
  else if (type === 'error') bg = '#e53e3e'; // red-600
  else if (type === 'info') bg = '#3182ce'; // blue-600
  else bg = '#38a169';
  toast.style.background = bg;
  toast.style.color = '#fff';
  toast.classList.remove('hidden');
  setTimeout(() => { toast.classList.add('hidden'); }, 3000);
}
</script>
<script>
async function addToCart(event, productId, variantId) {
  event.preventDefault();
  event.stopPropagation();

  try {
    const res = await fetch('/cart/add', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        productId,
           variantId,
        quantity: 1
      
      })
    });

    const data = await res.json();

    if (data.success) {
      Swal.fire({
        toast: true,
        position: 'top-end',
        icon: 'success',
        title: 'Added to cart',
        showConfirmButton: false,
        timer: 1500
      });
