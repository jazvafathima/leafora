<script>
  /* ── Clear search ── */
  function clearSearch() {
    const form  = document.getElementById('searchForm');
    const input = document.getElementById('searchInput');
    input.value = '';
    document.getElementById('hiddenSearch').value = '';
    form.submit();
  }

  /* ── Clear individual filter ── */
  function clearFilter(type) {
    const params = new URLSearchParams(window.location.search);
    if (type === 'category') params.delete('category');
    if (type === 'search')   params.delete('search');
    if (type === 'price')    { params.delete('minPrice'); params.delete('maxPrice'); }
    params.set('page', '1');
    window.location.href = '/productlist?' + params.toString();
  }

  /* ── FAQ accordion ── */
  function toggleFaq(idx) {
    const ans  = document.getElementById('faqA-'    + idx);
    const icon = document.getElementById('faqIcon-' + idx);
    const open = ans.classList.contains('open');
    // close all
    document.querySelectorAll('.faq-a').forEach(a => a.classList.remove('open'));
    document.querySelectorAll('[id^=faqIcon-]').forEach(i => i.style.transform = '');
    if (!open) {
      ans.classList.add('open');
      icon.style.transform = 'rotate(180deg)';
    }
  }

  /* ── Debounced search ── */
  const searchInput = document.getElementById('searchInput');
  let _st;
  if (searchInput) {
    searchInput.addEventListener('input', function() {
      clearTimeout(_st);
      _st = setTimeout(() => {
        if (this.value.length === 0 || this.value.length >= 2) {
          document.getElementById('searchForm').submit();
        }
      }, 500);
    });
  }
</script>
