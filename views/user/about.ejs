<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Leafora | About Us</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            leaf: {
              50:  "#eefaf1",
              100: "#d6f2dd",
              600: "#1f8a4c",
              700: "#166534",
              800: "#14532d",
              900: "#0f3d22",
            },
            cream: "#faf3e5",
          },
        },
      },
    };
  </script>

  <style>
    body { font-family: "Segoe UI", ui-sans-serif, system-ui, sans-serif; }
  </style>
</head>

<body class="bg-slate-50 text-slate-800">

  <!-- ============ HEADER ============ -->
  <header class="bg-cream">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <div class="flex items-center gap-2">
        <i class="fa-solid fa-leaf text-leaf-700 text-xl"></i>
        <span class="text-xl font-bold text-leaf-800">Leafora</span>
      </div>

      <nav class="hidden md:flex items-center gap-8 text-sm text-slate-700">
        <% const navItems = locals.navItems || [
          { label: "Home",     href: "/" },
          { label: "Shop",     href: "/shop" },
          { label: "Products", href: "/products" },
          { label: "About",    href: "/about", active: true },
        ]; %>
        <% navItems.forEach(function(item) { %>
          <a href="<%= item.href %>"
             class="pb-1 transition <%= item.active
                ? 'font-medium text-slate-900 border-b-2 border-leaf-700'
                : 'text-slate-600 hover:text-slate-900' %>">
            <%= item.label %>
          </a>
        <% }); %>
      </nav>

      <div class="flex items-center gap-5 text-slate-700">
        <i class="fa-solid fa-magnifying-glass"></i>
        <i class="fa-regular fa-circle-user"></i>
        <i class="fa-solid fa-bag-shopping"></i>
      </div>
    </div>
  </header>

  <!-- ============ HERO ============ -->
  <section class="bg-leaf-800 text-white text-center py-16 px-4">
    <h1 class="text-3xl font-bold">Our Story, Rooted in Green</h1>
    <p class="mt-3 max-w-xl mx-auto text-sm text-leaf-100">
      Leafora started with a simple idea — bring more life, calm, and greenery
      into every home. Here's a bit about who we are and why we do this.
    </p>
  </section>

  <!-- ============ MAIN ============ -->
  <main class="max-w-6xl mx-auto px-4 py-16 space-y-20">

    <!-- Our Story -->
    <section class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      <!-- empty story image placeholder, fixed size -->
      <div class="h-72 w-full rounded-xl bg-gradient-to-b from-slate-200 to-slate-300 flex items-center justify-center overflow-hidden">
        <% if (locals.storyImageUrl) { %>
          <img src="<%= storyImageUrl %>" alt="Leafora team at work" class="h-full w-full object-cover" />
        <% } else { %>
          <div class="text-center text-slate-500">
            <i class="fa-regular fa-image text-4xl"></i>
            <p class="mt-2 text-xs">Story Image</p>
          </div>
        <% } %>
      </div>

      <div>
        <p class="text-xs font-semibold tracking-wider text-leaf-700 uppercase">Since <%= locals.founded || 2019 %></p>
        <h2 class="mt-2 text-2xl font-bold text-slate-800">How Leafora Began</h2>
        <p class="mt-4 text-sm leading-relaxed text-slate-500">
          <%= locals.storyText || `Leafora was founded by a small group of plant lovers who
          wanted city living to feel a little less concrete and a lot more green.
          What began as a single stall at a weekend market has grown into a
          trusted online destination for plants, planters, and everything in
          between — all backed by real care advice and reliable delivery.` %>
        </p>
        <p class="mt-4 text-sm leading-relaxed text-slate-500">
          Today we work with growers and artisans across the country to bring
          healthy, sustainably-sourced plants straight to your door, along with
          the tools and tips you need to help them thrive.
        </p>
      </div>
    </section>

    <!-- Mission & Values -->
    <section>
      <div class="text-center max-w-xl mx-auto">
        <h2 class="text-2xl font-bold text-slate-800">What We Stand For</h2>
        <p class="mt-3 text-sm text-slate-500">
          Everything we do is guided by a few simple principles.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <%
          const values = locals.values || [
            { icon: "fa-seedling",  title: "Sustainably Grown", text: "Every plant is sourced from growers who share our commitment to the environment." },
            { icon: "fa-truck-fast",title: "Reliable Delivery",  text: "Carefully packaged and shipped so your plants arrive healthy, every time." },
            { icon: "fa-hand-holding-heart", title: "Real Plant Care", text: "Our team offers genuine advice to help your plants — and your space — flourish." },
            { icon: "fa-users",     title: "Community First",   text: "We support local growers, small makers, and green initiatives in every city we serve." },
          ];
        %>
        <% values.forEach(function(v) { %>
          <div class="rounded-xl bg-white p-6 text-center shadow-sm">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-leaf-100 text-leaf-800">
              <i class="fa-solid <%= v.icon %>"></i>
            </div>
            <h3 class="mt-4 font-semibold text-slate-800 text-sm"><%= v.title %></h3>
            <p class="mt-2 text-xs leading-relaxed text-slate-500"><%= v.text %></p>
          </div>
        <% }); %>
      </div>
    </section>

    <!-- Stats -->
    <section class="rounded-2xl bg-leaf-800 px-6 py-12">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center text-white">
        <%
          const stats = locals.aboutStats || [
            { value: "50K+", label: "Happy Customers" },
            { value: "1,200+", label: "Plant Varieties" },
            { value: "35+", label: "Cities Served" },
            { value: "6", label: "Years of Growth" },
          ];
        %>
        <% stats.forEach(function(s) { %>
          <div>
            <p class="text-2xl sm:text-3xl font-bold"><%= s.value %></p>
            <p class="mt-1 text-xs text-leaf-100"><%= s.label %></p>
          </div>
        <% }); %>
      </div>
    </section>

    <!-- Team -->
    
    <!-- CTA -->
    <section class="text-center rounded-2xl border border-slate-200 bg-white px-6 py-14">
      <h2 class="text-xl font-bold text-slate-800">Ready to Bring Some Green Home?</h2>
      <p class="mt-2 text-sm text-slate-500">
        Explore our collection and find the perfect plant for your space.
      </p>
      <a href="/productlist"
         class="mt-6 inline-flex items-center gap-2 rounded-lg bg-leaf-800 px-6 py-3 text-sm font-medium text-white hover:bg-leaf-900 transition">
        <i class="fa-solid fa-bag-shopping"></i>
        Shop Now
      </a>
    </section>

  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="bg-leaf-900 text-slate-300">
    <div class="mx-auto max-w-6xl px-6 py-14">
      <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">

        <!-- App download / QR -->
        <div>
          <div class="flex items-center gap-2 mb-5">
            <i class="fa-solid fa-leaf text-leaf-100 text-xl"></i>
            <span class="text-2xl font-bold text-white">Leafora</span>
          </div>
          <p class="text-sm font-medium text-slate-200 mb-3">Download the Leafora App Now</p>

          <!-- empty QR code placeholder, fixed size -->
          <div class="h-28 w-28 rounded-lg bg-white p-1.5 flex items-center justify-center">
            <% if (locals.qrCodeUrl) { %>
              <img src="<%= qrCodeUrl %>" alt="Download app QR code" class="h-full w-full object-contain" />
            <% } else { %>
              <i class="fa-solid fa-qrcode text-slate-800 text-5xl"></i>
            <% } %>
          </div>

          <div class="mt-4 flex flex-col gap-2">
            <a href="#" class="flex items-center gap-2 rounded-md border border-slate-600 px-3 py-1.5 w-fit">
              <i class="fa-brands fa-google-play"></i>
              <span class="text-[11px] leading-tight">
                <span class="block text-slate-400">GET IT ON</span>
                <span class="block font-medium text-white">Google Play</span>
              </span>
            </a>
            <a href="#" class="flex items-center gap-2 rounded-md border border-slate-600 px-3 py-1.5 w-fit">
              <i class="fa-brands fa-apple"></i>
              <span class="text-[11px] leading-tight">
                <span class="block text-slate-400">Download on the</span>
                <span class="block font-medium text-white">App Store</span>
              </span>
            </a>
          </div>
        </div>

        <!-- Helpful Links -->
        <div>
          <h4 class="font-semibold text-white mb-4">Helpful Links</h4>
          <ul class="space-y-2 text-sm">
            <% (locals.helpfulLinks || [
              "Plant Care Guide", "Shipping Policy", "Returns & Refunds",
              "Track Order", "Locate Stores"
            ]).forEach(function(link) { %>
              <li><a href="#" class="hover:text-white transition"><%= link %></a></li>
            <% }); %>
          </ul>
        </div>

        <!-- Information -->
        <div>
          <h4 class="font-semibold text-white mb-4">Information</h4>
          <ul class="space-y-2 text-sm">
            <% (locals.infoLinks || [
              "Plant Blog", "Plant Care Tips", "FAQs", "About Us"
            ]).forEach(function(link) { %>
              <li><a href="#" class="hover:text-white transition"><%= link %></a></li>
            <% }); %>
          </ul>
        </div>

        <!-- Contact Us -->
        <div>
          <h4 class="font-semibold text-white mb-4">Contact Us</h4>
          <ul class="space-y-2 text-sm">
            <li><%= locals.phone || "+91 9090000000" %></li>
            <li>Email Us: <%= locals.email || "support@leafora.com" %></li>
          </ul>
          <div class="mt-4 flex items-center gap-3">
            <i class="fa-brands fa-whatsapp"></i>
            <i class="fa-regular fa-paper-plane"></i>
            <i class="fa-solid fa-magnifying-glass"></i>
          </div>

          <h4 class="font-semibold text-white mt-6 mb-3">Social</h4>
          <div class="flex items-center gap-3">
            <i class="fa-brands fa-facebook-f"></i>
            <i class="fa-brands fa-x-twitter"></i>
            <i class="fa-brands fa-pinterest-p"></i>
            <i class="fa-brands fa-instagram"></i>
          </div>
          <div class="mt-3 flex items-center gap-3">
            <i class="fa-regular fa-envelope"></i>
            <i class="fa-solid fa-comment"></i>
            <i class="fa-brands fa-youtube"></i>
            <i class="fa-brands fa-tiktok"></i>
            <i class="fa-brands fa-linkedin-in"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10">
      <div class="mx-auto max-w-6xl px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-slate-400">
        <span>© <%= locals.year || 2026 %> Leafora - All Rights Reserved.</span>
        <div class="flex items-center gap-4">
          <a href="#" class="hover:text-white">Terms &amp; Conditions</a>
          <a href="#" class="hover:text-white">Privacy Policy</a>
          <a href="#" class="hover:text-white">Disclaimer</a>
        </div>
        <span class="flex items-center gap-1">Grow Green, Live Fresh <i class="fa-solid fa-leaf text-leaf-100"></i></span>
      </div>
    </div>
  </footer>
<div id="pageLoader" class="hidden">
    <div class="loader"></div>
</div>

<script src="/js/globalLoader.js"></script>
</body>
</html>
