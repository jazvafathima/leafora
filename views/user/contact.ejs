<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Leafora | Get in Touch With Us</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            leaf: {
              50:  "#eefaf1",
              100: "#d6f2dd",
              600: "#1f8a4c",
              700: "#166534",
              800: "#14532d",
              900: "#0f3d22",
            },
          },
        },
      },
    };
  </script>

  <style>
    body { font-family: "Segoe UI", ui-sans-serif, system-ui, sans-serif; }
  </style>
</head>

<body class="bg-slate-50 text-slate-800">

  <!-- ============ HERO ============ -->
  <section class="bg-leaf-800 text-white text-center py-16 px-4">
    <h1 class="text-3xl font-bold">Get in Touch With Us</h1>
    <p class="mt-3 text-sm text-leaf-100">
      We're here to help with your orders, products, and support queries.
    </p>
  </section>

  <!-- ============ MAIN ============ -->
  <main class="max-w-5xl mx-auto px-4 py-12">

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- Contact form -->
      <div class="lg:col-span-2 rounded-xl bg-white p-6 shadow-sm">
        <h2 class="font-bold text-slate-800">Send Us a Message</h2>
        <p class="mt-1 text-xs text-slate-400">
          Fill out the form below and we'll get back to you as soon as possible.
        </p>
        <% if (locals.error) { %>
  <div class="mb-4 rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-600">
    <%= error %>
  </div>
<% } %>

        <form action="<%= locals.formAction || '#' %>" method="POST" class="mt-6 space-y-4 text-sm">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Full Name</label>
              <input type="text" name="fullName" placeholder="John Doe"
                     class="w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-leaf-700/30" />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Email Address</label>
              <input type="email" name="email" placeholder="john@example.com"
                     class="w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-leaf-700/30" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Phone Number</label>
              <input type="tel" name="phone" placeholder="+1 (000) 000-0000"
                     class="w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-leaf-700/30" />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Subject</label>
              <select name="subject"
                      class="w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm text-slate-500 focus:outline-none focus:ring-2 focus:ring-leaf-700/30">
                <option>Select a subject</option>
                <option>Order Issue</option>
                <option>Product Question</option>
                <option>Support Request</option>
                <option>Other</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">Message</label>
            <textarea name="message" rows="4" placeholder="Tell us how we can help you..."
                      class="w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-leaf-700/30"></textarea>
          </div>

          <button type="submit"
                  class="flex w-full items-center justify-center gap-2 rounded-lg bg-leaf-800 px-5 py-3 text-sm font-medium text-white hover:bg-leaf-900 transition">
            <i class="fa-regular fa-paper-plane"></i>
            Send Message
          </button>
        </form>
      </div>

      <!-- Info cards -->
      <div class="space-y-4">
        <%
          const infoCards = locals.infoCards || [
            {
              icon: "fa-location-dot",
              title: "Address",
              lines: ["123 Commerce Street", "New York, NY 10001", "United States"],
            },
            {
              icon: "fa-envelope",
              title: "Support Email",
              lines: ["support@leaforamail.com"],
            },
            {
              icon: "fa-phone",
              title: "Phone Number",
              lines: ["+1 (555) 123-4567", "Toll-free 1-800-445BLE"],
            },
            {
              icon: "fa-clock",
              title: "Support Hours",
              lines: ["Monday - Friday: 8am - 8pm EST", "Saturday: 9am - 6pm EST", "Sunday: Closed"],
            },
          ];
        %>
        <% infoCards.forEach(function(card) { %>
          <div class="flex gap-3 rounded-xl bg-white p-4 shadow-sm">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-leaf-800 text-white">
              <i class="fa-solid <%= card.icon %> text-sm"></i>
            </div>
            <div class="text-sm">
              <p class="font-semibold text-slate-800"><%= card.title %></p>
              <% card.lines.forEach(function(line) { %>
                <p class="text-slate-500 text-xs mt-0.5"><%= line %></p>
              <% }); %>
            </div>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- Visit our store / map -->
    <div class="mt-12 text-center">
      <h3 class="font-bold text-slate-800 mb-4">Visit Our Store</h3>

      <!-- empty map placeholder, fixed height -->
      <div class="mx-auto h-64 w-full rounded-xl bg-gradient-to-b from-slate-200 to-slate-300 flex items-center justify-center overflow-hidden">
        <% if (locals.mapImageUrl) { %>
          <img src="<%= mapImageUrl %>" alt="Store location map" class="h-full w-full object-cover" />
        <% } else { %>
          <div class="text-center">
            <i class="fa-solid fa-map-location-dot text-leaf-800 text-3xl"></i>
            <p class="mt-2 text-sm font-medium text-slate-700">Map View</p>
            <p class="text-xs text-slate-500"><%= locals.storeAddress || "123 Commerce Street, New York, NY 10001" %></p>
          </div>
        <% } %>
      </div>
    </div>
  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="bg-leaf-900 text-slate-300">
    <div class="mx-auto max-w-6xl px-6 py-14">
      <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">

        <!-- App download / QR -->
        <div>
          <div class="flex items-center gap-2 mb-5">
            <i class="fa-solid fa-leaf text-leaf-100 text-xl"></i>
            <span class="text-2xl font-bold text-white">Leafora</span>
          </div>
          <p class="text-sm font-medium text-slate-200 mb-3">Download the Leafora App Now</p>

          <!-- empty QR code placeholder, fixed size -->
          <div class="h-28 w-28 rounded-lg bg-white p-1.5 flex items-center justify-center">
            <% if (locals.qrCodeUrl) { %>
              <img src="<%= qrCodeUrl %>" alt="Download app QR code" class="h-full w-full object-contain" />
            <% } else { %>
              <i class="fa-solid fa-qrcode text-slate-800 text-5xl"></i>
            <% } %>
          </div>

          <div class="mt-4 flex flex-col gap-2">
            <a href="#" class="flex items-center gap-2 rounded-md border border-slate-600 px-3 py-1.5 w-fit">
              <i class="fa-brands fa-google-play"></i>
              <span class="text-[11px] leading-tight">
                <span class="block text-slate-400">GET IT ON</span>
                <span class="block font-medium text-white">Google Play</span>
              </span>
            </a>
            <a href="#" class="flex items-center gap-2 rounded-md border border-slate-600 px-3 py-1.5 w-fit">
              <i class="fa-brands fa-apple"></i>
              <span class="text-[11px] leading-tight">
                <span class="block text-slate-400">Download on the</span>
                <span class="block font-medium text-white">App Store</span>
              </span>
            </a>
          </div>
        </div>

        <!-- Helpful Links -->
        <div>
          <h4 class="font-semibold text-white mb-4">Helpful Links</h4>
          <ul class="space-y-2 text-sm">
            <% (locals.helpfulLinks || [
              "Plant Care Guide", "Shipping Policy", "Returns & Refunds",
              "Track Order", "Locate Stores"
            ]).forEach(function(link) { %>
              <li><a href="#" class="hover:text-white transition"><%= link %></a></li>
            <% }); %>
          </ul>
        </div>

        <!-- Information -->
        <div>
          <h4 class="font-semibold text-white mb-4">Information</h4>
          <ul class="space-y-2 text-sm">
            <% (locals.infoLinks || [
              "Plant Blog", "Plant Care Tips", "FAQs", "About Us"
            ]).forEach(function(link) { %>
              <li><a href="#" class="hover:text-white transition"><%= link %></a></li>
            <% }); %>
          </ul>
        </div>

        <!-- Contact Us -->
        <div>
          <h4 class="font-semibold text-white mb-4">Contact Us</h4>
          <ul class="space-y-2 text-sm">
            <li><%= locals.phone || "+91 9090000000" %></li>
            <li>Email Us: <%= locals.email || "support@leafora.com" %></li>
          </ul>
          <div class="mt-4 flex items-center gap-3">
            <i class="fa-brands fa-whatsapp"></i>
            <i class="fa-regular fa-paper-plane"></i>
            <i class="fa-solid fa-magnifying-glass"></i>
          </div>

          <h4 class="font-semibold text-white mt-6 mb-3">Social</h4>
          <div class="flex items-center gap-3">
            <i class="fa-brands fa-facebook-f"></i>
            <i class="fa-brands fa-x-twitter"></i>
            <i class="fa-brands fa-pinterest-p"></i>
            <i class="fa-brands fa-instagram"></i>
          </div>
          <div class="mt-3 flex items-center gap-3">
            <i class="fa-regular fa-envelope"></i>
            <i class="fa-solid fa-comment"></i>
            <i class="fa-brands fa-youtube"></i>
            <i class="fa-brands fa-tiktok"></i>
            <i class="fa-brands fa-linkedin-in"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10">
      <div class="mx-auto max-w-6xl px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-slate-400">
        <span>© <%= locals.year || 2026 %> Leafora - All Rights Reserved.</span>
        <div class="flex items-center gap-4">
          <a href="#" class="hover:text-white">Terms &amp; Conditions</a>
          <a href="#" class="hover:text-white">Privacy Policy</a>
          <a href="#" class="hover:text-white">Disclaimer</a>
        </div>
        <span class="flex items-center gap-1">Grow Green, Live Fresh <i class="fa-solid fa-leaf text-leaf-100"></i></span>
      </div>
    </div>
  </footer>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
<script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

  <script>
   const success = <%- JSON.stringify(success || []) %>;
const error = <%- JSON.stringify(error || []) %>;


    if (success.length > 0) {
        Toastify({
            text: success[0],
            duration: 3000,
            gravity: "top",
            position: "right",
            style: {
                background: "#16a34a"
            }
        }).showToast();
    }

    if (error.length > 0) {
        Toastify({
            text: error[0],
            duration: 3000,
            gravity: "top",
            position: "right",
            style: {
                background: "#dc2626"
            }
        }).showToast();
    }
</script>


</body>
</html>
