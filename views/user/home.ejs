<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Leafora - Bring Nature Into Your Home</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            leaf: {
              50:  '#f0faf0',
              100: '#dcf5dc',
              200: '#b8eab8',
              300: '#7dd67d',
              400: '#4cba4c',
              500: '#2e9e2e',
              600: '#1f7a1f',
              700: '#185c18',
              800: '#124512',
              900: '#0b2f0b',
            },
            cream: '#faf7f2',
            bark:  '#5c3d1e',
          },
          fontFamily: {
            display: ['"Playfair Display"', 'serif'],
            body:    ['Poppins', 'sans-serif'],
          },
        },
      },
    };
  </script>

  <style>
    body { font-family: 'Poppins', sans-serif; }
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .offer-badge {
      background: #ff6b35; color: white;
      font-size: 0.65rem; font-weight: 700;
      padding: 2px 8px; border-radius: 999px;
      letter-spacing: 0.04em;
    }
    .add-to-cart-btn {
      background: #2e9e2e; color: white;
      font-size: 0.7rem; font-weight: 600;
      letter-spacing: 0.05em; text-transform: uppercase;
      border: none; cursor: pointer; transition: background 0.2s;
    }
    .add-to-cart-btn:hover { background: #185c18; }
    .wishlist-btn {
      border: 1.5px solid #2e9e2e; color: #2e9e2e;
      font-size: 0.7rem; font-weight: 600;
      letter-spacing: 0.05em; text-transform: uppercase;
      cursor: pointer; transition: all 0.2s; background: white;
    }
    .wishlist-btn:hover { background: #f0faf0; }
    .section-title {
      font-family: 'Playfair Display', serif; color: #185c18;
      letter-spacing: 0.08em; text-transform: uppercase;
      font-size: 0.8rem; font-weight: 600;
    }
    /* All img-box containers fill their parent; images fill the box */
    .img-box { position: relative; overflow: hidden; }
    .img-box img {
      width: 100%; height: 100%;
      object-fit: cover; display: block;
    }
  </style>
</head>

<body class="bg-cream text-gray-800">

  <!-- ═══════════════════════════════════════════════════════════════════════
       TOP ANNOUNCEMENT BAR
  ════════════════════════════════════════════════════════════════════════ -->
  <div class="bg-leaf-700 text-white text-center text-xs py-1.5 tracking-wide">
    🌿 Free shipping on orders above ₹599 &nbsp;|&nbsp; Use code <strong>NATURE10</strong> for 10% off
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       NAVBAR
  ════════════════════════════════════════════════════════════════════════ -->
  <header class="bg-cream   shadow-sm sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-4">

      <!-- ── LOGO IMAGE ──────────────────────────────────────────────────
           Replace src with your logo path.
           Recommended size: any height, keep aspect ratio, h-8 = 32px tall
      ─────────────────────────────────────────────────────────────────── -->
      <a href="/" class="flex items-center gap-2 flex-shrink-0">
        <img src="\images\leafora logo.png " alt="Leafora Logo" class="h-16 w-24" />
        <a text-green>Leafora</a>
      </a>

      <!-- Search Bar -->
      <div class="flex-1 max-w-lg hidden md:flex items-center border border-gray-200 rounded-full px-4 py-2 gap-2 bg-gray-50 hover:bg-white transition-colors">
        <i class="fa-solid fa-magnifying-glass text-gray-400 text-sm"></i>
        <input type="text" placeholder="Search for plants, pots, seeds..."
          class="flex-1 bg-transparent text-sm outline-none text-gray-700 placeholder-gray-400" />
      </div>

      <!-- Nav Icons -->
      <div class="flex items-center gap-4 text-leaf-700">
        <a href="/user/profile" class="hidden md:flex flex-col items-center gap-0.5 hover:text-leaf-500 transition-colors">
          <i class="fa-regular fa-user text-base"></i>
          <span class="text-[10px] text-gray-500">Account</span>
        </a>
        <a href="#" class="hidden md:flex flex-col items-center gap-0.5 hover:text-leaf-500 transition-colors">
          <i class="fa-regular fa-heart text-base"></i>
          <span class="text-[10px] text-gray-500">Wishlist</span>
        </a>
        <a href="#" class="flex flex-col items-center gap-0.5 relative hover:text-leaf-500 transition-colors">
          <i class="fa-solid fa-cart-shopping text-base"></i>
          <span class="absolute -top-1 -right-2 bg-orange-500 text-white text-[9px] w-4 h-4 rounded-full flex items-center justify-center font-bold">3</span>
          <span class="text-[10px] text-gray-500">Cart</span>
        </a>
        <button class="md:hidden text-gray-600"><i class="fa-solid fa-bars text-lg"></i></button>
      </div>
    </div>

    <!-- Category Nav -->
    <nav class="border-t border-gray-100 bg-white">
      <div class="max-w-7xl mx-auto px-4">
        <ul class="flex items-center gap-6 overflow-x-auto scrollbar-hide py-2 text-sm font-medium text-gray-600">
          <% const categories = ['Home','Indoor Plants','Outdoor Plants','Succulents','Air Purifiers','Pots & Planters','Seeds','Fertilizers','Tools','Gift Sets']; %>
          <% categories.forEach((cat, i) => { %>
            <li class="flex-shrink-0">
              <a href="#" class="<%= i===0 ? 'text-leaf-600 font-semibold border-b-2 border-leaf-500 pb-1' : 'hover:text-leaf-600 transition-colors' %>">
                <%= cat %>
              </a>
            </li>
          <% }) %>
        </ul>
      </div>
    </nav>
  </header>

  <!-- ═══════════════════════════════════════════════════════════════════════
       HERO BANNER  (3-column layout)
  ════════════════════════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-0">

      <!-- Left column: 2 stacked banner images -->
      <div class="hidden md:flex flex-col">

        <!-- ── IMAGE SLOT ① — Hero Left Top ─────────────────────────────
             File: /images/hero-left-top.jpg   |   Size: 480 × 160 px
        ─────────────────────────────────────────────────────────────── -->
        <div class="img-box h-40 w-full">
          <img src="/images/hero-left-top.jpg" alt="Outdoor Plants" />
        </div>

        <!-- ── IMAGE SLOT ② — Hero Left Bottom ──────────────────────────
             File: /images/hero-left-bottom.jpg   |   Size: 480 × 160 px
        ─────────────────────────────────────────────────────────────── -->
        <div class="img-box h-40 w-full">
          <img src="/images/hero-left-bottom.jpg" alt="Indoor Plants" />
        </div>

      </div>

      <!-- Center: hero text over a background image -->
      <div class="relative bg-gradient-to-br from-leaf-50 to-leaf-100 flex flex-col items-center justify-center text-center px-6 py-16 md:py-20 min-h-[320px]">

        <!-- ── IMAGE SLOT ③ — Hero Centre Background ─────────────────────
             File: /images/hero-bg.jpg   |   Size: 640 × 320 px
             Kept at low opacity so text stays readable
        ─────────────────────────────────────────────────────────────── -->
        <div class="img-box absolute inset-0">
          <img src="/images/hero-bg.jpg" alt="" class="opacity-20" />
        </div>

        <div class="relative z-10">
          <p class="text-leaf-600 text-xs font-semibold tracking-widest uppercase mb-2">Welcome to Leafora</p>
          <h1 class="font-display text-4xl md:text-5xl font-bold text-leaf-900 leading-tight mb-3">
            Bring Nature<br/>Into Your Home
          </h1>
          <p class="text-gray-600 text-sm mb-6 max-w-xs mx-auto">
            Explore our curated collection of indoor & outdoor plants for every space and budget.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="#" class="bg-leaf-600 text-white px-6 py-2.5 rounded-full text-sm font-semibold hover:bg-leaf-700 transition-colors shadow-md">Shop Now</a>
            <a href="#" class="border-2 border-leaf-600 text-leaf-700 px-6 py-2.5 rounded-full text-sm font-semibold hover:bg-leaf-50 transition-colors">Explore Plants</a>
          </div>
        </div>
      </div>

      <!-- Right column: 2 stacked banner images -->
      <div class="hidden md:flex flex-col">

        <!-- ── IMAGE SLOT ④ — Hero Right Top ────────────────────────────
             File: /images/hero-right-top.jpg   |   Size: 480 × 160 px
        ─────────────────────────────────────────────────────────────── -->
        <div class="img-box h-40 w-full">
          <img src="/images/hero-right-top.jpg" alt="Succulents" />
        </div>

        <!-- ── IMAGE SLOT ⑤ — Hero Right Bottom ─────────────────────────
             File: /images/hero-right-bottom.jpg   |   Size: 480 × 160 px
        ─────────────────────────────────────────────────────────────── -->
        <div class="img-box h-40 w-full">
          <img src="/images/hero-right-bottom.jpg" alt="Air Purifiers" />
        </div>

      </div>
    </div>

    <!-- Category thumbnail strip -->
    <div class="bg-white border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-4 py-4">
        <div class="flex items-center gap-4 overflow-x-auto scrollbar-hide">
          <%
            const catThumb = [
              {name:'Cactus',    img:'/images/cat-cactus.jpg'},
              {name:'Ferns',     img:'/images/cat-ferns.jpg'},
              {name:'Flowering', img:'/images/cat-flowering.jpg'},
              {name:'Bonsai',    img:'/images/cat-bonsai.jpg'},
              {name:'Herbs',     img:'/images/cat-herbs.jpg'},
              {name:'Palms',     img:'/images/cat-palms.jpg'},
              {name:'Creepers',  img:'/images/cat-creepers.jpg'},
            ];
          %>
          <% catThumb.forEach(c => { %>
            <!-- ── IMAGE SLOT — Category Circle ────────────────────────────
                 File: <%= c.img %>   |   Size: 64 × 64 px (square, shown as circle)
            ──────────────────────────────────────────────────────────── -->
            <div class="flex flex-col items-center gap-1.5 flex-shrink-0 cursor-pointer group">
              <div class="img-box w-16 h-16 rounded-full border-2 border-leaf-200 group-hover:border-leaf-500 transition-colors">
                <img src="<%= c.img %>" alt="<%= c.name %>" class="rounded-full" />
              </div>
              <span class="text-[11px] text-gray-600 font-medium"><%= c.name %></span>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       OFFER BANNERS ROW (4 cards)
  ════════════════════════════════════════════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-4 py-6 grid grid-cols-2 md:grid-cols-4 gap-3">
    <%
      const offers = [
        {label:'Combos',              tag:'Get 4 at ₹499', img:'/images/offer-combos.jpg',      color:'bg-green-50',  border:'border-green-200'},
        {label:'Cactus & Succulents', tag:'upto 40% off',  img:'/images/offer-cactus.jpg',      color:'bg-yellow-50', border:'border-yellow-200'},
        {label:'Air Purifiers',       tag:'upto 35% off',  img:'/images/offer-airpurifier.jpg', color:'bg-blue-50',   border:'border-blue-200'},
        {label:'Seasonal Plants',     tag:'New Arrivals',   img:'/images/offer-seasonal.jpg',   color:'bg-pink-50',   border:'border-pink-200'},
      ];
    %>
    <% offers.forEach(o => { %>
      <div class="<%= o.color %> border <%= o.border %> rounded-xl overflow-hidden flex flex-col cursor-pointer hover:shadow-md transition-shadow">

        <!-- ── IMAGE SLOT — Offer Banner ────────────────────────────────
             File: <%= o.img %>   |   Size: 300 × 112 px
        ─────────────────────────────────────────────────────────────── -->
        <div class="img-box h-28 w-full">
          <img src="<%= o.img %>" alt="<%= o.label %>" />
        </div>

        <div class="p-3">
          <p class="text-xs font-semibold text-gray-700"><%= o.label %></p>
          <span class="offer-badge mt-1 inline-block"><%= o.tag %></span>
        </div>
      </div>
    <% }) %>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       BRAND STORY SECTION
  ════════════════════════════════════════════════════════════════════════ -->
  <section class="bg-leaf-900 text-white overflow-hidden">
    <div class="grid grid-cols-1 md:grid-cols-2">

      <!-- ── IMAGE SLOT ⑥ — Brand Hero (left half) ─────────────────────
           File: /images/brand-hero.jpg   |   Size: 720 × 340 px
           The man with sunglasses / "Bindass grow karega" photo
      ─────────────────────────────────────────────────────────────── -->
      <div class="img-box min-h-[340px]">
        <img src="/images/brand-hero.jpg" alt="Bindass grow karega" />
      </div>

      <!-- Right: text + 2×2 story grid -->
      <div class="flex flex-col">
        <div class="p-8 flex flex-col justify-center flex-1">
          <p class="text-leaf-300 text-xs tracking-widest uppercase font-semibold mb-2">Our Promise</p>
          <h2 class="font-display text-3xl md:text-4xl font-bold leading-snug mb-4">
            Grown by skilled<br/><span class="text-leaf-400">women farmers.</span>
          </h2>
          <p class="text-gray-300 text-sm leading-relaxed mb-6">
            Every plant at Leafora is ethically sourced from women-led farms across India.
            We ensure fair wages, sustainable practices, and the freshest plants to your doorstep.
          </p>
          <a href="#" class="inline-flex items-center gap-2 bg-leaf-500 hover:bg-leaf-400 text-white px-5 py-2.5 rounded-full text-sm font-semibold transition-colors w-max">
            <i class="fa-solid fa-arrow-right"></i> Our Story
          </a>
        </div>

        <!-- 2 × 2 story image grid -->
        <div class="grid grid-cols-2">
          <%
            const storyImgs = [
              {label:'Farm Visit',               img:'/images/story-farm.jpg'},
              {label:'Pure, homemade & Organic', img:'/images/story-organic.jpg'},
              {label:'Expert for your plants',   img:'/images/story-expert.jpg'},
              {label:'Sustainable Fields',       img:'/images/story-fields.jpg'},
            ];
          %>
          <% storyImgs.forEach(s => { %>
            <!-- ── IMAGE SLOT — Story Grid Tile ──────────────────────────
                 File: <%= s.img %>   |   Size: 360 × 144 px
            ──────────────────────────────────────────────────────────── -->
            <div class="relative img-box h-36 border border-leaf-800">
              <img src="<%= s.img %>" alt="<%= s.label %>" class="brightness-50" />
              <span class="absolute bottom-2 left-2 right-2 text-white text-[11px] font-semibold leading-tight z-10"><%= s.label %></span>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       PLANTS GRID — "A Plant for Every Space"
  ════════════════════════════════════════════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-4 py-10">
    <div class="text-center mb-8">
      <p class="section-title mb-1">★ A PLANT FOR EVERY SPACE ★</p>
      <h2 class="font-display text-2xl md:text-3xl font-bold text-leaf-800 mt-1">Featured Plants</h2>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
      <%
        const plants = [
          {name:'Areca Palm',         price:'₹799',   oldPrice:'₹999',   tag:'Best Seller', img:'/images/plant-areca-palm.jpg'},
          {name:'Bird of Paradise',   price:'₹1,799', oldPrice:'₹2,200', tag:'Trending',    img:'/images/plant-bird-of-paradise.jpg'},
          {name:'Monstera Deliciosa', price:'₹799',   oldPrice:'₹1,100', tag:'Popular',     img:'/images/plant-monstera.jpg'},
          {name:'Peace Lily',         price:'₹249',   oldPrice:'₹399',   tag:'Sale',        img:'/images/plant-peace-lily.jpg'},
          {name:'Snake Plant',        price:'₹349',   oldPrice:'₹499',   tag:'Air Purifier',img:'/images/plant-snake-plant.jpg'},
        ];
      %>
      <% plants.forEach(p => { %>
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow group border border-gray-100">

          <!-- ── IMAGE SLOT — Plant Card ──────────────────────────────────
               File: <%= p.img %>   |   Size: 300 × 176 px
               Zoom-on-hover is applied automatically via group-hover
          ──────────────────────────────────────────────────────────── -->
          <div class="relative img-box h-44 w-full group-hover:scale-105 transition-transform duration-300">
            <img src="<%= p.img %>" alt="<%= p.name %>" />
            <span class="absolute top-2 left-2 bg-leaf-600 text-white text-[10px] font-bold px-2 py-0.5 rounded-full z-10"><%= p.tag %></span>
            <button class="absolute top-2 right-2 bg-white rounded-full w-7 h-7 flex items-center justify-center shadow text-gray-400 hover:text-red-500 transition-colors z-10">
              <i class="fa-regular fa-heart text-xs"></i>
            </button>
          </div>

          <div class="p-3">
            <h3 class="text-sm font-semibold text-gray-800 mb-1 truncate"><%= p.name %></h3>
            <div class="flex items-center gap-1 mb-1">
              <% for(let i=0;i<5;i++){ %><i class="fa-solid fa-star text-yellow-400 text-[10px]"></i><% } %>
              <span class="text-[10px] text-gray-400">(128)</span>
            </div>
            <div class="flex items-center gap-1.5 mb-3">
              <span class="text-leaf-700 font-bold text-sm"><%= p.price %></span>
              <span class="text-gray-400 text-xs line-through"><%= p.oldPrice %></span>
            </div>
            <div class="flex gap-1.5">
              <button class="add-to-cart-btn flex-1 py-1.5 rounded-lg text-[11px]">
                <i class="fa-solid fa-cart-plus mr-1"></i> Add
              </button>
              <button class="wishlist-btn px-2 py-1.5 rounded-lg">
                <i class="fa-regular fa-heart text-xs"></i>
              </button>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="text-center mt-8">
      <a href="#" class="inline-flex items-center gap-2 border-2 border-leaf-600 text-leaf-700 px-8 py-2.5 rounded-full text-sm font-semibold hover:bg-leaf-600 hover:text-white transition-all">
        View All Plants <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       POTS & CERAMICS
  ════════════════════════════════════════════════════════════════════════ -->
  <section class="bg-leaf-50 py-10">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-8">
        <p class="section-title mb-1">★ CERAMIC FOR DÉCOR ★</p>
        <h2 class="font-display text-2xl md:text-3xl font-bold text-leaf-800 mt-1">Pots & Planters</h2>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        <%
          const pots = [
            {name:'Terracotta Pot',     price:'₹289',   oldPrice:'₹399',   img:'/images/pot-terracotta.jpg'},
            {name:'Ceramic Blue Pot',   price:'₹1,799', oldPrice:'₹2,499', img:'/images/pot-ceramic-blue.jpg'},
            {name:'Textured Green Pot', price:'₹799',   oldPrice:'₹999',   img:'/images/pot-textured-green.jpg'},
            {name:'Mini Pot Set',       price:'₹193',   oldPrice:'₹299',   img:'/images/pot-mini-set.jpg'},
          ];
        %>
        <% pots.forEach(pot => { %>
          <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-gray-100">

            <!-- ── IMAGE SLOT — Pot Card ──────────────────────────────────
                 File: <%= pot.img %>   |   Size: 300 × 160 px
            ──────────────────────────────────────────────────────────── -->
            <div class="img-box h-40 w-full">
              <img src="<%= pot.img %>" alt="<%= pot.name %>" />
            </div>

            <div class="p-3">
              <h3 class="text-sm font-semibold text-gray-800 mb-1"><%= pot.name %></h3>
              <div class="flex items-center gap-1.5 mb-3">
                <span class="text-leaf-700 font-bold text-sm"><%= pot.price %></span>
                <span class="text-gray-400 text-xs line-through"><%= pot.oldPrice %></span>
              </div>
              <div class="flex gap-1.5">
                <button class="add-to-cart-btn flex-1 py-1.5 rounded-lg text-[11px]">
                  <i class="fa-solid fa-cart-plus mr-1"></i> Add to Cart
                </button>
                <button class="wishlist-btn px-2 py-1.5 rounded-lg">
                  <i class="fa-regular fa-heart text-xs"></i>
                </button>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       TRUST BADGES
  ════════════════════════════════════════════════════════════════════════ -->
  <section class="bg-white py-8 border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <% const badges = [
          {icon:'fa-solid fa-truck-fast',    title:'Free Delivery',   sub:'On orders above ₹599'},
          {icon:'fa-solid fa-shield-halved', title:'Plant Guarantee', sub:'7-day replacement'},
          {icon:'fa-solid fa-leaf',          title:'Organic & Safe',  sub:'No harmful chemicals'},
          {icon:'fa-solid fa-headset',       title:'Expert Support',  sub:'Mon–Sat, 9am–6pm'},
        ]; %>
        <% badges.forEach(b => { %>
          <div class="flex flex-col items-center gap-2">
            <div class="w-12 h-12 rounded-full bg-leaf-50 flex items-center justify-center">
              <i class="<%= b.icon %> text-leaf-600 text-lg"></i>
            </div>
            <p class="font-semibold text-sm text-gray-800"><%= b.title %></p>
            <p class="text-xs text-gray-500"><%= b.sub %></p>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       ABOUT LEAFORA
  ════════════════════════════════════════════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-4 py-12 grid md:grid-cols-2 gap-10 items-center">
    <div>
      <p class="section-title mb-2">★ ABOUT LEAFORA ★</p>
      <h2 class="font-display text-2xl md:text-3xl font-bold text-leaf-800 mb-4">Your Trusted Plant Partner</h2>
      <p class="text-gray-600 text-sm leading-relaxed mb-4">
        Leafora was founded with one mission — to make India greener, one home at a time.
        We partner with over 200 women-led farms across Maharashtra, Kerala, and Karnataka to bring
        you the healthiest, most vibrant plants right to your doorstep.
      </p>
      <p class="text-gray-600 text-sm leading-relaxed mb-6">
        Whether you're a beginner or an expert collector, we have something for every plant lover.
        Our expert team is always here to guide you.
      </p>
      <div class="flex gap-6">
        <div class="text-center">
