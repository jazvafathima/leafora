          {heading:'Support', links:['FAQ','Track Order','Returns','Plant Care','Bulk Orders']},
        ]; %>
        <% footerLinks.forEach(col => { %>
          <div>
            <h4 class="font-semibold text-sm mb-4 text-leaf-300 tracking-wide uppercase"><%= col.heading %></h4>
            <ul class="space-y-2">
              <% col.links.forEach(link => { %>
