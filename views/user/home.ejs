  <style>
    body { font-family: 'Poppins', sans-serif; }
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .offer-badge {
      background: #ff6b35; color: white;
      font-size: 0.65rem; font-weight: 700;
      padding: 2px 8px; border-radius: 999px;
      letter-spacing: 0.04em;
    }
    .add-to-cart-btn {
      background: #2e9e2e; color: white;
      font-size: 0.7rem; font-weight: 600;
      letter-spacing: 0.05em; text-transform: uppercase;
      border: none; cursor: pointer; transition: background 0.2s;
    }
    .add-to-cart-btn:hover { background: #185c18; }
    .wishlist-btn {
      border: 1.5px solid #2e9e2e; color: #2e9e2e;
      font-size: 0.7rem; font-weight: 600;
      letter-spacing: 0.05em; text-transform: uppercase;
      cursor: pointer; transition: all 0.2s; background: white;
    }
    .wishlist-btn:hover { background: #f0faf0; }
    .section-title {
      font-family: 'Playfair Display', serif; color: #185c18;
      letter-spacing: 0.08em; text-transform: uppercase;
      font-size: 0.8rem; font-weight: 600;
    }
    /* All img-box containers fill their parent; images fill the box */
    .img-box { position: relative; overflow: hidden; }
    .img-box img {
      width: 100%; height: 100%;
      object-fit: cover; display: block;
    }

 .nav-logo { display: flex; align-items: center; gap: 6px; text-decoration: none; }
    .nav-logo img { height: 34px; }
    .nav-logo span { font-family: 'Playfair Display', serif; font-size: 1.15rem; font-weight: 700; color: #1a5c1a; }
    .nav-links { display: flex; align-items: center; gap: 28px; }
    .nav-links a { font-size: 0.8rem; color: #374151; text-decoration: none; font-weight: 500; transition: color .15s; padding-bottom: 2px; }
    .nav-links a:hover { color: #1a5c1a; }
    .nav-links a.active { border-bottom: 2px solid #374151; }
    .nav-icons { display: flex; align-items: center; gap: 16px; }
    .nav-icons a { color: #374151; font-size: 0.9rem; text-decoration: none; transition: color .15s; position: relative; }
    .nav-icons a:hover { color: #1a5c1a; }
    .cart-badge { position: absolute; top: -6px; right: -7px; background: #1a5c1a; color: #fff; font-size: 0.5rem; font-weight: 700; width: 14px; height: 14px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }

  </style>
