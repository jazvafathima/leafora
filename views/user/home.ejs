  <!-- ═══════════════════════════════════════════════════════════════════════
       PLANTS GRID — "A Plant for Every Space"
  ════════════════════════════════════════════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-4 py-10">
    <div class="text-center mb-8">
      <p class="section-title mb-1">★ A PLANT FOR EVERY SPACE ★</p>
      <h2 class="font-display text-2xl md:text-3xl font-bold text-leaf-800 mt-1">Featured Plants</h2>
    </div>

   
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">

  <% products.forEach(p => {
    // ProductVariant fields: productId, color, size, sku, price, discountPrice, stock, images, status
    // images[] stores filenames only → full URL = /uploads/products/<filename>
    const mainVariant = p.variants[0]; // already filtered to active variants in controller
   
    const imageFile     = (mainVariant.images && mainVariant.images.length > 0) ? mainVariant.images[0] : null;
    const productImage  = imageFile ? '/uploads/products/' + imageFile : 'https://placehold.co/400x500/2e9e2e/white?text=No+Image';
    const variantSize   = mainVariant.size || '';
    const variantColor  = mainVariant.color || '';
    const inStock       = mainVariant.stockQuantity > 0;
    
  %>
<a href="/product/<%= p._id %>" class="block">
    <div class="relative h-80 rounded-2xl overflow-hidden group shadow-md">

      <!-- Background Image -->
      <img
        src="<%= productImage %>"
        alt="<%= p.name %>"
        class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
      />

      <!-- Dark Overlay -->
      <div class="absolute inset-0 bg-black/35"></div>

      <!-- Badge: Discount % or "New Arrival" -->
<span class="absolute top-3 left-3 text-white text-[10px] font-bold px-2 py-1 rounded-full z-10 <%= p.hasOffer ? 'bg-orange-500' : 'bg-leaf-600' %>">
  <%= p.hasOffer ? p.offerDiscount + '₹ OFF' : 'New Arrival' %>
</span>

      
      <% if (!inStock) { %>
        <div class="absolute inset-0 bg-black/50 flex items-center justify-center z-20">
          <span class="text-white font-bold text-sm tracking-widest uppercase">Out of Stock</span>
        </div>
      <% } %>

     
     <!-- Wishlist -->
             <%
               const _wlIds = typeof wishlistIds !== 'undefined' ? wishlistIds : [];
               const _inWL  = _wlIds.includes(p._id.toString());
             %>
             <button
  type="button"
  onclick="event.preventDefault();event.stopPropagation();toggleWishlist('<%= p._id %>', this)"
  class="absolute top-3 right-3 bg-white/90 rounded-full w-8 h-8 flex items-center justify-center shadow z-10"
>
  <i class="<%= _inWL ? 'fa-solid text-red-500' : 'fa-regular' %> fa-heart text-xs"></i>
</button>
      <!-- Content -->
      <div class="absolute bottom-0 left-0 right-0 p-4 text-white z-10">

        <h3 class="text-lg font-bold mb-0.5"><%= p.name %></h3>

        <% if (variantSize || variantColor) { %>
          <p class="text-[10px] text-gray-300 mb-1">
            <%= [variantSize, variantColor].filter(Boolean).join(' · ') %>
          </p>
        <% } %>

  <div class="flex items-center gap-2 mb-3">

  <% if (p.hasOffer) { %>

    <span class="font-bold text-lg text-white-700">
      ₹<%= p.offerPrice.toLocaleString("en-IN") %>
    </span>

    <span class="text-sm line-through text-gray-400">
      ₹<%= p.originalPrice.toLocaleString("en-IN") %>
    </span>

    <span class="text-sm text-red-600 font-semibold">
      <%= p.offerDiscount %>₹ OFF
    </span>

  <% } else { %>

    <span class="font-bold text-lg">
      ₹<%= p.originalPrice.toLocaleString("en-IN") %>
    </span>

  <% } %>

</div>

        
<button
     type="button"
     onclick="addToCart(event, '<%= p._id %>', '<%= p.variants[0]._id %>')"
     class="w-full bg-white text-leaf-700 py-2 rounded-lg text-sm font-semibold hover:bg-leaf-600 hover:text-white transition"
   >
  <i class="fa-solid fa-cart-plus mr-1"></i>
  ADD TO CART
</button>


      </div>
    </div>

  <% }) %>



</div>
      

    <div class="text-center mt-8">
      <a href="/productlist" class="inline-flex items-center gap-2 border-2 border-leaf-600 text-leaf-700 px-8 py-2.5 rounded-full text-sm font-semibold hover:bg-leaf-600 hover:text-white transition-all">
        View All Plants <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  </section>

  
            
