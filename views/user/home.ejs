  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            leaf: {
              50:  '#f0faf0',
              100: '#dcf5dc',
              200: '#b8eab8',
              300: '#7dd67d',
              400: '#4cba4c',
              500: '#2e9e2e',
              600: '#1f7a1f',
              700: '#185c18',
              800: '#124512',
              900: '#0b2f0b',
            },
            cream: '#faf7f2',
            bark:  '#5c3d1e',
          },
          fontFamily: {
            display: ['"Playfair Display"', 'serif'],
            body:    ['Poppins', 'sans-serif'],
          },
