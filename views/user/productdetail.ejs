<script>
document.getElementById("addToCartForm").addEventListener("submit", async function(e) {
    e.preventDefault(); // Prevent normal form submit

    const data = {
    productId: this.productId.value,
    variantId: document.getElementById('cartVariantId').value,
    quantity: document.getElementById('qtyInput').value
};

    const res = await fetch("/cart/add", {
        method: "POST",
        headers: {
            "Content-Type": "application/json",
            "Accept": "application/json"
        },
        body: JSON.stringify(data)
    });

    const result = await res.json();

    if (result.success) {
        showToast(result.message, "success");
    } else {
        showToast(result.message, "error");
    }
});
</script>
<script>
  /* ── Redirect guard: if product unavailable ── */
  <% if (isUnavailable) { %>
    window.location.replace('/products');
  <% } %>

  /* ── Image zoom on mouse move ── */
  const wrap = document.getElementById('mainImgWrap');
  const mainImg = document.getElementById('mainImg');
  if (wrap && mainImg) {
    wrap.addEventListener('mousemove', function(e) {
      const rect = wrap.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width)  * 100;
      const y = ((e.clientY - rect.top)  / rect.height) * 100;
      mainImg.style.transformOrigin = x + '% ' + y + '%';
    });
    wrap.addEventListener('mouseleave', function() {
      mainImg.style.transformOrigin = '0 0';
    });
  }

  /* ── Thumbnail switch ── */
  function switchImg(el, src) {
    document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
    el.classList.add('active');
    if (mainImg) mainImg.src = src;
  }

  /* ── Size / variant selection ── */
 function selectVariant(btn) {
          console.log("DATASET:", btn.dataset);

    const images = JSON.parse(btn.dataset.images || "[]");

    console.log("IMAGES:", images);

  

   

    document.querySelectorAll('.size-chip')
      .forEach(chip => chip.classList.remove('selected'));

    btn.classList.add('selected');

    const price = btn.dataset.price;
    const discount = btn.dataset.discount;
    const stock = btn.dataset.stock;
    const variantId = btn.dataset.variant;

   

    // Update Price
  const priceEl = document.getElementById('displayPrice');

if (priceEl) {
  console.log("priceEl:", document.getElementById('displayPrice'));
console.log("stockEl:", document.getElementById('stockText'));
    if (discount && Number(discount) > 0) {
        priceEl.textContent =
            '₹' + Number(discount).toLocaleString('en-IN');
    } else {
        priceEl.textContent =
            '₹' + Number(price).toLocaleString('en-IN');
    }
}
    // Update Stock
    const stockEl = document.getElementById('stockText');

    if (stockEl) {
        stockEl.textContent = stock + ' units available';
    }

    // Update Hidden Inputs
    document.getElementById('cartVariantId').value = variantId;
    document.getElementById('buyVariantId').value = variantId;

    // Update Main Image
    if (images.length > 0) {
        document.getElementById('mainImg').src = images[0];
    }

    // Update Thumbnail Gallery
    const thumbContainer =
      document.querySelector('.flex.gap-2.flex-wrap');

    if (thumbContainer && images.length > 0) {

        thumbContainer.innerHTML = '';

        images.forEach((img, index) => {

            thumbContainer.innerHTML += `
                <div class="thumb ${index === 0 ? 'active' : ''}"
                     onclick="switchImg(this,'${img}')">
                    <img src="${img}">
                </div>
            `;
        });
    }
}
  /* ── Quantity ── */
  function changeQty(delta) {
    const inp = document.getElementById('qtyInput');
    if (!inp) return;
    let val = parseInt(inp.value) + delta;
    const max = parseInt(inp.max) || 99;
    val = Math.max(1, Math.min(val, max));
    inp.value = val;
    ['cartQty','buyQty'].forEach(id => {
      const el = document.getElementById(id); if(el) el.value = val;
    });
  }

  /* ── Wishlist toggle ── */
  function toggleWish(btn) {
    const icon = btn.querySelector('i');
    const isSolid = icon.classList.contains('fa-solid');
    icon.classList.toggle('fa-solid',   !isSolid);
    icon.classList.toggle('fa-regular',  isSolid);
    icon.style.color = isSolid ? '' : '#ef4444';

    fetch('/wishlist/toggle', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ productId: '<%= p ? p._id : "" %>' })
    }).catch(() => {});
  }

  /* ── Copy coupon code ── */
  function copyCoupon(code) {
    navigator.clipboard.writeText(code).then(() => {
      showToast('Coupon "' + code + '" copied!', 'success');
    }).catch(() => {});
  }

  /* ── Mini toast ── */
  function showToast(msg, type) {
    const old = document.getElementById('miniToast');
    if (old) old.remove();
    const t = document.createElement('div');
    t.id = 'miniToast';
    t.className = 'toast ' + (type === 'success'
      ? 'bg-green-50 border border-green-200 text-green-700'
      : 'bg-red-50 border border-red-200 text-red-700');
    t.innerHTML = '<i class="fa-solid fa-' + (type==='success'?'circle-check':'circle-exclamation') + '"></i> ' + msg;
    document.body.appendChild(t);
    setTimeout(() => t.remove(), 3000);
  }

  /* ── Auto dismiss flash toast ── */
  const flashToast = document.getElementById('flashToast');
  if (flashToast) setTimeout(() => flashToast.remove(), 5000);
</script>
