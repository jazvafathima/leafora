    <% if (p && p.specifications && p.specifications.length > 0) { %>
      <div class="mt-5 border-t border-gray-100 pt-5">
        <h4 class="text-sm font-semibold text-gray-700 mb-3">Specifications</h4>
        <div class="grid grid-cols-2 gap-2">
          <% p.specifications.forEach(function(spec){ %>
            <div class="flex gap-2 text-xs">
              <span class="text-gray-400 font-medium min-w-24"><%= spec.name %></span>
              <span class="text-gray-700"><%= spec.value %></span>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>

  <!-- ════════════════════════════════════════
       RELATED PRODUCTS
  ════════════════════════════════════════ -->
  <% if (typeof relatedProducts !== 'undefined' && relatedProducts && relatedProducts.length > 0) { %>
    <div class="mt-12 mb-6">
      <h2 class="font-display text-xl font-semibold text-gray-900 mb-5">You May Also Like</h2>
      <div class="flex gap-4 overflow-x-auto no-scrollbar pb-2">
        <% relatedProducts.forEach(function(rp){ %>
          <%
            const rpVar   = rp.variants && rp.variants.length > 0 ? rp.variants[0] : null;
            const rpPrice = rpVar ? (rpVar.price || 0) : (rp.price || 0);
            const rpDisc  = rpVar ? (rpVar.discountPrice || rpVar.discount || null) : null;
          %>
          <a href="/products/<%= rp._id %>" class="related-card" style="text-decoration:none">
            <div class="related-img">
              <% if (rp.images && rp.images.length > 0) { %>
                <img src="<%= rp.images[0] %>" alt="<%= rp.name %>" />
              <% } else { %>
                <i class="fa-solid fa-seedling text-3xl" style="color:#c0d8c0"></i>
              <% } %>
            </div>
            <div class="p-3">
              <p class="text-xs font-semibold text-gray-800 mb-1 leading-tight line-clamp-2"><%= rp.name %></p>
              <div class="flex items-center gap-1.5">
                <% if (rpDisc) { %>
                  <span class="text-xs font-bold text-gray-900">₹<%= Number(rpDisc).toLocaleString('en-IN') %></span>
                  <span class="text-gray-400 line-through" style="font-size:0.65rem">₹<%= Number(rpPrice).toLocaleString('en-IN') %></span>
                <% } else { %>
                  <span class="text-xs font-bold text-gray-900">₹<%= Number(rpPrice).toLocaleString('en-IN') %></span>
                <% } %>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
  <% } %>

</div>
