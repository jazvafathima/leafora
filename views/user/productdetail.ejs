      },
      body: JSON.stringify({ productId })
    });

    const data = await res.json();

    if (!data.success) {
      showToast(data.message, 'error');
      return;
    }

    const icon = btn.querySelector('i');

    if (data.inWishlist) {
      icon.classList.remove('fa-regular');
      icon.classList.add('fa-solid', 'text-red-500');

