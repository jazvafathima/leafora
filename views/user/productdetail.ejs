      icon.classList.remove('fa-solid', 'text-red-500');
      icon.classList.add('fa-regular');

      showToast('Removed from wishlist', 'info');
    }

  } catch (err) {
    console.error(err);
    showToast('Something went wrong', 'error');
  }
}
</script>
