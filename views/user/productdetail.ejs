    </div>
  </div>

  <!-- ════════════════════════════════════════
       PRODUCT DESCRIPTION
  ════════════════════════════════════════ -->
  <div class="bg-white rounded-2xl border border-gray-100 mt-10 px-7 py-7">
    <h3 class="font-display text-lg font-semibold text-gray-900 mb-3">
      The Importance of the <%= p ? p.name : 'This Plant' %>:
    </h3>
    <p class="text-sm text-gray-600 leading-relaxed">
      <%= p && p.description ? p.description : 'A beautiful and meaningful houseplant that brings life and joy to your home. Easy to care for and perfect for all spaces.' %>
