<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof product !== 'undefined' && product ? product.name + ' - Leafora' : 'Leafora' %></title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/global.css">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            leaf:  { 50:'#f0faf0',100:'#dcf5dc',600:'#1f7a1f',700:'#185c18',800:'#124512',900:'#0b2f0b' },
            cream: '#f5f0e8',
          },
          fontFamily: {
            display: ['"Playfair Display"','serif'],
            body:    ['Poppins','sans-serif'],
          },
        },
      },
    };
  </script>
  

  <style>
    *  { box-sizing: border-box; }
    body { font-family: 'Poppins', sans-serif; background: #f8f7f4; margin: 0; }

    /* ════════════ NAVBAR ════════════ */
    .navbar { background: #fff; border-bottom: 1px solid #e9ecef; padding: 0 32px; display: flex; align-items: center; justify-content: space-between; height: 56px; position: sticky; top: 0; z-index: 100; }
    .nav-logo { display: flex; align-items: center; gap: 6px; text-decoration: none; }
    .nav-logo img { height: 36px; }
    .nav-logo span { font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 700; color: #1a5c1a; }
    .nav-links { display: flex; align-items: center; gap: 28px; }
    .nav-links a { font-size: 0.8rem; color: #374151; text-decoration: none; font-weight: 500; transition: color .15s; }
    .nav-links a:hover { color: #1a5c1a; }
    .nav-icons { display: flex; align-items: center; gap: 18px; }
    .nav-icons a { color: #374151; font-size: 0.95rem; text-decoration: none; transition: color .15s; position: relative; }
    .nav-icons a:hover { color: #1a5c1a; }
    .cart-badge { position: absolute; top: -6px; right: -7px; background: #1a5c1a; color: #fff; font-size: 0.55rem; font-weight: 700; width: 15px; height: 15px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }

    /* ════════════ BREADCRUMB ════════════ */
    .breadcrumb { display: flex; align-items: center; gap: 6px; font-size: 0.72rem; color: #9ca3af; flex-wrap: wrap; }
    .breadcrumb a { color: #9ca3af; text-decoration: none; transition: color .15s; }
    .breadcrumb a:hover { color: #1a5c1a; }
    .breadcrumb .sep { color: #d1d5db; }
    .breadcrumb .current { color: #374151; font-weight: 500; }

    /* ════════════ ZOOM ════════════ */
    .zoom-container { position: relative; overflow: hidden; cursor: zoom-in; border-radius: 14px; background: #f0f4f0; }
    .zoom-container img { width: 100%; display: block; transition: transform .3s ease; transform-origin: 0 0; }
    .zoom-container:hover img { transform: scale(2); }
    .zoom-container.zoomed { cursor: zoom-out; }

    /* ════════════ THUMBNAILS ════════════ */
    .thumb { width: 72px; height: 72px; border-radius: 10px; overflow: hidden; cursor: pointer; border: 2px solid transparent; transition: all .2s; flex-shrink: 0; background: #f0f4f0; }
    .thumb img { width: 100%; height: 100%; object-fit: cover; }
    .thumb.active { border-color: #1a5c1a; }
    .thumb:hover { border-color: #5a9a5a; }

    /* ════════════ SIZE CHIPS ════════════ */
    .size-chip { padding: 6px 18px; border: 1.5px solid #d1d5db; border-radius: 8px; font-size: 0.75rem; font-weight: 500; cursor: pointer; transition: all .15s; color: #374151; background: #fff; }
    .size-chip:hover { border-color: #1a5c1a; color: #1a5c1a; }
    .size-chip.selected { border-color: #1a5c1a; background: #f0faf0; color: #1a5c1a; font-weight: 600; }
    .size-chip.out { border-color: #e5e7eb; color: #d1d5db; cursor: not-allowed; text-decoration: line-through; }

    /* ════════════ QTY ════════════ */
    .qty-btn { width: 32px; height: 32px; border: 1px solid #d1d5db; border-radius: 6px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 0.9rem; background: #fff; color: #374151; transition: all .15s; user-select: none; }
    .qty-btn:hover { border-color: #1a5c1a; color: #1a5c1a; }
    .qty-input { width: 48px; text-align: center; border: 1px solid #d1d5db; border-radius: 6px; height: 32px; font-size: 0.85rem; font-family: 'Poppins', sans-serif; color: #374151; outline: none; }
    .qty-input:focus { border-color: #1a5c1a; }

    /* ════════════ STARS ════════════ */
    .stars { color: #f59e0b; font-size: 0.75rem; }
    .stars .empty { color: #e5e7eb; }

    /* ════════════ HIGHLIGHT CHIPS ════════════ */
    .highlight { display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; }
    .highlight i { font-size: 1.3rem; color: #1a5c1a; }
    .highlight p { font-size: 0.67rem; color: #374151; font-weight: 500; line-height: 1.3; max-width: 80px; }

    /* ════════════ COUPON BADGE ════════════ */
    .coupon-badge { display: inline-flex; align-items: center; gap: 5px; background: #f0faf0; border: 1px dashed #5a9a5a; border-radius: 6px; padding: 4px 10px; font-size: 0.7rem; font-weight: 600; color: #185c18; cursor: pointer; transition: background .15s; }
    .coupon-badge:hover { background: #dcf5dc; }

    /* ════════════ STOCK BADGE ════════════ */
    .stock-in  { background: #dcfce7; color: #15803d; font-size: 0.65rem; font-weight: 700; padding: 3px 10px; border-radius: 999px; }
    .stock-low { background: #fef9c3; color: #a16207; font-size: 0.65rem; font-weight: 700; padding: 3px 10px; border-radius: 999px; }
    .stock-out { background: #fee2e2; color: #991b1b; font-size: 0.65rem; font-weight: 700; padding: 3px 10px; border-radius: 999px; }

    /* ════════════ REVIEW CARD ════════════ */
    .review-card { background: #fff; border-radius: 12px; border: 1px solid #f0f0f0; padding: 16px 18px; min-width: 260px; max-width: 300px; flex-shrink: 0; }

    /* ════════════ RELATED CARD ════════════ */
    .related-card { background: #fff; border-radius: 14px; border: 1px solid #f0f0f0; overflow: hidden; transition: box-shadow .2s; flex-shrink: 0; width: 180px; }
    .related-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,.08); }
    .related-img { width: 100%; height: 140px; background: #f0f4f0; display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .related-img img { width: 100%; height: 100%; object-fit: cover; }

    /* ════════════ FEATURE ROW ════════════ */
    .feature-row { display: flex; align-items: center; gap: 32px; padding: 18px 0; border-bottom: 1px solid #f0f0f0; justify-content: center; flex-wrap: wrap; }

    /* ════════════ TOAST ════════════ */
    .toast { position: fixed; top: 1rem; right: 1rem; z-index: 9999; display: flex; align-items: center; gap: 10px; padding: 12px 18px; border-radius: 10px; font-size: 0.82rem; font-weight: 500; box-shadow: 0 4px 20px rgba(0,0,0,.12); animation: slideIn .3s ease; }
    @keyframes slideIn { from { transform: translateX(120%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

    /* ════════════ SOLD OUT OVERLAY ════════════ */
    .sold-out-overlay { position: absolute; inset: 0; background: rgba(255,255,255,.7); display: flex; align-items: center; justify-content: center; border-radius: 14px; }
    .sold-out-label { background: #991b1b; color: #fff; font-size: 0.75rem; font-weight: 700; padding: 8px 20px; border-radius: 6px; letter-spacing: .05em; }

    /* ════════════ SCROLLBAR HIDDEN ════════════ */
    .no-scrollbar { scrollbar-width: none; }
    .no-scrollbar::-webkit-scrollbar { display: none; }

    /* ════════════ ZOOM LENS MOVE ════════════ */
    #mainImgWrap { user-select: none; }
  </style>
</head>

<%
  /* ── Server-side availability guard ── */
  const p = typeof product !== 'undefined' ? product : null;
  const isUnavailable = !p || p.isBlocked || p.status === 'inactive' || p.status === 'blocked';
%>



<body class="min-h-screen" id="pageBody">

<!-- ════════════════════════════════════════
     FLASH TOASTS
════════════════════════════════════════ -->
<% if (typeof success !== 'undefined' && success && success.length > 0) { %>
  <div class="toast bg-green-50 border border-green-200 text-green-700" id="flashToast">
    <i class="fa-solid fa-circle-check"></i> <%= success[0] %>
  </div>
<% } %>
<% if (typeof error !== 'undefined' && error && error.length > 0) { %>
  <div class="toast bg-red-50 border border-red-200 text-red-700" id="flashToast">
    <i class="fa-solid fa-circle-exclamation"></i> <%= error[0] %>
  </div>
<% } %>

<!-- ════════════════════════════════════════
     NAVBAR
════════════════════════════════════════ -->
<nav class="navbar">
  <a href="/" class="nav-logo">
    <!-- Logo image slot: replace src with your logo -->
    <img src="/images/leafora logo.png" alt="Leafora" onerror="this.style.display='none'" />
    <span>Leafora</span>
  </a>
     <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-gray-600">
        <a href="/"          class="hover:text-leaf-700 transition-colors">Home</a>
        <a href="/productlist" class="hover:text-leaf-700 transition-colors"  >products</a>
        <a href="/about"  class="hover:text-leaf-700 transition-colors">About</a>
        <a href="/contact"     class="hover:text-leaf-700 transition-colors">Contact</a>
      </nav>
   <div class="nav-icons" style="display:flex;align-items:center">
    <a href="/profile" title="Account"><i class="fa-regular fa-user"></i></a>
<a href="/wishlist" title="Wishlist" style="position:relative">
    <i class="fa-regular fa-heart"></i>

    <span id="wishlistBadge" class="cart-badge" style="display:none">
        0
    </span>
</a>
   <a href="/cart" title="Cart" style="position:relative">
    <i class="fa-solid fa-bag-shopping"></i>

    <span id="cartBadge"
          class="cart-badge"
          style="<%= cartCount > 0 ? 'display:flex' : 'display:none' %>">
        <%= cartCount || 0 %>
    </span>
</a>
  </div>
</nav>

<!-- ════════════════════════════════════════
     MAIN PRODUCT SECTION
════════════════════════════════════════ -->
<div class="max-w-6xl mx-auto px-4 py-7">

  <%
    /* Helpers */
    const variants  = p && p.variants ? p.variants : [];
    const firstVar  = variants.length > 0 ? variants[0] : null;
    const allImages = p && p.images ? p.images : [];
    const basePrice = firstVar ? (firstVar.price || 0) : (p ? p.price || 0 : 0);
    const discPrice = firstVar ? (firstVar.discountPrice || firstVar.discount || null) : null;
    const stock= variants.reduce ? variants.reduce((s,v)=>s+(v.stockQuantity||v.stock||0),0) : 0;
    const avgRating = p && p.avgRating ? p.avgRating : (p && p.rating ? p.rating : 4.3);
    const reviewCount= p && p.reviewCount ? p.reviewCount : (p && p.reviews ? p.reviews.length : 0);
    const discPct   = basePrice && discPrice ? Math.round((1 - discPrice/basePrice)*100) : 0;
  %>

  <!-- Breadcrumb -->
  <div class="breadcrumb mb-5">
    <a href="/">Home</a>
    <span class="sep">/</span>
    <a href="/products">Plants</a>
    <% if (p && p.category) { %>
      <span class="sep">/</span>
      <a href="/products?category=<%= p.category._id || p.category %>"><%= p.category.name || p.category %></a>
    <% } %>
    <span class="sep">/</span>
    <span class="current"><%= p ? p.name : 'Product' %></span>
  </div>
  <% if (unavailable) { %>
<div class="mb-6 rounded-lg border border-red-300 bg-red-50 p-4">
    <h2 class="text-red-700 font-bold text-lg">
        Product Unavailable
    </h2>

    <p class="text-red-600 text-sm mt-1">
        This product has been removed or is currently unavailable.
    </p>
</div>
<% } %>

  <!-- Product grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-10">

    <!-- ── LEFT: Images ── -->
    <div>
      <!-- Main zoom image -->
      <div class="zoom-container mb-3" id="mainImgWrap" style="height:350px  width:267px; " >
        <% if (allImages.length > 0) { %>
          <img id="mainImg" src="<%= allImages[0] %>" alt="<%= p ? p.name : 'Product' %>"
               style="height:100%;width:100%;object-fit:cover;border-radius:14px" />
        <% } else { %>
          <!-- Image placeholder — same size as real image -->
          <div style="height:380px;display:flex;align-items:center;justify-content:center;background:#e8ede8;border-radius:14px">
            <i class="fa-solid fa-seedling text-5xl" style="color:#c0d8c0;opacity:.6"></i>
          </div>
        <% } %>
        <!-- Sold-out overlay -->
        <% if (stock === 0) { %>
          <div class="sold-out-overlay">
            <span class="sold-out-label">SOLD OUT</span>
          </div>
        <% } %>
      </div>

      <!-- Thumbnails -->
      <div id="thumbnailContainer" class="flex gap-2 flex-wrap">
        <% if (allImages.length > 0) { %>
          <% allImages.forEach(function(img, i){ %>
            <div class="thumb <%= i===0?'active':'' %>" onclick="switchImg(this,'<%= img %>')">
              <img src="<%= img %>" alt="View <%= i+1 %>" />
            </div>
          <% }) %>
        <% } else { %>
          <!-- Thumbnail placeholders -->
          <% for(let i=0;i<3;i++){ %>
            <div class="thumb" style="background:#e8ede8;display:flex;align-items:center;justify-content:center">
              <i class="fa-solid fa-image" style="color:#c0d0c0;font-size:1.1rem"></i>
            </div>
          <% } %>
        <% } %>
      </div>
    </div>

    <!-- ── RIGHT: Info ── -->
    <div>

      <!-- Title + wishlist -->
      <div class="flex items-start justify-between gap-3 mb-2">
        <h1 class="font-display text-2xl font-semibold text-gray-900 leading-tight">
            <%= p ? p.name : 'Product Name' %>
            <% if (p && p.returnStatus) { %>
              <span class="badge <%= (function(){
                const map={
                  approved:'badge-processing',
                  rejected:'badge-cancelled',
                  returned:'badge-returned',
                  requested:'badge-pending'
                };
                return map[p.returnStatus] || 'badge-pending';
              })() %>"><%= p.returnStatus.charAt(0).toUpperCase() + p.returnStatus.slice(1) %></span>
            <% } %>
          </h1>
        <%
  const _wlIds = typeof wishlistIds !== 'undefined' ? wishlistIds : [];
  const _inWL = _wlIds.includes(p._id.toString());
%>

<button
  type="button"
  onclick="toggleWishlist('<%= p._id %>', this)"
  class="bg-white/90 rounded-full w-10 h-10 flex items-center justify-center shadow"
>
  <i class="<%= _inWL ? 'fa-solid text-red-500' : 'fa-regular text-gray-500' %> fa-heart"></i>
</button>
      </div>

      <!-- Ratings -->
      <div class="flex items-center gap-2 mb-3">
        <div class="stars">
          <% for(let s=1;s<=5;s++){ %>
            <i class="fa-<%= s <= Math.round(avgRating) ? 'solid' : 'regular' %> fa-star <%= s > Math.round(avgRating) ? 'empty' : '' %>"></i>
          <% } %>
        </div>
        <span class="text-xs text-gray-500 font-medium">
          <%= Number(avgRating).toFixed(1) %>
          <span class="text-gray-300 mx-1">·</span>
          <%= reviewCount %> reviews
        </span>
      </div>

      <% if (isUnavailable) { %>
<div class="max-w-4xl mx-auto mt-6">
  <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
    <strong>Unavailable:</strong>
    This product is currently unavailable.
  </div>
</div>
<% } %>

      <!-- Price block -->
    <div class="flex items-center gap-3 mb-1">

    <span id="displayPrice" class="text-2xl font-bold text-green-700">
        ₹<%= product.offerPrice || product.originalPrice %>
    </span>

    <span
        id="originalPrice"
        class="ml-2 text-gray-400 line-through <%= product.hasOffer ? '' : 'hidden' %>">

        ₹<%= product.originalPrice %>
    </span>

    <span
        id="discountPercent"
        class="ml-2 text-red-600 font-semibold <%= product.hasOffer ? '' : 'hidden' %>">

        <%= product.offerDiscount %>₹ OFF
    </span>

</div>

      <!-- Stock info -->
      <div class="flex items-center gap-3 mb-4">
        <% if (stock > 10) { %>
          <span class="stock-in"><i class="fa-solid fa-circle-check mr-1"></i>In Stock</span>
          <span id="stockText" class="text-xs text-gray-400">
  <%= stock %> units available
</span>
        <% } else if (stock > 0) { %>
          <span class="stock-low"><i class="fa-solid fa-triangle-exclamation mr-1"></i>Low Stock</span>
          <span class="text-xs text-orange-500 font-medium">Only <%= stock %> left!</span>
        <% } else { %>
          <span class="stock-out"><i class="fa-solid fa-circle-xmark mr-1"></i>Out of Stock</span>
        <% } %>

        <!-- Coupons -->
        <% if (typeof coupons !== 'undefined' && coupons && coupons.length > 0) { %>
          <% coupons.forEach(function(c){ %>
            <span class="coupon-badge" onclick="copyCoupon('<%= c.code %>')" title="Click to copy">
              <i class="fa-solid fa-tag"></i> <%= c.code %>
            </span>
          <% }) %>
        <% } %>
      </div>

      <!-- Select Size -->
      <% if (variants.length > 0) { %>
        <div class="mb-4">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Select size</p>
          <div class="flex flex-wrap gap-2" id="sizeWrap">
            <% variants.forEach(function(v, vi){ %>

              <%
                const vStock = v.stockQuantity || v.stock || 0;
                const isOut  = vStock === 0;
              %>
             <button
  type="button"
  class="size-chip <%= vi===0?'selected':'' %>"
  data-variant="<%= v._id %>"
  data-price="<%= v.price || 0 %>"
  data-discount="<%= v.discountPrice || 0 %>"
  data-stock="<%= v.stockQuantity || 0 %>"
  data-images='<%- JSON.stringify(
    (v.images || []).map(img => `/uploads/products/${img}`)
  ) %>'
  onclick="selectVariant(this)">
  <%= v.size %>
</button>
            <% }) %>
          </div>
        </div>
      <% } %>

      <!-- Quantity -->
      <% if (stock > 0) { %>
        <div class="flex items-center gap-3 mb-5">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Quantity</p>
          <div class="flex items-center gap-2">
            <button class="qty-btn" onclick="changeQty(-1)"><i class="fa-solid fa-minus" style="font-size:10px"></i></button>
            <input type="number" id="qtyInput" value="1" min="1" max="<%= stock %>" class="qty-input" readonly />
            <button class="qty-btn" onclick="changeQty(1)"><i class="fa-solid fa-plus" style="font-size:10px"></i></button>
          </div>
        </div>

        <!-- CTA buttons -->
        <div class="flex gap-3 mb-5">
          <form id="addToCartForm" action="/cart/add" method="POST" class="flex-1">
            <input type="hidden" name="productId" value="<%= p ? p._id : '' %>" />
            <input type="hidden" name="variantId" id="cartVariantId" value="<%= firstVar ? firstVar._id : '' %>" />
            <input type="hidden" name="quantity"  id="cartQty" value="1" />
          <% if (isUnavailable) { %>
  <button
    class="w-full bg-gray-400 text-white py-3 rounded cursor-not-allowed"
    disabled>
    Product Unavailable
  </button>
<% } else { %>
<button
data-no-loader
  id="addToCartBtn"
  class="w-full bg-green-600 text-white py-3 rounded">
  Add to Cart
</button>
<% } %>

          </form>
        <!-- <form action="/buy-now" method="POST">
    <input type="hidden" name="productId" value="<%= p._id %>">
    <input type="hidden" name="variantId" id="buyVariantId" value="<%= firstVar ? firstVar._id : '' %>">
    <input type="hidden" name="quantity" id="buyQty" value="1">

    <button type="submit">
        BUY IT NOW
    </button>
</form> -->
        </div>
      <% } else { %>
        <div class="mb-5">
          <button disabled
            class="w-full bg-gray-200 text-gray-400 font-semibold text-sm py-3 rounded-lg cursor-not-allowed flex items-center justify-center gap-2">
            <i class="fa-solid fa-circle-xmark text-xs"></i> SOLD OUT
          </button>
          <p class="text-xs text-gray-400 text-center mt-2">This item is currently unavailable</p>
        </div>
      <% } %>

      <!-- Delivery info -->
      <div class="border border-gray-100 rounded-xl p-3 bg-gray-50 text-xs text-gray-500 space-y-1.5 mb-4">
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-truck text-[#1a5c1a] w-4 text-center"></i>
          <span>By <strong class="text-gray-700">Leafora Delivery</strong> on <strong class="text-gray-700">May 31</strong></span>
        </div>
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-leaf text-[#1a5c1a] w-4 text-center"></i>
          <span>Free Shipping between <strong class="text-gray-700">₹500 – ₹1,500</strong></span>
        </div>
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-rotate-left text-[#1a5c1a] w-4 text-center"></i>
          <span>Easy Returns within 14 days</span>
        </div>
      </div>

      <!-- Payment icons -->
      <div class="flex items-center gap-2 flex-wrap">
        <i class="fa-brands fa-cc-visa text-gray-400 text-xl"></i>
        <i class="fa-brands fa-cc-mastercard text-gray-400 text-xl"></i>
        <i class="fa-brands fa-cc-amex text-gray-400 text-xl"></i>
        <i class="fa-brands fa-cc-paypal text-gray-400 text-xl"></i>
        <span class="text-[9px] font-bold text-gray-400 border border-gray-200 px-1.5 py-0.5 rounded">RuPay</span>
        <span class="text-[9px] text-gray-400 ml-1">Guaranteed safe &amp; secure checkout</span>
      </div>

    </div>
  </div>
  <!-- /grid -->

  <!-- ════════════════════════════════════════
       FEATURE HIGHLIGHTS ROW
  ════════════════════════════════════════ -->
  <div class="bg-white rounded-2xl border border-gray-100 mt-10 px-6">
    <div class="feature-row">
