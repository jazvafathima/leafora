// Duplicate submit listener removed — loading state is now handled in the fetch handler above

async function addToCart(event, productId, variantId) {
  event.preventDefault();
  event.stopPropagation();

  const overlay = document.getElementById("pageLoader");

  // Show loader
  overlay.classList.remove("hidden");

  // Optional: change button text
  const btn = event.currentTarget;
  const originalText = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = "Adding to cart...";

  try {
    const res = await fetch("/cart/add", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        productId,
        variantId,
        quantity: 1,
      }),
    });

    const data = await res.json();

    if (data.success) {
      Swal.fire({
        toast: true,
        position: "top-end",
        icon: "success",
        title: "Added to cart",
        timer: 1500,
        showConfirmButton: false,
      });

      updateCartBadge(data.cartCount);
    } else {
      Swal.fire({
        icon: "error",
        title: data.message,
      });
    }
  } catch (err) {
    console.error(err);

    Swal.fire({
      icon: "error",
      title: "Something went wrong",
    });
  } finally {
    // Hide loader again because fetch doesn't reload the page
    overlay.classList.add("hidden");

    // Restore button
    btn.disabled = false;
    btn.innerHTML = originalText;
  }
}
</script>

