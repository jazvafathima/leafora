}

    // Update Thumbnail Gallery
 const thumbContainer = document.getElementById("thumbnailContainer");
console.log("Thumb container:", thumbContainer);

    if (thumbContainer && images.length > 0) {

        thumbContainer.innerHTML = '';

        images.forEach((img, index) => {

            thumbContainer.innerHTML += `
                <div class="thumb ${index === 0 ? 'active' : ''}"
                     onclick="switchImg(this,'${img}')">
                    <img src="${img}">
                </div>
            `;
        });
    }
}
  /* ── Quantity ── */
  function changeQty(delta) {
    const inp = document.getElementById('qtyInput');
    if (!inp) return;
    let val = parseInt(inp.value) + delta;
    const max = parseInt(inp.max) || 99;
    val = Math.max(1, Math.min(val, max));
    inp.value = val;
    ['cartQty','buyQty'].forEach(id => {
      const el = document.getElementById(id); if(el) el.value = val;
    });
  }

  /* ── Wishlist toggle ── */
  function toggleWish(btn) {
    const icon = btn.querySelector('i');
    const isSolid = icon.classList.contains('fa-solid');
    icon.classList.toggle('fa-solid',   !isSolid);
    icon.classList.toggle('fa-regular',  isSolid);
    icon.style.color = isSolid ? '' : '#ef4444';

    fetch('/wishlist/toggle', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ productId: '<%= p ? p._id : "" %>' })
    }).catch(() => {});
  }

  /* ── Copy coupon code ── */
  function copyCoupon(code) {
    navigator.clipboard.writeText(code).then(() => {
      showToast('Coupon "' + code + '" copied!', 'success');
    }).catch(() => {});
  }

  /* ── Mini toast ── */
  function showToast(msg, type) {
    const old = document.getElementById('miniToast');
    if (old) old.remove();
    const t = document.createElement('div');
    t.id = 'miniToast';
    t.className = 'toast ' + (type === 'success'
      ? 'bg-green-50 border border-green-200 text-green-700'
      : 'bg-red-50 border border-red-200 text-red-700');
    t.innerHTML = '<i class="fa-solid fa-' + (type==='success'?'circle-check':'circle-exclamation') + '"></i> ' + msg;
    document.body.appendChild(t);
    setTimeout(() => t.remove(), 3000);
  }

  /* ── Auto dismiss flash toast ── */
  const flashToast = document.getElementById('flashToast');
  if (flashToast) setTimeout(() => flashToast.remove(), 5000);
</script>
