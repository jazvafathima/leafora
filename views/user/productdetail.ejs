              </div>
              <p class="text-xs font-semibold text-gray-700">Happy Customer</p>
            </div>
          </div>
        <% } %>
      <% } %>

    </div>

    <!-- Write a review link -->
    <div class="flex items-center justify-center gap-4 mt-4">
      <a href="/products/<%= p ? p._id : '' %>/review"
         class="text-xs text-[#1a5c1a] font-medium hover:underline flex items-center gap-1">
