  <style>
    body { font-family: 'Poppins', sans-serif; background-color: #e8e4dc; }

    /* ── Card inputs ── */
    .pass-label {
      display: block;
      font-size: 0.75rem;
      font-weight: 500;
      color: #2d4a2d;
      margin-bottom: 4px;
    }
    .pass-input {
      width: 100%;
      border: 1px solid #c8d5c8;
      border-radius: 6px;
      padding: 9px 38px 9px 12px;
      font-size: 0.82rem;
      color: #1a3a1a;
      font-family: 'Poppins', sans-serif;
      background: #fff;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .pass-input:focus {
      border-color: #185c18;
      box-shadow: 0 0 0 3px rgba(24,92,24,0.08);
    }
    .pass-input.is-error {
      border-color: #dc2626;
      box-shadow: 0 0 0 3px rgba(220,38,38,0.08);
    }
    .pass-input::placeholder { color: #9eaa9e; font-size: 0.8rem; }

    /* ── Requirement dots ── */
    .req-item { display: flex; align-items: center; gap: 7px; font-size: 0.72rem; color: #4a6a4a; margin-bottom: 3px; }
    .req-dot  { width: 8px; height: 8px; border-radius: 50%; background: #4a8f4a; flex-shrink: 0; transition: background 0.2s; }
    .req-dot.fail { background: #d1d5db; }

    /* ── Field error ── */
    .field-error {
      color: #dc2626; font-size: 0.68rem; margin-top: 4px;
      display: flex; align-items: center; gap: 3px;
    }

    /* ── Toast ── */
    .toast {
      position: fixed; top: 1rem; right: 1rem; z-index: 9999;
      display: flex; align-items: center; gap: 10px;
      padding: 12px 18px; border-radius: 10px;
      font-size: 0.82rem; font-weight: 500;
      box-shadow: 0 4px 20px rgba(0,0,0,0.12);
      animation: slideIn 0.3s ease;
    }
   

     @keyframes scaleIn {
  from { transform: scale(0.8); opacity: 0; }
  to   { transform: scale(1);   opacity: 1; }
}
.animate-scaleIn {
  animation: scaleIn 0.3s ease;
}


  </style>
</head>

<body class="min-h-screen">




  <!-- ══════════════════════════════════════════
       MAIN CONTENT AREA (page bg)
