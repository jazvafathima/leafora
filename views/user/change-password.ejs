  <script>
    /* ── Toggle eye ── */
    function togglePass(inputId, iconId) {
      const input = document.getElementById(inputId);
      const icon  = document.getElementById(iconId);
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('fa-eye', 'fa-eye-slash');
      } else {
        input.type = 'password';
        icon.classList.replace('fa-eye-slash', 'fa-eye');
      }
    }

    /* ── Live requirements ── */
    const newPassInput = document.getElementById('newPassword');
    const confirmInput = document.getElementById('confirmPassword');

    const reqs = {
      length:  { el: document.getElementById('req-length'),  test: v => v.length >= 8 },
      upper:   { el: document.getElementById('req-upper'),   test: v => /[A-Z]/.test(v) },
      number:  { el: document.getElementById('req-number'),  test: v => /[0-9]/.test(v) },
      special: { el: document.getElementById('req-special'), test: v => /[@$!%*?&#^]/.test(v) },
    };

    newPassInput.addEventListener('input', () => {
      const val = newPassInput.value;
      Object.values(reqs).forEach(({ el, test }) => {
        el.classList.toggle('fail', !test(val));
      });
    });

    confirmInput.addEventListener('input', () => {
      confirmInput.classList.toggle('is-error',
        confirmInput.value !== newPassInput.value && confirmInput.value !== ''
      );
    });

    /* ── Client validation ── */
    document.getElementById('changePassForm').addEventListener('submit', function(e) {
      let valid = true;
      document.querySelectorAll('.client-err').forEach(el => el.remove());
      document.querySelectorAll('.pass-input').forEach(el => el.classList.remove('is-error'));

      const showErr = (id, msg) => {
        const input = document.getElementById(id);
        if (!input) return;
        input.classList.add('is-error');
        const p = document.createElement('p');
        p.className = 'field-error client-err';
        p.innerHTML = `<i class="fa-solid fa-circle-exclamation" style="font-size:10px"></i> ${msg}`;
        input.closest('div').parentElement.appendChild(p);
        valid = false;
      };

      const cur = document.getElementById('currentPassword').value;
      const pw  = newPassInput.value;
      const cpw = confirmInput.value;

     if (!fn) {
  showErr('firstName', 'First name is required.');
}

if (!ln) {
  showErr('lastName', 'Last name is required.');
}

if (!em) {
  showErr('email', 'Email is required.');
} else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em)) {
  showErr('email', 'Enter a valid email.');
}

if (!pw) {
  showErr('password', 'Password is required.');
} else {
  
  if (pw.length < 8) {
    showErr('password', 'Password must be at least 8 characters.');
  }

  if (!/[A-Z]/.test(pw)) {
    showErr('password', 'Password must contain at least one uppercase letter.');
  }

  if (!/[0-9]/.test(pw)) {
    showErr('password', 'Password must contain at least one number.');
  }

  if (!/[!@#$%^&*(),.?":{}|<>]/.test(pw)) {
    showErr('password', 'Password must contain at least one special character.');
  }
}

if (!cpw) {
  showErr('confirmPassword', 'Please confirm password.');
} else if (cpw !== pw) {
  showErr('confirmPassword', 'Passwords do not match.');
}

      if (!valid) {
        e.preventDefault();
      } else {
        const btn = document.getElementById('submitBtn');
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-xs"></i> Updating...';
        btn.disabled = true;
      }
    });

    /* ── Auto-dismiss toast ── */
  
  </script>
  <div id="popupOverlay" class="hidden fixed inset-0 bg-black/40 flex items-center justify-center z-50">
  
  <div id="popupBox" class="bg-white rounded-xl shadow-xl px-8 py-6 w-[90%] max-w-md text-center animate-scaleIn">
    
    <div id="popupIcon" class="text-4xl mb-3"></div>

    <h2 id="popupTitle" class="text-lg font-semibold mb-2"></h2>

    <p id="popupMessage" class="text-sm text-gray-600 mb-5"></p>

    <button onclick="closePopup()"
      class="px-5 py-2 bg-leaf-700 hover:bg-leaf-800 text-white rounded-md text-sm">
      OK
    </button>

  </div>
</div>
  <script>

  const success = "<%= success || '' %>";
  const error = "<%= error || '' %>";

  const overlay = document.getElementById("popupOverlay");
  const title = document.getElementById("popupTitle");
  const message = document.getElementById("popupMessage");
  const icon = document.getElementById("popupIcon");

  if (success || error) {
    overlay.classList.remove("hidden");

    if (success) {
      title.innerText = "Success";
      message.innerText = success;
      icon.innerHTML = "✅";
    } else {
      title.innerText = "Error";
      message.innerText = error;
      icon.innerHTML = "❌";
    }
  }

  function closePopup() {
    overlay.classList.add("hidden");
  }
   setTimeout(() => {
  overlay.classList.add("hidden");
}, 3000);
</script>

