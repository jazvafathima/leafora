  <div class="min-h-screen bg-[#ddd9d0] px-4 py-10">
    <div class="max-w-lg mx-auto">

      <!-- Page heading -->
      <h1 class="font-display text-2xl font-semibold text-leaf-800 mb-1">Change Password</h1>
      <p class="text-xs text-gray-500 mb-6">Update your account password to keep your account secure</p>


      <!-- ── Card ── -->
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm px-7 py-7">

        <form action="/update-password" method="POST" novalidate id="changePassForm">

          <!-- Current Password -->
          <div class="mb-4">
            <label class="pass-label" for="currentPassword">Current Password</label>
            <div class="relative">
              <input type="password" name="currentPassword" id="currentPassword"
                placeholder="Enter current password"
                class="pass-input <%= (typeof errors !== 'undefined' && errors && errors.currentPassword) ? 'is-error' : '' %>"
              />
              <button type="button" onclick="togglePass('currentPassword','eyeCurrent')"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-blue-400 hover:text-leaf-700 text-sm">
                <i id="eyeCurrent" class="fa-regular fa-eye"></i>
              </button>
            </div>
            <% if (typeof errors !== 'undefined' && errors && typeof errors === 'object' && errors.currentPassword) { %>
              <p class="field-error">
                <i class="fa-solid fa-circle-exclamation" style="font-size:10px"></i>
                <%= errors.currentPassword %>
              </p>
            <% } %>
          </div>

          <!-- New Password -->
          <div class="mb-4">
            <label class="pass-label" for="newPassword">New Password</label>
            <div class="relative">
              <input type="password" name="newPassword" id="newPassword"
                placeholder="Enter new password"
                class="pass-input <%= (typeof errors !== 'undefined' && errors && errors.newPassword) ? 'is-error' : '' %>"
              />
              <button type="button" onclick="togglePass('newPassword','eyeNew')"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-blue-400 hover:text-leaf-700 text-sm">
                <i id="eyeNew" class="fa-regular fa-eye"></i>
              </button>
            </div>
            <% if (typeof errors !== 'undefined' && errors && typeof errors === 'object' && errors.newPassword) { %>
              <p class="field-error">
                <i class="fa-solid fa-circle-exclamation" style="font-size:10px"></i>
                <%= errors.newPassword %>
              </p>
            <% } %>
          </div>

          <!-- Confirm New Password -->
          <div class="mb-5">
            <label class="pass-label" for="confirmPassword">Confirm New Password</label>
            <div class="relative">
              <input type="password" name="confirmPassword" id="confirmPassword"
                placeholder="Re-enter new password"
                class="pass-input <%= (typeof errors !== 'undefined' && errors && errors.confirmPassword) ? 'is-error' : '' %>"
              />
              <button type="button" onclick="togglePass('confirmPassword','eyeConfirm')"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-blue-400 hover:text-leaf-700 text-sm">
                <i id="eyeConfirm" class="fa-regular fa-eye"></i>
              </button>
            </div>
            <% if (typeof errors !== 'undefined' && errors && typeof errors === 'object' && errors.confirmPassword) { %>
              <p class="field-error">
                <i class="fa-solid fa-circle-exclamation" style="font-size:10px"></i>
                <%= errors.confirmPassword %>
              </p>
            <% } %>
          </div>

          <!-- Password Requirements Box -->
          <div class="border border-gray-200 rounded-lg px-4 pt-3 pb-4 mb-6 bg-gray-50">
            <p class="text-[11px] font-semibold text-gray-500 mb-2">Password Requirements:</p>
            <div class="req-item"><span class="req-dot fail" id="req-length"></span> Minimum 8 characters</div>
            <div class="req-item"><span class="req-dot fail" id="req-upper"></span> At least one uppercase letter</div>
            <div class="req-item"><span class="req-dot fail" id="req-number"></span> At least one number</div>
            <div class="req-item"><span class="req-dot fail" id="req-special"></span> At least one special character</div>
          </div>

          <!-- Actions -->
          <div class="flex items-center justify-end gap-3">
            <a href="/profile"
              class="px-5 py-2 text-sm font-medium text-gray-600 hover:text-gray-800 border border-gray-300 rounded-md transition-colors">
              Cancel
            </a>
            <button type="submit" id="submitBtn"
              class="px-6 py-2 bg-leaf-700 hover:bg-leaf-800 text-white text-sm font-semibold rounded-md transition-colors flex items-center gap-2">
              <i class="fa-solid fa-lock text-xs"></i>
              Update Password
            </button>
          </div>

        </form>
      </div>
      <!-- /Card -->

    </div>
  </div>
