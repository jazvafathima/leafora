<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Leafora - Create Account</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            leaf: { 50:'#f0faf0', 100:'#dcf5dc', 600:'#1f7a1f', 700:'#185c18', 800:'#124512', 900:'#0b2f0b' },
            cream: '#f5f0e8',
          },
          fontFamily: {
            display: ['"Playfair Display"', 'serif'],
            body:    ['Poppins', 'sans-serif'],
          },
        },
      },
    };
  </script>

  <style>
    body { font-family: 'Poppins', sans-serif; }

    .field-input {
      width: 100%;
      background: transparent;
      border: none;
      border-bottom: 1.5px solid #5a7a5a;
      outline: none;
      padding: 6px 0 4px;
      font-size: 0.82rem;
      color: #1a3a1a;
      font-family: 'Poppins', sans-serif;
      transition: border-color 0.2s;
    }
    .field-input::placeholder { color: #6b7a6b; font-size: 0.82rem; }
    .field-input:focus         { border-bottom-color: #185c18; }
    .field-input.is-error      { border-bottom-color: #dc2626; }

    .or-line { flex: 1; height: 1.5px; background: #3d6b3d; }

    .field-error {
      color: #dc2626;
      font-size: 0.68rem;
      margin-top: 3px;
      display: flex;
      align-items: center;
      gap: 3px;
    }

    .toast {
      position: fixed; top: 1rem; right: 1rem; z-index: 9999;
      display: flex; align-items: center; gap: 10px;
      padding: 12px 18px; border-radius: 10px;
      font-size: 0.82rem; font-weight: 500;
      box-shadow: 0 4px 20px rgba(0,0,0,0.12);
      animation: slideIn 0.3s ease;
    }
    @keyframes slideIn {
      from { transform: translateX(120%); opacity: 0; }
      to   { transform: translateX(0);    opacity: 1; }
    }
  </style>
</head>

<body class="bg-cream min-h-screen">

  <!-- ════════════════════════════════════════════════════════════════
       FIX 1 — Flash toasts are NOW inside <body>, not after </html>
  ═════════════════════════════════════════════════════════════════ -->
  <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
    <div class="toast bg-red-50 border border-red-200 text-red-700" id="flashToast">
      <i class="fa-solid fa-circle-exclamation"></i>
      <%= error[0] %>
      <button onclick="document.getElementById('flashToast').remove()"
        class="ml-2 text-red-400 hover:text-red-600">
        <i class="fa-solid fa-xmark text-xs"></i>
      </button>
    </div>
  <% } %>

  <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
    <div class="toast bg-green-50 border border-green-200 text-green-700" id="flashToast">
      <i class="fa-solid fa-circle-check"></i>
      <%= success[0] %>
    </div>
  <% } %>

  <div class="flex min-h-screen">

    <!-- LEFT: Plant Image -->
    <div class="hidden md:block w-7/12 relative overflow-hidden flex-shrink-0">
      <img
        src="https://png.pngtree.com/thumb_back/fw800/background/20231102/pngtree-lush-green-monstera-fern-and-palm-fronds-vibrant-foliage-amidst-rainforest-image_13807192.png"
        alt="Lush green monstera leaves"
        class="absolute inset-0 w-full h-full object-cover"
      />
    </div>

    <!-- RIGHT: Form -->
    <div class="flex-1 bg-cream flex flex-col items-center justify-center px-10 md:px-16 py-12 min-h-screen">

      <!-- Logo -->
      <div class="flex items-center gap-2 mb-10">
        <img src="/images/leafora logo.png" alt="Leafora" class="h-16 w-auto" />
        <span class="font-display text-2xl font-bold text-leaf-800 tracking-tight">Leafora</span>
      </div>

      <div class="w-full max-w-sm">

        <h1 class="font-display text-2xl font-semibold text-leaf-800 mb-6">Create Account</h1>

        <!-- ════════════════════════════════════════════════════════════
             FIX 3 — Google button is now an <a> tag, not a <button>
             Points to /auth/google (Passport OAuth route)
        ═════════════════════════════════════════════════════════════ -->
        <a href="/user/auth/google"
          class="inline-flex items-center gap-3 border border-gray-300 bg-white rounded-md px-24 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:border-gray-400 transition-colors shadow-sm">
          <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Sign up with Google
        </a>

        <!-- OR Divider -->
        <div class="flex items-center gap-3 my-6">
          <div class="or-line"></div>
          <span class="text-leaf-700 text-xs font-semibold tracking-widest">OR</span>
          <div class="or-line"></div>
        </div>

        <!-- Form -->
        <form action="/signup" method="POST" novalidate class="space-y-4" id="signupForm">

          <!-- Row 1: First Name + Last Name -->
          <div class="grid grid-cols-2 gap-5">

            <div>
              <input type="text" name="firstName" id="firstName" placeholder="First Name"
                value="<%= (typeof formData !== 'undefined' && formData && formData.firstName) ? formData.firstName : '' %>"
                class="field-input <%= (typeof errors !== 'undefined' && errors && errors.firstName) ? 'is-error' : '' %>"
              />
              <!-- ══════════════════════════════════════════════════════
                   FIX 2 — typeof + object check before using errors
                   Prevents looping over string characters
              ═════════════════════════════════════════════════════════ -->
              <% if (typeof errors !== 'undefined' && errors && typeof errors === 'object' && errors.firstName) { %>
                <p class="field-error">
                  <i class="fa-solid fa-circle-exclamation" style="font-size:10px"></i>
                  <%= errors.firstName %>
                </p>
              <% } %>
            </div>

            <div>
              <input type="text" name="lastName" id="lastName" placeholder="Last Name"
                value="<%= (typeof formData !== 'undefined' && formData && formData.lastName) ? formData.lastName : '' %>"
                class="field-input <%= (typeof errors !== 'undefined' && errors && errors.lastName) ? 'is-error' : '' %>"
              />
              <% if (typeof errors !== 'undefined' && errors && typeof errors === 'object' && errors.lastName) { %>
                <p class="field-error">
                  <i class="fa-solid fa-circle-exclamation" style="font-size:10px"></i>
                  <%= errors.lastName %>
                </p>
              <% } %>
            </div>

          </div>

          <!-- Row 2: Email + Phone -->
          <div class="grid grid-cols-2 gap-5">

            <div>
              <input type="email" name="email" id="email" placeholder="Email Address"
                value="<%= (typeof formData !== 'undefined' && formData && formData.email) ? formData.email : '' %>"
                class="field-input <%= (typeof errors !== 'undefined' && errors && errors.email) ? 'is-error' : '' %>"
              />
              <% if (typeof errors !== 'undefined' && errors && typeof errors === 'object' && errors.email) { %>
                <p class="field-error">
                  <i class="fa-solid fa-circle-exclamation" style="font-size:10px"></i>
                  <%= errors.email %>
                </p>
              <% } %>
            </div>

            <div>
              <input type="tel" name="phone" id="phone" placeholder="Phone Number"
                value="<%= (typeof formData !== 'undefined' && formData && formData.phone) ? formData.phone : '' %>"
                class="field-input <%= (typeof errors !== 'undefined' && errors && errors.phone) ? 'is-error' : '' %>"
              />
              <% if (typeof errors !== 'undefined' && errors && typeof errors === 'object' && errors.phone) { %>
                <p class="field-error">
                  <i class="fa-solid fa-circle-exclamation" style="font-size:10px"></i>
                  <%= errors.phone %>
                </p>
              <% } %>
            </div>

          </div>

          <!-- Row 3: Password + Confirm Password -->
          <div class="grid grid-cols-2 gap-5">

            <div>
              <div class="relative">
                <input type="password" name="password" id="password" placeholder="Password"
                  class="field-input pr-6 <%= (typeof errors !== 'undefined' && errors && errors.password) ? 'is-error' : '' %>"
                />
                <button type="button" onclick="togglePass('password','eyePass')"
                  class="absolute right-0 top-1 text-gray-400 hover:text-leaf-700 text-xs">
                  <i id="eyePass" class="fa-regular fa-eye"></i>
                </button>
              </div>
              <!-- Password strength bar -->
              <div class="mt-1.5 bg-gray-200 rounded-full h-1 overflow-hidden">
                <div id="strengthBar" class="h-full w-0 rounded-full transition-all duration-300"></div>
              </div>
              <p id="strengthLabel" class="text-[10px] text-gray-400 mt-0.5 h-3"></p>
              <% if (typeof errors !== 'undefined' && errors && typeof errors === 'object' && errors.password) { %>
                <p class="field-error">
                  <i class="fa-solid fa-circle-exclamation" style="font-size:10px"></i>
                  <%= errors.password %>
                </p>
              <% } %>
            </div>

            <div>
              <div class="relative">
                <input type="password" name="confirmPassword" id="confirmPassword" placeholder="Confirm Password"
                  class="field-input pr-6 <%= (typeof errors !== 'undefined' && errors && errors.confirmPassword) ? 'is-error' : '' %>"
                />
                <button type="button" onclick="togglePass('confirmPassword','eyeConfirm')"
                  class="absolute right-0 top-1 text-gray-400 hover:text-leaf-700 text-xs">
                  <i id="eyeConfirm" class="fa-regular fa-eye"></i>
                </button>
              </div>
              <% if (typeof errors !== 'undefined' && errors && typeof errors === 'object' && errors.confirmPassword) { %>
                <p class="field-error">
                  <i class="fa-solid fa-circle-exclamation" style="font-size:10px"></i>
                  <%= errors.confirmPassword %>
                </p>
              <% } %>
            </div>

          </div>

          <!-- Submit -->
          <div class="pt-2">
            <button type="submit" id="submitBtn"
              class="w-full bg-leaf-700 hover:bg-leaf-800 text-white font-semibold text-sm py-3 rounded-md transition-colors tracking-wide flex items-center justify-center gap-2">
              <i class="fa-solid fa-user-plus text-xs"></i>
              Create Account
            </button>
            <% if (typeof error !== 'undefined' && error) { %>
  <div class="mb-4 text-sm text-red-600 bg-red-50 border border-red-200 px-3 py-2 rounded-md">
    <%= error %>
  </div>
<% } %>





          </div>

        </form>

        <p class="text-center text-xs text-gray-500 mt-5">
          Already have an account?
          <a href="/login" class="text-leaf-700 font-medium hover:underline">Login</a>
        </p>

      </div>

      <p class="mt-auto pt-10 text-[10px] text-gray-400 text-right w-full max-w-sm">
        Leafora Terms &amp; Conditions
      </p>

    </div>
  </div>

  <script>
    function togglePass(inputId, iconId) {
      const input = document.getElementById(inputId);
      const icon  = document.getElementById(iconId);
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('fa-eye', 'fa-eye-slash');
      } else {
        input.type = 'password';
        icon.classList.replace('fa-eye-slash', 'fa-eye');
      }
    }

    // Password strength meter
    const passInput = document.getElementById('password');
    // const bar       = document.getElementById('strengthBar');
    // const lbl       = document.getElementById('strengthLabel');
    // const levels    = [
    //   { label:'Very weak',   color:'#ef4444', width:'20%'  },
    //   { label:'Weak',        color:'#f97316', width:'40%'  },
    //   { label:'Fair',        color:'#eab308', width:'60%'  },
    //   { label:'Strong',      color:'#22c55e', width:'80%'  },
    //   { label:'Very strong', color:'#16a34a', width:'100%' },
    // ];
    // passInput.addEventListener('input', () => {
    //   const pw = passInput.value;
    //   if (!pw) { bar.style.width = '0'; lbl.textContent = ''; return; }
    //   let score = 0;
    //   if (pw.length >= 8)         score++;
    //   if (/[A-Z]/.test(pw))       score++;
    //   if (/[a-z]/.test(pw))       score++;
    //   if (/[0-9]/.test(pw))       score++;
    //   if (/[@$!%*?&#^]/.test(pw)) score++;
    //   const lvl = levels[Math.max(0, Math.min(4, score - 1))];
    //   bar.style.width      = lvl.width;
    //   bar.style.background = lvl.color;
    //   lbl.textContent      = lvl.label;
    //   lbl.style.color      = lvl.color;
    // });

    // Live confirm match
    const confirmInput = document.getElementById('confirmPassword');
    confirmInput.addEventListener('input', () => {
      confirmInput.classList.toggle('is-error', confirmInput.value !== passInput.value && confirmInput.value !== '');
    });

    // Client-side validation
    document.getElementById('signupForm').addEventListener('submit', function (e) {
      let valid = true;
      document.querySelectorAll('.client-err').forEach(el => el.remove());
      document.querySelectorAll('.field-input').forEach(el => el.classList.remove('is-error'));

      const showErr = (id, msg) => {
        const input = document.getElementById(id);
        if (!input) return;
        input.classList.add('is-error');
        const p = document.createElement('p');
        p.className = 'field-error client-err';
        p.innerHTML = `<i class="fa-solid fa-circle-exclamation" style="font-size:10px"></i> ${msg}`;
        input.closest('div').appendChild(p);
        valid = false;
      };

      const fn  = document.getElementById('firstName').value.trim();
      const ln  = document.getElementById('lastName').value.trim();
      const em  = document.getElementById('email').value.trim();
      const pw  = passInput.value;
      const cpw = confirmInput.value;

   if (!fn) {
  showErr('firstName', 'First name is required.');
}

if (!ln) {
  showErr('lastName', 'Last name is required.');
}

if (!em) {
  showErr('email', 'Email is required.');
} else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em)) {
  showErr('email', 'Enter a valid email.');
}

if (!pw) {
  showErr('password', 'Password is required.');
} else {
  
  if (pw.length < 8) {
    showErr('password', 'Password must be at least 8 characters.');
  }

  if (!/[A-Z]/.test(pw)) {
    showErr('password', 'Password must contain at least one uppercase letter.');
  }

  if (!/[0-9]/.test(pw)) {
    showErr('password', 'Password must contain at least one number.');
  }

  if (!/[!@#$%^&*(),.?":{}|<>]/.test(pw)) {
    showErr('password', 'Password must contain at least one special character.');
  }
}

if (!cpw) {
  showErr('confirmPassword', 'Please confirm password.');
} else if (cpw !== pw) {
  showErr('confirmPassword', 'Passwords do not match.');
}

      if (!valid) {
        e.preventDefault();
      } else {
        const btn = document.getElementById('submitBtn');
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-xs"></i> Creating account...';
        btn.disabled = true;
      }
    });

    // Auto-dismiss toast
    const toast = document.getElementById('flashToast');
    if (toast) setTimeout(() => toast.remove(), 5000);
  </script>

</body>
</html>

