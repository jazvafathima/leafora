<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Leafora Admin - Users</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { body: ['Poppins','sans-serif'] },
        },
      },
    };
  </script>
  <style>
    body { font-family: 'Poppins', sans-serif; background: #e8ede8; }

    /* ── Sidebar ── */
    .sidebar { width: 180px; background: #fff; min-height: 100vh; flex-shrink: 0; border-right: 1px solid #e5e7eb; }
    .sidebar-brand { padding: 20px 18px 16px; border-bottom: 1px solid #f0f0f0; }
    .sidebar-brand p { color: #1a5c1a; font-size: 1.2rem; font-weight: 700; letter-spacing: -0.01em; }
    .sidebar-link {
      display: flex; align-items: center; gap: 9px;
      padding: 9px 16px; font-size: 0.8rem;
      color: #4b5563; text-decoration: none;
      transition: all 0.15s;
    }
    .sidebar-link:hover  { color: #1a5c1a; background: #f0faf0; }
    .sidebar-link.active { background: #1a5c1a; color: #fff; font-weight: 600; margin: 2px 8px; border-radius: 8px; padding: 9px 10px; }
    .sidebar-link i { width: 15px; text-align: center; font-size: 0.82rem; }

    /* ── Top bar ── */
    .topbar { background: #1a5c1a; padding: 10px 20px; display: flex; align-items: center; justify-content: space-between; }
    .topbar-title { color: #fff; font-size: 0.88rem; font-weight: 500; display: flex; align-items: center; gap: 8px; }

    /* ── Table ── */
    .th { font-size: 0.72rem; color: #6b7280; font-weight: 600; padding: 12px 14px; text-align: left; border-bottom: 1px solid #f3f4f6; }
    .td { font-size: 0.78rem; color: #374151; padding: 13px 14px; border-bottom: 1px solid #f9fafb; }

    /* ── Badges ── */
    .badge-active  { background: #d1fae5; color: #065f46; font-size: 0.65rem; font-weight: 700; padding: 3px 10px; border-radius: 999px; }
    .badge-blocked { background: #fee2e2; color: #991b1b; font-size: 0.65rem; font-weight: 700; padding: 3px 10px; border-radius: 999px; }

    /* ── Filters ── */
    .filter-input  { border: 1px solid #e5e7eb; border-radius: 8px; padding: 7px 12px 7px 32px; font-size: 0.78rem; color: #374151; outline: none; background: #fff; transition: border-color 0.2s; font-family: 'Poppins',sans-serif; width: 100%; }
    .filter-input:focus { border-color: #1a5c1a; box-shadow: 0 0 0 2px rgba(26,92,26,0.08); }
    .filter-select { border: 1px solid #e5e7eb; border-radius: 8px; padding: 7px 28px 7px 12px; font-size: 0.78rem; color: #374151; outline: none; background: #fff; cursor: pointer; font-family: 'Poppins',sans-serif; appearance: none; transition: border-color 0.2s; }
    .filter-select:focus { border-color: #1a5c1a; }

    /* ── Pagination ── */
    .page-btn { width: 30px; height: 30px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 0.78rem; cursor: pointer; border: 1px solid #e5e7eb; background: #fff; color: #374151; transition: all 0.15s; text-decoration: none; }
    .page-btn:hover  { border-color: #1a5c1a; color: #1a5c1a; }
    .page-btn.active { background: #1a5c1a; color: #fff; border-color: #1a5c1a; font-weight: 600; }
    .page-nav { display: flex; align-items: center; gap: 5px; padding: 5px 10px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 0.75rem; color: #374151; cursor: pointer; background: #fff; text-decoration: none; transition: all 0.15s; }
    .page-nav:hover { border-color: #1a5c1a; color: #1a5c1a; }
    .page-nav.disabled { opacity: 0.4; pointer-events: none; }
  </style>
</head>
<body class="min-h-screen">

<div class="flex min-h-screen">

  <%# ═══ SIDEBAR ═══ %>
  <aside class="sidebar flex flex-col">

    <div class="sidebar-brand">
      <p>leafora</p>
    </div>

    <nav class="flex-1 py-3 space-y-0.5">
      <a href="/admin/dashboard"  class="sidebar-link"><i class="fa-solid fa-gauge-high"></i> Dashboard</a>
      <a href="/admin/orders"     class="sidebar-link"><i class="fa-solid fa-bag-shopping"></i> Orders</a>
      <a href="/admin/products"   class="sidebar-link"><i class="fa-solid fa-box"></i> Products</a>
      <a href="/admin/categories" class="sidebar-link"><i class="fa-solid fa-layer-group"></i> Categories</a>
      <a href="/admin/users"      class="sidebar-link active"><i class="fa-regular fa-user"></i> Users</a>
      <a href="/admin/offers"     class="sidebar-link"><i class="fa-regular fa-heart"></i> Offers</a>
      <a href="/admin/coupons"    class="sidebar-link"><i class="fa-solid fa-ticket"></i> Coupons</a>
      <a href="/admin/reports"    class="sidebar-link"><i class="fa-solid fa-chart-bar"></i> Reports</a>
    </nav>
  </aside>

  <%# ═══ RIGHT PANEL ═══ %>
  <div class="flex-1 flex flex-col">

    <%# Top bar %>
    <div class="topbar">
      <div class="topbar-title">
        <i class="fa-regular fa-user text-sm"></i>
        Users
      </div>
      <div class="flex items-center gap-3">
        <%# IMAGE SLOT: Admin avatar — admin.avatar from session — 34x34px circle %>
        <div class="w-9 h-9 rounded-full overflow-hidden border-2 border-white border-opacity-40 bg-green-800 flex items-center justify-center flex-shrink-0">
          <% if (typeof admin !== 'undefined' && admin && admin.avatar) { %>
            <img src="<%= admin.avatar %>" alt="Admin" class="w-full h-full object-cover" />
          <% } else { %>
            <i class="fa-regular fa-user text-white text-sm"></i>
          <% } %>
        </div>
        <span class="text-white font-semibold text-sm">3</span>
      </div>
    </div>

    <%# ── Main Content ── %>
    <main class="flex-1 p-6">

      <%# Page heading %>
      <div class="mb-5">
        <h1 class="text-lg font-semibold text-gray-800">Users Management</h1>
        <p class="text-xs text-gray-400 mt-0.5">View and manage platform users</p>
      </div>

      <%# Flash messages %>
      <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
        <div class="bg-green-50 border border-green-200 text-green-700 text-xs rounded-lg px-4 py-2.5 mb-4 flex items-center gap-2">
          <i class="fa-solid fa-circle-check"></i> <%= success[0] %>
        </div>
      <% } %>
      <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <div class="bg-red-50 border border-red-200 text-red-700 text-xs rounded-lg px-4 py-2.5 mb-4 flex items-center gap-2">
          <i class="fa-solid fa-circle-exclamation"></i> <%= error[0] %>
        </div>
      <% } %>

      <%# Filter Card %>
      <div class="bg-white rounded-xl border border-gray-200 p-5 mb-4 shadow-sm">
        <form method="GET" action="/admin/users" id="filterForm">
          <div class="flex flex-wrap items-end gap-4">

            <%# Search %>
            <div class="flex-1 min-w-48">
              <label class="block text-xs text-gray-500 font-medium mb-1.5">Search</label>
              <div class="relative">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" style="font-size:11px"></i>
                <input type="text" name="search" id="searchInput"
                  placeholder="Search by name, email"
                  value="<%= typeof search !== 'undefined' ? search : '' %>"
                  class="filter-input" />
              </div>
            </div>

            <%# Role filter %>
            <!-- <div>
              <label class="block text-xs text-gray-500 font-medium mb-1.5">Role</label>
              <div class="relative">
              
                <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none" style="font-size:9px"></i>
              </div>
            </div> -->

            <%# Status filter %>
            <div>
              <label class="block text-xs text-gray-500 font-medium mb-1.5">Status</label>
              <div class="relative">
             <select name="status"
  class="filter-select pr-8"
  onchange="document.getElementById('filterForm').submit()">

  <option value="">All Status</option>

  <option value="active" <%= status === 'active' ? 'selected' : '' %>>
    Active
  </option>

  <option value="blocked" <%= status === 'blocked' ? 'selected' : '' %>>
    Blocked
  </option>

</select>

  
                <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none" style="font-size:9px"></i>
              </div>
            </div>

            <%# Buttons %>
            <div class="flex gap-2">
              <button type="submit"
                class="bg-gray-800 hover:bg-gray-900 text-white text-xs font-semibold px-5 py-2 rounded-lg transition-colors">
                Search
              </button>
              <a href="/admin/users"
                class="border border-gray-300 hover:border-gray-400 text-gray-600 text-xs font-semibold px-4 py-2 rounded-lg transition-colors bg-white">
                Apply Filter
              </a>
            </div>

          </div>
        </form>
      </div>

      <%# Users Table Card %>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-white">
              <tr>
                <th class="th">User ID</th>
                <th class="th">Name</th>
                <th class="th">Email</th>
                <th class="th">Role</th>
                <th class="th">Orders</th>
                <th class="th">Status</th>
                <th class="th">Registered Date</th>
                <th class="th text-right">Actions</th>
              </tr>
            </thead>
        
     <tbody>

<% if (users && users.length > 0) { %>

  <% users.forEach(function(u, idx) { %>
    <tr>

      <td class="td">#USR-<%= String(idx + 1).padStart(3,'0') %></td>
      <td class="td"><%= u.firstName %> <%= u.lastName %></td>
      <td class="td"><%= u.email %></td>
      <td class="td"><%= u.role || 'user' %></td>
      <td class="td text-center"><%= u.orderCount || '-' %></td>

      <td class="td">
        <% if (!u.isBlocked) { %>
          <span class="badge-active">Active</span>
        <% } else { %>
          <span class="badge-blocked">Blocked</span>
        <% } %>
      </td>

      <td class="td">
        <%= u.createdAt ? new Date(u.createdAt).toISOString().split('T')[0] : '-' %>
      </td>

     <td class="td text-right">

  <% if (u.isBlocked) { %>

    <!-- UNBLOCK -->
    <form id="unblockForm-<%= u._id %>" action="/admin/users/<%= u._id %>/unblock" method="POST">
      <button type="button"
        onclick="openModal('Are you sure you want to UNBLOCK this user?', '<%= u._id %>')"
        class="text-green-600 font-medium">
        Unblock
      </button>
    </form>

  <% } else { %>

    <!-- BLOCK -->
    <form id="blockForm-<%= u._id %>" action="/admin/users/<%= u._id %>/block" method="POST">
      <button type="button"
        onclick="openModal('Are you sure you want to BLOCK this user?', '<%= u._id %>')"
        class="text-red-600 font-medium">
        Block
      </button>
    </form>

  <% } %>

</td>

    </tr>
  <% }); %>

<% } else { %>

  <tr>
    <td colspan="8" class="text-center text-gray-400 py-6">
      No users found
    </td>
  </tr>

<% } %>

</tbody>

        
        <!-- <div class="px-5 py-4 border-t border-gray-100 flex items-center justify-between">
          Showing info 
          <p class="text-xs text-gray-500">
            Showing
            <span class="font-semibold text-gray-700">
              1-<% if (typeof users !== 'undefined' && users) { %><%= users.length %><% } else { %>5<% } %>
            </span>
            of
            <span class="font-semibold text-gray-700">
              <% if (typeof totalUsers !== 'undefined' && totalUsers) { %>
  <%= totalUsers %>
<% } %>
            </span>
            users
          </p> -->
          
<%
  const current = currentPage || 1;
  const limit = 10;

  const start = users && users.length > 0 ? (current - 1) * limit + 1 : 0;
  const end = users && users.length > 0 ? start + users.length - 1 : 0;

  const total = totalUsers || 0;
%>

<div class="px-5 py-4 border-t border-gray-100 flex items-center justify-between">

  <!-- Showing info -->
  <p class="text-xs text-gray-500">
    Showing
    <span class="font-semibold text-gray-700">
      <%= start %>-<%= end %>
    </span>
    of
    <span class="font-semibold text-gray-700">
      <%= total %>
    </span>
    users
  </p>

  <!-- Pagination -->
  <div class="flex items-center gap-2">

    <!-- Previous -->
    <a href="<%= current > 1 ? '/admin/users?page=' + (current - 1) : '#' %>"
       class="page-nav <%= current > 1 ? '' : 'disabled' %>">
      <i class="fa-solid fa-chevron-left text-xs"></i> Previous
    </a>

    <% for (let p = 1; p <= (totalPages || 1); p++) { %>
      <a href="/admin/users?page=<%= p %>"
         class="page-btn <%= p === current ? 'active' : '' %>">
        <%= p %>
      </a>
    <% } %>

    <!-- Next -->
    <a href="<%= current < (totalPages || 1) ? '/admin/users?page=' + (current + 1) : '#' %>"
       class="page-nav <%= current < (totalPages|| 1) ? '' : 'disabled' %>">
      Next <i class="fa-solid fa-chevron-right text-xs"></i>
    </a>

  </div>

</div>

<!-- Confirm Modal -->
<div id="confirmModal" class="hidden fixed inset-0 bg-black/40 flex items-center justify-center z-50">

  <div class="bg-white rounded-xl shadow-lg w-[320px] p-5 text-center">

    <h2 class="text-sm font-semibold text-gray-800 mb-2">
      Confirm Action
    </h2>

    <p id="modalText" class="text-xs text-gray-500 mb-4">
      Are you sure?
    </p>

    <div class="flex justify-center gap-3">

      <button onclick="closeModal()"
        class="px-4 py-2 text-xs border rounded-lg text-gray-600 hover:bg-gray-100">
        Cancel
      </button>

      <button id="confirmBtn"
        class="px-4 py-2 text-xs bg-red-600 text-white rounded-lg hover:bg-red-700">
        Yes
      </button>

    </div>
  </div>
</div>
<script>
  let targetFormId = null;

  function openModal(message, userId) {
    targetFormId = userId;
    document.getElementById('modalText').innerText = message;
    document.getElementById('confirmModal').classList.remove('hidden');
  }

  function closeModal() {
    document.getElementById('confirmModal').classList.add('hidden');
    targetFormId = null;
  }

 document.getElementById('confirmBtn').addEventListener('click', function () {
  if (targetFormId) {
    const form =
      document.getElementById('blockForm-' + targetFormId) ||
      document.getElementById('unblockForm-' + targetFormId);

    if (form) form.submit();
  }
});
</script>
<script>
  const form = document.getElementById('filterForm');
  const searchInput = document.getElementById('searchInput');

  // Prevent auto submit on every key behavior issues
  searchInput.addEventListener('input', function () {
    clearTimeout(this.timer);

    this.timer = setTimeout(() => {
      form.submit();
    }, 500); // debounce search
  });
</script>

</body>
</html>
