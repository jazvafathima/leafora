<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Leafora Admin - Coupons</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <script>
    tailwind.config = {
      theme: { extend: { fontFamily: { body: ['Poppins','sans-serif'] } } }
    };
  </script>
  <style>
    body { font-family: 'Poppins', sans-serif; background: #e8ede8; }

    /* ── Sidebar ── */
    .sidebar { width: 180px; background: #fff; min-height: 100vh; flex-shrink: 0; border-right: 1px solid #e5e7eb; }
    .sidebar-brand { padding: 20px 18px 16px; border-bottom: 1px solid #f0f0f0; }
    .sidebar-brand p { color: #1a5c1a; font-size: 1.2rem; font-weight: 700; letter-spacing: -0.01em; }
    .sidebar-link { display: flex; align-items: center; gap: 9px; padding: 9px 16px; font-size: 0.8rem; color: #4b5563; text-decoration: none; transition: all 0.15s; }
    .sidebar-link:hover  { color: #1a5c1a; background: #f0faf0; }
    .sidebar-link.active { background: #1a5c1a; color: #fff; font-weight: 600; margin: 2px 8px; border-radius: 8px; padding: 9px 10px; }
    .sidebar-link i { width: 15px; text-align: center; font-size: 0.82rem; }

    /* ── Topbar ── */
    .topbar { background: #1a5c1a; padding: 10px 20px; display: flex; align-items: center; justify-content: space-between; }
    .topbar-title { color: #fff; font-size: 0.88rem; font-weight: 500; display: flex; align-items: center; gap: 8px; }

    /* ── Table ── */
    .th { font-size: 0.72rem; color: #6b7280; font-weight: 600; padding: 12px 14px; text-align: left; border-bottom: 1px solid #f3f4f6; }
    .td { font-size: 0.78rem; color: #374151; padding: 13px 14px; border-bottom: 1px solid #f9fafb; vertical-align: middle; }

    /* ── Badges ── */
    .badge-active   { background: #d1fae5; color: #065f46; font-size: 0.65rem; font-weight: 700; padding: 3px 10px; border-radius: 999px; }
    .badge-inactive { background: #f3f4f6; color: #6b7280; font-size: 0.65rem; font-weight: 700; padding: 3px 10px; border-radius: 999px; }
    .badge-expired  { background: #fee2e2; color: #991b1b; font-size: 0.65rem; font-weight: 700; padding: 3px 10px; border-radius: 999px; }

    /* ── Filters ── */
    .filter-input  { border: 1px solid #e5e7eb; border-radius: 8px; padding: 7px 12px 7px 32px; font-size: 0.78rem; color: #374151; outline: none; background: #fff; transition: border-color 0.2s; font-family: 'Poppins',sans-serif; width: 100%; }
    .filter-input:focus { border-color: #1a5c1a; box-shadow: 0 0 0 2px rgba(26,92,26,0.08); }
    .filter-select { border: 1px solid #e5e7eb; border-radius: 8px; padding: 7px 28px 7px 12px; font-size: 0.78rem; color: #374151; outline: none; background: #fff; cursor: pointer; font-family: 'Poppins',sans-serif; appearance: none; transition: border-color 0.2s; }
    .filter-select:focus { border-color: #1a5c1a; }

    /* ── Pagination ── */
    .page-btn { width: 30px; height: 30px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 0.78rem; cursor: pointer; border: 1px solid #e5e7eb; background: #fff; color: #374151; transition: all 0.15s; text-decoration: none; }
    .page-btn:hover  { border-color: #1a5c1a; color: #1a5c1a; }
    .page-btn.active { background: #1a5c1a; color: #fff; border-color: #1a5c1a; font-weight: 600; }
    .page-nav { display: flex; align-items: center; gap: 5px; padding: 5px 10px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 0.75rem; color: #374151; cursor: pointer; background: #fff; text-decoration: none; transition: all 0.15s; }
    .page-nav:hover { border-color: #1a5c1a; color: #1a5c1a; }
    .page-nav.disabled { opacity: 0.4; pointer-events: none; }

    /* ── Usage Progress Bar ── */
    .usage-bar-wrap { width: 80px; background: #f3f4f6; border-radius: 999px; height: 6px; overflow: hidden; }
    .usage-bar-fill { height: 100%; border-radius: 999px; background: #1a5c1a; transition: width 0.3s; }
    .usage-bar-full { background: #dc2626; }

    /* ── Toggle Switch ── */
    .toggle-switch { position: relative; width: 36px; height: 20px; display: inline-block; }
    .toggle-switch input { opacity: 0; width: 0; height: 0; }
    .toggle-slider { position: absolute; inset: 0; background: #d1d5db; border-radius: 999px; cursor: pointer; transition: 0.25s; }
    .toggle-slider::before { content: ''; position: absolute; height: 14px; width: 14px; left: 3px; top: 3px; background: white; border-radius: 50%; transition: 0.25s; }
    input:checked + .toggle-slider { background: #1a5c1a; }
    input:checked + .toggle-slider::before { transform: translateX(16px); }

    /* ── Modal ── */
    .modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.45); backdrop-filter: blur(2px); z-index: 50; display: flex; align-items: center; justify-content: center; }
    .modal-box { background: #fff; border-radius: 14px; padding: 24px; width: 100%; box-shadow: 0 20px 60px rgba(0,0,0,0.15); }
    .modal-label { display: block; font-size: 0.72rem; font-weight: 600; color: #374151; margin-bottom: 5px; }
    .modal-input { width: 100%; border: 1px solid #e5e7eb; border-radius: 8px; padding: 8px 12px; font-size: 0.78rem; font-family: 'Poppins', sans-serif; color: #374151; outline: none; transition: border-color 0.2s; }
    .modal-input:focus { border-color: #1a5c1a; box-shadow: 0 0 0 2px rgba(26,92,26,0.08); }
    .modal-select { width: 100%; border: 1px solid #e5e7eb; border-radius: 8px; padding: 8px 12px; font-size: 0.78rem; font-family: 'Poppins', sans-serif; color: #374151; outline: none; background: #fff; appearance: none; transition: border-color 0.2s; cursor: pointer; }
    .modal-select:focus { border-color: #1a5c1a; }
    .err { font-size: 0.68rem; color: #dc2626; margin-top: 3px; display: none; }
  </style>
</head>

<%
  const current  = currentPage || 1;
  const limit    = 10;
  const start    = coupons && coupons.length > 0 ? (current - 1) * limit + 1 : 0;
  const end      = coupons && coupons.length > 0 ? start + coupons.length - 1 : 0;
  const total    = totalCoupons || 0;
  const totalPgs = totalPages   || 1;
%>

<body class="min-h-screen">
<div class="flex min-h-screen">

  <%# ═══ SIDEBAR ═══ %>
  <aside class="sidebar flex flex-col">
    <div class="sidebar-brand"><p>leafora</p></div>
    <nav class="flex-1 py-3 space-y-0.5">
      <a href="/admin/dashboard"  class="sidebar-link"><i class="fa-solid fa-gauge-high"></i> Dashboard</a>
      <a href="/admin/orders"     class="sidebar-link"><i class="fa-solid fa-bag-shopping"></i> Orders</a>
      <a href="/admin/products"   class="sidebar-link"><i class="fa-solid fa-box"></i> Products</a>
      <a href="/admin/categories" class="sidebar-link"><i class="fa-solid fa-list"></i> Categories</a>
      <a href="/admin/users"      class="sidebar-link"><i class="fa-regular fa-user"></i> Users</a>
      <a href="/admin/offers"     class="sidebar-link"><i class="fa-regular fa-heart"></i> Offers</a>
      <a href="/admin/coupons"    class="sidebar-link active"><i class="fa-solid fa-ticket"></i> Coupons</a>
      <a href="/admin/reports"    class="sidebar-link"><i class="fa-solid fa-chart-bar"></i> Reports</a>
    </nav>
  </aside>

  <%# ═══ RIGHT PANEL ═══ %>
  <div class="flex-1 flex flex-col">

    <%# Topbar %>
    <div class="topbar">
      <div class="topbar-title">
        <i class="fa-solid fa-ticket text-sm"></i>
        Coupons
      </div>
      <div class="flex items-center gap-3">
        <%# IMAGE SLOT: Admin avatar — 34×34px circle %>
        <div class="w-9 h-9 rounded-full overflow-hidden border-2 border-white border-opacity-40 bg-green-800 flex items-center justify-center flex-shrink-0">
          <% if (typeof admin !== 'undefined' && admin && admin.avatar) { %>
            <img src="<%= admin.avatar %>" alt="Admin" class="w-full h-full object-cover" />
          <% } else { %>
            <i class="fa-regular fa-user text-white text-sm"></i>
          <% } %>
        </div>
      </div>
    </div>

    <%# ── Main Content ── %>
    <main class="flex-1 p-6">

      <%# Heading + Add button %>
      <div class="flex items-center justify-between mb-5">
        <div>
          <h1 class="text-lg font-semibold text-gray-800">Coupons Management</h1>
          <p class="text-xs text-gray-400 mt-0.5">Create, manage, and control discount coupons</p>
        </div>
        <button onclick="openAddModal()"
          class="flex items-center gap-2 bg-gray-800 hover:bg-gray-900 text-white text-xs font-semibold px-4 py-2.5 rounded-lg transition-colors">
          <i class="fa-solid fa-plus text-xs"></i>
          Add New Coupon
        </button>
      </div>

      <%# Flash messages %>
      <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
        <div class="bg-green-50 border border-green-200 text-green-700 text-xs rounded-lg px-4 py-2.5 mb-4 flex items-center gap-2">
          <i class="fa-solid fa-circle-check"></i> <%= success[0] %>
        </div>
      <% } %>
      <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <div class="bg-red-50 border border-red-200 text-red-700 text-xs rounded-lg px-4 py-2.5 mb-4 flex items-center gap-2">
          <i class="fa-solid fa-circle-exclamation"></i> <%= error[0] %>
        </div>
      <% } %>

      <%# Filter Card %>
      <div class="bg-white rounded-xl border border-gray-200 p-5 mb-4 shadow-sm">
        <form method="GET" action="/admin/coupons" id="filterForm">
          <div class="flex flex-wrap items-end gap-4">

            <%# Search %>
            <div class="flex-1 min-w-48">
              <label class="block text-xs text-gray-500 font-medium mb-1.5">Search</label>
              <div class="relative">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" style="font-size:11px"></i>
                <input type="text" name="search" id="searchInput"
                  placeholder="Search by coupon code..."
                  value="<%= typeof search !== 'undefined' ? search : '' %>"
                  class="filter-input" />
              </div>
            </div>

            <%# Coupon Type %>
            <div>
              <label class="block text-xs text-gray-500 font-medium mb-1.5">Coupon Type</label>
              <div class="relative">
                <select name="type" class="filter-select pr-8"
                  onchange="document.getElementById('filterForm').submit()">
                  <option value="">All</option>
                  <option value="flat"       <%= (typeof typeFilter !== 'undefined' && typeFilter === 'flat')       ? 'selected' : '' %>>Flat</option>
                  <option value="percentage" <%= (typeof typeFilter !== 'undefined' && typeFilter === 'percentage') ? 'selected' : '' %>>Percentage</option>
                </select>
                <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none" style="font-size:9px"></i>
              </div>
            </div>

            <%# Status %>
            <div>
              <label class="block text-xs text-gray-500 font-medium mb-1.5">Status</label>
              <div class="relative">
                <select name="status" class="filter-select pr-8"
                  onchange="document.getElementById('filterForm').submit()">
                  <option value="">All Status</option>
                  <option value="active"   <%= (typeof statusFilter !== 'undefined' && statusFilter === 'active')   ? 'selected' : '' %>>Active</option>
                  <option value="inactive" <%= (typeof statusFilter !== 'undefined' && statusFilter === 'inactive') ? 'selected' : '' %>>Inactive</option>
                  <option value="expired"  <%= (typeof statusFilter !== 'undefined' && statusFilter === 'expired')  ? 'selected' : '' %>>Expired</option>
                </select>
                <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none" style="font-size:9px"></i>
              </div>
            </div>

            <%# Buttons %>
            <div class="flex gap-2">
              <button type="submit"
                class="bg-gray-800 hover:bg-gray-900 text-white text-xs font-semibold px-5 py-2 rounded-lg transition-colors">
                Search
              </button>
              <a href="/admin/coupons"
                class="border border-gray-300 hover:border-gray-400 text-gray-600 text-xs font-semibold px-4 py-2 rounded-lg transition-colors bg-white">
                Clear
              </a>
            </div>

          </div>
        </form>
      </div>

      <%# Coupons Table Card %>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-white">
              <tr>
                <th class="th">Coupon Code</th>
                <th class="th">Discount Type</th>
                <th class="th">Value</th>
                <th class="th">Min Order</th>
                <th class="th">Max Discount</th>
                <th class="th">Usage Limit</th>
                <th class="th">Used</th>
                <th class="th">Expiry Date</th>
                <th class="th">Status</th>
                <th class="th text-right">Actions</th>
              </tr>
            </thead>
            <tbody>

              <% if (coupons && coupons.length > 0) { %>
                <% coupons.forEach(function(coupon) {
                    const now       = new Date();
                    const isExpired = new Date(coupon.expiryDate) < now;
                    const usedCount = coupon.usedBy ? coupon.usedBy.length : 0;
                    const usagePct  = coupon.usageLimit > 0
                                        ? Math.min(Math.round((usedCount / coupon.usageLimit) * 100), 100)
                                        : 0;
                    const limitHit  = coupon.usageLimit > 0 && usedCount >= coupon.usageLimit;
                  %>
                <tr class="hover:bg-gray-50 transition-colors duration-100">

                  <%# Coupon Code — bold monospace feel %>
                  <td class="td">
                    <span class="font-bold tracking-wider text-gray-800" style="font-size:0.8rem">
                      <%= coupon.code %>
                    </span>
                  </td>

                  <%# Discount Type %>
                  <td class="td text-gray-500 capitalize">
                    <%= coupon.discountType === 'flat' ? 'Flat' : 'Percentage' %>
                  </td>

                  <%# Value — green & bold like screenshot %>
                  <td class="td font-bold" style="color:#1a5c1a">
                    <% if (coupon.discountType === 'flat') { %>
                      ₹<%= coupon.discountValue %>
                    <% } else { %>
                      <%= coupon.discountValue %>%
                    <% } %>
                  </td>

                  <%# Min Order %>
                  <td class="td text-gray-600">
                    ₹<%= coupon.minPurchase ? coupon.minPurchase.toLocaleString('en-IN') : '0' %>
                  </td>

                  <%# Max Discount — only relevant for percent coupons %>
                  <td class="td text-gray-500">
                    <% if (coupon.discountType === 'percentage' && coupon.maxDiscount) { %>
                      ₹<%= coupon.maxDiscount.toLocaleString('en-IN') %>
                    <% } else { %>
                      <span class="text-gray-300">—</span>
                    <% } %>
                  </td>

                  <%# Usage Limit %>
                  <td class="td text-gray-600">
                    <%= coupon.usageLimit || '∞' %>
                  </td>

                  <%# Used — count + progress bar %>
                  <td class="td">
                    <div class="flex items-center gap-2">
                      <span class="text-gray-700 font-medium" style="min-width:18px">
                        <%= usedCount %>
                      </span>
                      <% if (coupon.usageLimit > 0) { %>
                        <div class="usage-bar-wrap">
                          <div class="usage-bar-fill <%= limitHit ? 'usage-bar-full' : '' %>"
                               style="width:<%= usagePct %>%"></div>
                        </div>
                      <% } %>
                    </div>
                  </td>

                  <%# Expiry Date %>
                  <td class="td text-gray-500">
                    <%= new Date(coupon.expiryDate).toISOString().split('T')[0] %>
                  </td>

                  <%# Status badge %>
                  <td class="td">
                    <% if (isExpired) { %>
                      <span class="badge-expired">Expired</span>
                    <% } else if (coupon.isActive) { %>
                      <span class="badge-active">Active</span>
                    <% } else { %>
                      <span class="badge-inactive">Inactive</span>
                    <% } %>
                  </td>

                  <%# Actions: Edit + Toggle + Delete %>
                  <td class="td text-right">
                    <div class="flex items-center justify-end gap-3">

                      <%# Edit %>
                      <button
                        onclick='openEditModal(<%= JSON.stringify({
                          _id:           coupon._id,
                          code:          coupon.code,
                          discountType:  coupon.discountType,
                          discountValue: coupon.discountValue,
                          minPurchase:   coupon.minPurchase   || 0,
                          maxDiscount:   coupon.maxDiscount   || "",
                          usageLimit:    coupon.usageLimit    || "",
                          perUserLimit:  coupon.perUserLimit  || 1,
                          expiryDate:    new Date(coupon.expiryDate).toISOString().split("T")[0],
                          isActive:      coupon.isActive
                        }) %>)'
                        class="text-gray-400 hover:text-gray-700 transition-colors"
                        title="Edit coupon">
                        <i class="fa-regular fa-pen-to-square text-sm"></i>
                      </button>

                      <%# Toggle active %>
                      <form action="/admin/coupons/<%= coupon._id %>/toggle" method="POST" class="inline">
                        <label class="toggle-switch">
                          <input type="checkbox" onchange="this.form.submit()"
                            <%= coupon.isActive ? 'checked' : '' %>>
                          <span class="toggle-slider"></span>
                        </label>
                      </form>

                      <%# Delete %>
                      <button
                        onclick="openDeleteModal('<%= coupon._id %>', '<%= coupon.code %>')"
                        class="text-gray-400 hover:text-red-500 transition-colors"
                        title="Delete coupon">
                        <i class="fa-regular fa-trash-can text-sm"></i>
                      </button>

                    </div>
                  </td>

                </tr>
              <% }) %>

              <% } else { %>
              <tr>
                <td colspan="10" class="text-center py-14">
                  <%# Empty state — replace icon with image if needed %>
                  <div class="flex flex-col items-center gap-3">
                    <div class="w-16 h-16 rounded-full bg-gray-100 flex items-center justify-center">
                      <i class="fa-solid fa-ticket text-2xl text-gray-300"></i>
                      <%#
                        To use your own illustration:
                        <img src="/images/empty-coupons.png" alt="No coupons" class="w-16 h-16 object-contain">
                      %>
                    </div>
                    <p class="text-sm font-medium text-gray-500">No coupons found</p>
                    <p class="text-xs text-gray-400">Click "Add New Coupon" to create one</p>
                  </div>
                </td>
              </tr>
              <% } %>

            </tbody>
          </table>
        </div>

        <%# Pagination %>
        <div class="px-5 py-4 border-t border-gray-100 flex items-center justify-between">
          <p class="text-xs text-gray-500">
            Showing
            <span class="font-semibold text-gray-700"><%= start %>–<%= end %></span>
            of
            <span class="font-semibold text-gray-700"><%= total %></span>
            coupons
          </p>
          <div class="flex items-center gap-2">
            <a href="<%= current > 1 ? '/admin/coupons?page=' + (current - 1) : '#' %>"
               class="page-nav <%= current > 1 ? '' : 'disabled' %>">
              <i class="fa-solid fa-chevron-left text-xs"></i> Previous
            </a>
            <% for (let p = 1; p <= totalPgs; p++) { %>
              <a href="/admin/coupons?page=<%= p %>"
                 class="page-btn <%= p === current ? 'active' : '' %>"><%= p %></a>
            <% } %>
            <a href="<%= current < totalPgs ? '/admin/coupons?page=' + (current + 1) : '#' %>"
               class="page-nav <%= current < totalPgs ? '' : 'disabled' %>">
              Next <i class="fa-solid fa-chevron-right text-xs"></i>
            </a>
          </div>
        </div>

      </div><%# /table card %>
    </main>
  </div>
</div>


<!-- ══════════════════════════════════════════
     ADD COUPON MODAL
══════════════════════════════════════════ -->
<div id="addModal" class="modal-backdrop hidden">
  <div class="modal-box max-w-lg">

    <div class="flex items-center justify-between mb-5">
      <div>
        <h2 class="text-base font-semibold text-gray-800">Add New Coupon</h2>
        <p class="text-xs text-gray-400 mt-0.5">Fill in coupon details below</p>
      </div>
      <button onclick="closeAddModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <form action="/admin/coupons/add" method="POST" id="addCouponForm" novalidate>
      <div class="space-y-4">

        <%# Coupon Code + generate button %>
        <div>
          <label class="modal-label">Coupon Code <span class="text-red-500">*</span></label>
          <div class="flex gap-2">
            <input type="text" name="code" id="add_code"
              placeholder="e.g. SAVE20"
              class="modal-input uppercase" style="text-transform:uppercase"
              oninput="this.value=this.value.toUpperCase()" />
            <button type="button" onclick="generateCode()"
              class="shrink-0 border border-gray-300 text-gray-600 text-xs font-medium px-3 rounded-lg hover:bg-gray-50 transition-colors whitespace-nowrap">
              <i class="fa-solid fa-wand-magic-sparkles mr-1"></i> Generate
            </button>
          </div>
          <p class="err" id="err_add_code">Coupon code is required</p>
        </div>

        <%# Discount Type + Value %>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="modal-label">Discount Type <span class="text-red-500">*</span></label>
            <div class="relative">
              <select name="discountType" id="add_discountType" class="modal-select pr-8"
                onchange="onAddTypeChange(this.value)">
                <option value="flat">Flat (₹)</option>
                <option value="percentage">Percentage (%)</option>
              </select>
              <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none" style="font-size:9px"></i>
            </div>
          </div>
          <div>
            <label class="modal-label">Discount Value <span class="text-red-500">*</span></label>
            <input type="number" name="discountValue" id="add_discountValue"
              placeholder="e.g. 100" min="1"
              class="modal-input" />
            <p class="err" id="err_add_value">Enter a valid value</p>
          </div>
        </div>

        <%# Min Purchase + Max Discount (shown for percentage) %>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="modal-label">Min Purchase (₹) <span class="text-red-500">*</span></label>
            <input type="number" name="minPurchase" id="add_minPurchase"
              placeholder="e.g. 500" min="0"
              class="modal-input" />
            <p class="err" id="err_add_min">Enter minimum purchase amount</p>
          </div>
          <div id="add_maxDiscountRow">
            <label class="modal-label">Max Discount (₹)</label>
            <input type="number" name="maxDiscount" id="add_maxDiscount"
              placeholder="e.g. 300" min="0"
              class="modal-input" />
            <p class="text-gray-400 mt-1" style="font-size:0.65rem">Cap for percentage coupons</p>
          </div>
        </div>

        <%# Usage Limit + Per User Limit %>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="modal-label">Usage Limit <span class="text-red-500">*</span></label>
            <input type="number" name="usageLimit" id="add_usageLimit"
              placeholder="e.g. 100" min="1"
              class="modal-input" />
            <p class="err" id="err_add_usage">Enter a usage limit</p>
          </div>
          <div>
            <label class="modal-label">Per User Limit</label>
            <input type="number" name="perUserLimit" id="add_perUserLimit"
              placeholder="e.g. 1" min="1" value="1"
              class="modal-input" />
            <p class="text-gray-400 mt-1" style="font-size:0.65rem">Times one user can use this</p>
          </div>
        </div>

        <%# Expiry Date %>
        <div>
          <label class="modal-label">Expiry Date <span class="text-red-500">*</span></label>
          <input type="date" name="expiryDate" id="add_expiryDate" class="modal-input" />
          <p class="err" id="err_add_expiry">Select a valid expiry date</p>
        </div>

      </div>

      <div class="flex gap-3 mt-6">
        <button type="button" onclick="closeAddModal()"
          class="flex-1 border border-gray-300 text-gray-600 text-xs font-semibold py-2.5 rounded-lg hover:bg-gray-50 transition-colors">
          Cancel
        </button>
        <button type="button" onclick="submitAddCoupon()"
          class="flex-1 bg-gray-800 hover:bg-gray-900 text-white text-xs font-semibold py-2.5 rounded-lg transition-colors">
          Add Coupon
        </button>
      </div>
    </form>

  </div>
</div>


<!-- ══════════════════════════════════════════
     EDIT COUPON MODAL
══════════════════════════════════════════ -->
<div id="editModal" class="modal-backdrop hidden">
  <div class="modal-box max-w-lg">

    <div class="flex items-center justify-between mb-5">
      <div>
        <h2 class="text-base font-semibold text-gray-800">Edit Coupon</h2>
        <p class="text-xs text-gray-400 mt-0.5">Update coupon details</p>
      </div>
      <button onclick="closeEditModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <form id="editCouponForm" method="POST" novalidate>
      <div class="space-y-4">

        <%# Code — read-only after creation %>
        <div>
          <label class="modal-label">Coupon Code</label>
          <input type="text" id="edit_codeDisplay"
            class="modal-input bg-gray-50 text-gray-400" readonly />
          <input type="hidden" name="code" id="edit_code" />
          <p class="text-gray-400 mt-1" style="font-size:0.65rem">Coupon code cannot be changed after creation</p>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="modal-label">Discount Type <span class="text-red-500">*</span></label>
            <div class="relative">
              <select name="discountType" id="edit_discountType" class="modal-select pr-8">
                <option value="flat">Flat (₹)</option>
                <option value="percentage">Percentage (%)</option>
              </select>
              <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none" style="font-size:9px"></i>
            </div>
          </div>
          <div>
            <label class="modal-label">Discount Value <span class="text-red-500">*</span></label>
            <input type="number" name="discountValue" id="edit_discountValue" min="1" class="modal-input" />
            <p class="err" id="err_edit_value">Enter a valid value</p>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="modal-label">Min Purchase (₹) <span class="text-red-500">*</span></label>
            <input type="number" name="minPurchase" id="edit_minPurchase" min="0" class="modal-input" />
            <p class="err" id="err_edit_min">Required</p>
          </div>
          <div>
            <label class="modal-label">Max Discount (₹)</label>
            <input type="number" name="maxDiscount" id="edit_maxDiscount" min="0" class="modal-input" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="modal-label">Usage Limit <span class="text-red-500">*</span></label>
            <input type="number" name="usageLimit" id="edit_usageLimit" min="1" class="modal-input" />
            <p class="err" id="err_edit_usage">Required</p>
          </div>
          <div>
            <label class="modal-label">Per User Limit</label>
            <input type="number" name="perUserLimit" id="edit_perUserLimit" min="1" class="modal-input" />
          </div>
        </div>

        <div>
          <label class="modal-label">Expiry Date <span class="text-red-500">*</span></label>
          <input type="date" name="expiryDate" id="edit_expiryDate" class="modal-input" />
          <p class="err" id="err_edit_expiry">Select a valid expiry date</p>
        </div>

      </div>

      <div class="flex gap-3 mt-6">
        <button type="button" onclick="closeEditModal()"
          class="flex-1 border border-gray-300 text-gray-600 text-xs font-semibold py-2.5 rounded-lg hover:bg-gray-50 transition-colors">
          Cancel
        </button>
        <button type="button" onclick="submitEditCoupon()"
          class="flex-1 bg-gray-800 hover:bg-gray-900 text-white text-xs font-semibold py-2.5 rounded-lg transition-colors">
          Save Changes
        </button>
      </div>
    </form>

  </div>
</div>


<!-- ══════════════════════════════════════════
     DELETE CONFIRM MODAL
══════════════════════════════════════════ -->
<div id="deleteModal" class="modal-backdrop hidden">
  <div class="modal-box max-w-xs text-center">
    <div class="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center mx-auto mb-4">
      <i class="fa-solid fa-triangle-exclamation text-red-500 text-lg"></i>
    </div>
    <h2 class="text-sm font-semibold text-gray-800 mb-1">Delete Coupon</h2>
    <p class="text-xs text-gray-400 mb-1">You are about to delete</p>
    <p class="text-xs font-bold text-gray-800 tracking-wider mb-4" id="deleteCouponCode">—</p>
    <p class="text-xs text-gray-400 mb-5">This action cannot be undone.</p>
    <form id="deleteForm" method="POST">
      <div class="flex gap-3">
        <button type="button" onclick="closeDeleteModal()"
          class="flex-1 border border-gray-300 text-gray-600 text-xs font-semibold py-2.5 rounded-lg hover:bg-gray-50">
          Cancel
        </button>
        <button type="submit"
          class="flex-1 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold py-2.5 rounded-lg transition-colors">
          Yes, Delete
        </button>
      </div>
    </form>
  </div>
</div>


<!-- ══════════════════════════════════════════
     SCRIPTS
══════════════════════════════════════════ -->
<script>

  /* ── Helpers ── */
  function showErr(id, show) {
    const el = document.getElementById(id);
    if (el) el.style.display = show ? 'block' : 'none';
  }
  function val(id) { return (document.getElementById(id)?.value || '').trim(); }
  function num(id) { return parseFloat(document.getElementById(id)?.value); }

  /* ── Generate random coupon code ── */
  function generateCode() {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
    let code = '';
    for (let i = 0; i < 8; i++) {
      code += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    document.getElementById('add_code').value = code;
  }

  /* ── Show/hide max discount based on type ── */
  function onAddTypeChange(type) {
    const row = document.getElementById('add_maxDiscountRow');
    // Always show it, but label indicates it's mainly for percentage
    if (row) row.style.opacity = type === 'percentage' ? '1' : '0.5';
  }

  /* ══════ ADD MODAL ══════ */
  function openAddModal() {
    document.getElementById('addCouponForm').reset();
    ['err_add_code','err_add_value','err_add_min','err_add_usage','err_add_expiry']
      .forEach(id => showErr(id, false));
    // Set today as min expiry date
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('add_expiryDate').setAttribute('min', today);
    document.getElementById('addModal').classList.remove('hidden');
  }
  function closeAddModal() {
    document.getElementById('addModal').classList.add('hidden');
  }

  function submitAddCoupon() {
    let valid = true;

    if (!val('add_code'))                       { showErr('err_add_code',   true); valid = false; }
    else                                          showErr('err_add_code',   false);

    const dv = num('add_discountValue');
    if (!dv || dv <= 0)                         { showErr('err_add_value',  true); valid = false; }
    else                                          showErr('err_add_value',  false);

    const mp = document.getElementById('add_minPurchase').value;
    if (mp === '' || isNaN(Number(mp)))          { showErr('err_add_min',   true); valid = false; }
    else                                          showErr('err_add_min',   false);

    const ul = num('add_usageLimit');
    if (!ul || ul < 1)                          { showErr('err_add_usage',  true); valid = false; }
    else                                          showErr('err_add_usage',  false);

    const exp = val('add_expiryDate');
    if (!exp || new Date(exp) <= new Date())    { showErr('err_add_expiry', true); valid = false; }
    else                                          showErr('err_add_expiry', false);

    if (!valid) return;
    document.getElementById('addCouponForm').submit();
  }

  /* ══════ EDIT MODAL ══════ */
  function openEditModal(coupon) {
    document.getElementById('edit_codeDisplay').value  = coupon.code;
    document.getElementById('edit_code').value         = coupon.code;
    document.getElementById('edit_discountType').value = coupon.discountType;
    document.getElementById('edit_discountValue').value= coupon.discountValue;
    document.getElementById('edit_minPurchase').value  = coupon.minPurchase;
    document.getElementById('edit_maxDiscount').value  = coupon.maxDiscount || '';
    document.getElementById('edit_usageLimit').value   = coupon.usageLimit  || '';
    document.getElementById('edit_perUserLimit').value = coupon.perUserLimit || 1;
    document.getElementById('edit_expiryDate').value   = coupon.expiryDate;
    document.getElementById('editCouponForm').action   = `/admin/coupons/${coupon._id}/edit`;

    ['err_edit_value','err_edit_min','err_edit_usage','err_edit_expiry']
      .forEach(id => showErr(id, false));
    document.getElementById('editModal').classList.remove('hidden');
  }
  function closeEditModal() {
    document.getElementById('editModal').classList.add('hidden');
  }

  function submitEditCoupon() {
    let valid = true;

    const dv = num('edit_discountValue');
    if (!dv || dv <= 0)                       { showErr('err_edit_value',  true); valid = false; }
    else                                        showErr('err_edit_value',  false);

    const mp = document.getElementById('edit_minPurchase').value;
    if (mp === '' || isNaN(Number(mp)))        { showErr('err_edit_min',   true); valid = false; }
    else                                        showErr('err_edit_min',   false);

    const ul = num('edit_usageLimit');
    if (!ul || ul < 1)                        { showErr('err_edit_usage',  true); valid = false; }
    else                                        showErr('err_edit_usage',  false);

    const exp = val('edit_expiryDate');
    if (!exp)                                  { showErr('err_edit_expiry', true); valid = false; }
    else                                        showErr('err_edit_expiry', false);

    if (!valid) return;
    document.getElementById('editCouponForm').submit();
  }

  /* ══════ DELETE MODAL ══════ */
  function openDeleteModal(id, code) {
    document.getElementById('deleteCouponCode').textContent = code;
    document.getElementById('deleteForm').action = `/admin/coupons/${id}/delete`;
    document.getElementById('deleteModal').classList.remove('hidden');
  }
  function closeDeleteModal() {
    document.getElementById('deleteModal').classList.add('hidden');
  }

  /* Close on backdrop click */
  ['addModal','editModal','deleteModal'].forEach(function(id) {
    document.getElementById(id).addEventListener('click', function(e) {
      if (e.target === this) this.classList.add('hidden');
    });
  });

  /* Escape key closes any open modal */
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      ['addModal','editModal','deleteModal'].forEach(function(id) {
        document.getElementById(id).classList.add('hidden');
      });
    }
  });

  /* Search debounce */
  const filterForm   = document.getElementById('filterForm');
  const searchInput  = document.getElementById('searchInput');
  searchInput.addEventListener('input', function() {
    clearTimeout(this._t);
    this._t = setTimeout(() => filterForm.submit(), 500);
  });

</script>

</body>
</html>
